  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "30 \u0438\u044E\u043B\u044F \u0432 \u0433\u0435\u0440\u043C\u0430\u043D\u0441\u043A\u043E\u043C
    \u043A\u043E\u043D\u0446\u043B\u0430\u0433\u0435\u0440\u0435 \"\u0423\u043B\u044C\u043C\u0435\u043D\u0448\u0442\u043E\u043A\"
    16 \u0440\u0443\u0441\u0441\u043A\u0438\u0445 \u0441\u043E\u043B\u0434\u0430\u0442
    \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043B\u0438 \u0434\u0435\u0440\u0437\u043A\u0438\u0439
    \u043F\u043E\u0431\u0435\u0433, \u0432\u044B\u0431\u0440\u0430\u0432\u0448\u0438\u0441\u044C
    \u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u0443.\r\n\r\n\u041F\u043E\u0434
    \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C
    \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043E \u043F\u043E \u0437\u0432\u0430\u043D\u0438\u044E
    \u043C\u0430\u0439\u043E\u0440\u0430 \u0420\u044F\u0431\u0447\u0438\u043A\u043E\u0432\u0430,
    \u043E\u043D\u0438 \u0441\u043C\u043E\u0433\u043B\u0438 \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
    \u0434\u043E \u0433\u0443\u0441\u0442\u043E\u0433\u043E \u043B\u0435\u0441\u0430,
    \u043D\u043E \u0444\u0430\u0448\u0438\u0441\u0442\u044B \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C
    \u0432 \u043F\u043E\u0433\u043E\u043D\u044E \u0437\u0430 \u0431\u0435\u0433\u043B\u0435\u0446\u0430\u043C\u0438.\r\n\r\r\n\u0422\u0435\u043F\u0435\u0440\u044C
    \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u0435 \u0438 \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435
    \u0433\u0440\u0443\u043F\u043F\u044B \u043B\u0435\u0436\u0438\u0442 \u043D\u0430
    \u0432\u0430\u0448\u0438\u0445 \u043F\u043B\u0435\u0447\u0430\u0445. \u0412\u0435\u0440\u043D\u0438\u0442\u0435
    \u0441\u043E\u043B\u0434\u0430\u0442 \u043D\u0430 \u0444\u0440\u043E\u043D\u0442
    \u0422\u041E\u0412\u0410\u0420\u0418\u0429 \u0420\u042F\u0411\u0427\u0418\u041A\u041E\u0412!!!\r\n"
