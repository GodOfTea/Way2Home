  m_text: "\u0413\u0440\u0443\u043F\u043F\u0430 \u043D\u0430\u0442\u043A\u043D\u0443\u043B\u0430\u0441\u044C
    \u043D\u0430 \u043F\u043E\u043B\u0435 \u0441 \u043E\u0432\u0440\u0430\u0433\u043E\u043C,
    \u0443\u0441\u0435\u044F\u043D\u043D\u043E\u0435 \u0442\u0435\u043B\u0430\u043C\u0438,
    \u0441\u0440\u0435\u0434\u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043B\u0435\u0436\u0430\u0442
    \u0438 \u0438\u0445 \u043F\u0440\u0435\u0436\u043D\u0438\u0435 \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0438.
    \u041E\u0434\u0438\u043D \u0438\u0437 \u0431\u043E\u0439\u0446\u043E\u0432 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
