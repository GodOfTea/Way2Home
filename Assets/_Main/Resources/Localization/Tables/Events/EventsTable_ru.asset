    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902859
    m_Localized: "\u0412 \u0442\u0440\u044F\u0441\u0438\u043D\u0435 \u0433\u043B\u0430\u0432\u043D\u043E\u0435
      \u044D\u0442\u043E \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
      \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0430. \u0421\u043E\u043B\u0434\u0430\u0442\u044B
      \u0441\u0432\u044F\u0437\u0430\u043B\u0438\u0441\u044C \u0440\u0435\u043C\u043D\u044F\u043C\u0438
      \u0438 \u0432\u0435\u0440\u0435\u0432\u043A\u0430\u043C\u0438, \u0432\u044B\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u043B\u0438
      \u0443\u0432\u044F\u0437\u0448\u0438\u0445. \u0412\u0441\u0435 \u0432\u044B\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u0436\u0438\u0432\u044B\u043C\u0438, \u0445\u043E\u0442\u044C \u0438 \u0432\u044B\u043C\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0432 \u0433\u0440\u044F\u0437\u0438 \u0438 \u0432\u044B\u0431\u0438\u043B\u0438\u0441\u044C
      \u0438\u0437 \u0441\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902860
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u043B\u0434\u0430\u0442
      \u0443\u0432\u044F\u0437\u043B\u0438 \u0432 \u0431\u043E\u043B\u043E\u0442\u0435,
      \u043F\u043E\u0442\u0435\u0440\u044F\u0432 \u043F\u0440\u0438\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902861
    m_Localized: "\u0421\u0431\u0440\u043E\u0441\u0438\u0432 \u043F\u0440\u0438\u043F\u0430\u0441\u044B,
      \u0432\u0430\u0448\u0430 \u0433\u0440\u0443\u043F\u043F\u0430 \u043F\u0440\u043E\u0448\u043B\u0430
      \u0431\u043E\u043B\u043E\u0442\u043E \u0436\u0438\u0432\u043E\u0439. \u0411\u044B\u043B\u043E
      \u0442\u044F\u0436\u0435\u043B\u043E, \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043F\u043E\u0447\u0442\u0438 \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u043E,
      \u043D\u043E, \u0442\u0430\u043A-\u043A\u0430\u043A \u0432\u0441\u0435 \u0431\u044B\u043B\u0438
      \u043D\u0430\u043B\u0435\u0433\u043A\u0435, \u0432\u0441\u0435 \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902862
    m_Localized: "\u0421\u0431\u0440\u043E\u0441\u0438\u0432 \u043F\u0440\u0438\u043F\u0430\u0441\u044B,
      \u0432\u0430\u0448\u0430 \u0433\u0440\u0443\u043F\u043F\u0430 \u043F\u0440\u043E\u0448\u043B\u0430
      \u0431\u043E\u043B\u043E\u0442\u043E \u0436\u0438\u0432\u043E\u0439. \u0411\u044B\u043B\u043E
      \u0442\u044F\u0436\u0435\u043B\u043E, \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043F\u043E\u0447\u0442\u0438 \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u043E,
      \u043D\u043E, \u0442\u0430\u043A-\u043A\u0430\u043A \u0432\u0441\u0435 \u0431\u044B\u043B\u0438
      \u043D\u0430\u043B\u0435\u0433\u043A\u0435, \u0432\u0441\u0435 \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902863
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u0431\u0435\u0437
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C \u043F\u0440\u043E\u043D\u0438\u043A
      \u0432 \u043B\u0430\u0433\u0435\u0440\u044C \u0438 \u0437\u0430\u0431\u0440\u0430\u043B
      \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432.
      \u0423\u0442\u0440\u043E\u043C \u0444\u0430\u0448\u0438\u0441\u0442\u044B \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438
      \u043F\u0440\u043E\u043F\u0430\u0436\u0443 \u2014 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043E\u043D\u0438 \u0438\u0449\u0443\u0442 \u0432\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902864
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u0431\u043E\u0439\u0446\u043E\u0432
      \u043D\u0430\u0447\u0430\u043B \u0440\u0435\u0437\u0430\u0442\u044C \u0441\u043F\u044F\u0449\u0438\u0445
      \u0441\u043E\u043B\u0434\u0430\u0442. \u041F\u043E\u0434\u043D\u044F\u043B\u0430\u0441\u044C
      \u0442\u0440\u0435\u0432\u043E\u0433\u0430, \u0432\u0435\u0441\u044C \u043B\u0430\u0433\u0435\u0440\u044C
      \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F. \u0412 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043B\u043A\u0435
      \u043C\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445,
      \u0430 \u043A\u043E\u0433\u043E-\u0442\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0432 \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902865
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u043B\u0430\u0433\u0435\u0440\u044C
      \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0441\u043B\u043E\u0436\u043D\u043E:
      \u043F\u043E\u0432\u0441\u044E\u0434\u0443 \u043F\u0430\u0442\u0440\u0443\u043B\u0438.
      \u0412\u044B \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0447\u0435\u043C \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902866
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u043B\u0430\u0433\u0435\u0440\u044C
      \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0441\u043B\u043E\u0436\u043D\u043E:
      \u043F\u043E\u0432\u0441\u044E\u0434\u0443 \u043F\u0430\u0442\u0440\u0443\u043B\u0438.
      \u0412\u044B \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0447\u0435\u043C \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902867
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u0442\u0435\u043C\u043D\u043E\u0442\u0443
      \u0438 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E\u0441\u0442\u044C,
      \u0432\u044B \u0441 \u043E\u0442\u0440\u044F\u0434\u043E\u043C \u0441\u043A\u0440\u044B\u0442\u043D\u043E
      \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u043A \u043B\u0430\u0433\u0435\u0440\u044E
      \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432. \u0421\u043D\u044F\u043B\u0438
      \u0447\u0430\u0441\u043E\u0432\u044B\u0445, \u0437\u0430\u0442\u0435\u043C
      \u0432\u043E\u0440\u0432\u0430\u043B\u0438\u0441\u044C \u0432 \u043F\u0430\u043B\u0430\u0442\u043A\u0438,
      \u0443\u0431\u0438\u0432\u0430\u044F \u0441\u043F\u044F\u0449\u0438\u0445 \u0441\u043E\u043B\u0434\u0430\u0442.
      \u041B\u0430\u0433\u0435\u0440\u044C \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D,
      \u043F\u043E\u0442\u0435\u0440\u044C \u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902868
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u0432\u044B \u043F\u043E\u0434\u043A\u0440\u0430\u043B\u0438\u0441\u044C
      \u043A \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443 \u0438
      \u043D\u0430\u0447\u0430\u043B\u0438 \u0440\u0435\u0437\u043D\u044E. \u0412\u044B
      \u0431\u044B\u043B\u0438 \u0432 \u043C\u0435\u043D\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0435,
      \u043D\u043E \u044D\u0444\u0444\u0435\u043A\u0442 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u0438
      \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C
      \u043B\u0430\u0433\u0435\u0440\u044C. \u041E\u0434\u043D\u0430\u043A\u043E
      \u043E\u0442\u0440\u044F\u0434 \u043B\u0438\u0448\u0438\u043B\u0441\u044F \u043C\u043D\u043E\u0433\u0438\u0445
      \u0431\u043E\u0439\u0446\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902869
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u0432\u044B\u0436\u0438\u043B,
      \u0443\u043A\u0440\u044B\u0432\u0448\u0438\u0441\u044C \u0432 \u0440\u0430\u0437\u043D\u044B\u0445
      \u043C\u0435\u0441\u0442\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902870
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u0432\u044B\u0436\u0438\u043B,
      \u0443\u043A\u0440\u044B\u0432\u0448\u0438\u0441\u044C \u0432 \u0440\u0430\u0437\u043D\u044B\u0445
      \u043C\u0435\u0441\u0442\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902871
    m_Localized: "\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0432\u0448\u0438\u0441\u044C,
      \u0432\u044B \u043F\u043E\u0432\u044B\u0441\u0438\u043B\u0438 \u0448\u0430\u043D\u0441\u044B
      \u043D\u0430 \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435, \u043D\u043E
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043D\u0430\u0440\u044F\u0434\u043E\u0432
      \u0437\u0430\u0434\u0435\u043B\u0438 \u0434\u0432\u043E\u0438\u0445 \u0432\u0430\u0448\u0438\u0445
      \u0431\u043E\u0439\u0446\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902872
    m_Localized: "\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0432\u0448\u0438\u0441\u044C,
      \u0432\u044B \u043F\u043E\u0432\u044B\u0441\u0438\u043B\u0438 \u0448\u0430\u043D\u0441\u044B
      \u043D\u0430 \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435, \u043D\u043E
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043D\u0430\u0440\u044F\u0434\u043E\u0432
      \u0437\u0430\u0434\u0435\u043B\u0438 \u0434\u0432\u043E\u0438\u0445 \u0432\u0430\u0448\u0438\u0445
      \u0431\u043E\u0439\u0446\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479421902873
    m_Localized: "\u042D\u0442\u043E \u0447\u0443\u0434\u043E! \u041E\u0434\u043D\u0430
      \u0438\u0437 \u043F\u0443\u043B\u044C \u043F\u0440\u043E\u0431\u0438\u043B\u0430
      \u0441\u0442\u0435\u043A\u043B\u043E \u043A\u0430\u0431\u0438\u043D\u044B \u0438
      \u0441\u0440\u0430\u0437\u0438\u043B\u0430 \u043F\u0438\u043B\u043E\u0442\u0430.
      \u0421\u0430\u043C\u043E\u043B\u0435\u0442 \u0440\u0443\u0445\u043D\u0443\u043B.
      \u0412\u0442\u043E\u0440\u043E\u0439 \u043F\u043E\u0441\u043F\u0435\u0448\u0438\u043B
      \u0443\u0431\u0440\u0430\u0442\u044C\u0441\u044F, \u0440\u0435\u0448\u0438\u0432,
      \u0447\u0442\u043E \u0432 \u043B\u0435\u0441\u0443 \u0437\u0430\u0441\u0430\u0434\u0430
      \u041F\u0412\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097152
    m_Localized: "\u0412\u044B \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u043E\u0433\u043E\u043D\u044C
      \u0438\u0437 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A \u043F\u043E
      \u0441\u0430\u043C\u043E\u043B\u0435\u0442\u0430\u043C. \u0424\u0430\u0448\u0438\u0441\u0442\u044B
      \u0443\u0437\u043D\u0430\u043B\u0438, \u0433\u0434\u0435 \u0432\u044B. \u041E\u043D\u0438
      \u043E\u0442\u0432\u0435\u0442\u0438\u043B\u0438 \u043F\u0443\u043B\u0435\u043C\u0435\u0442\u043D\u044B\u043C
      \u043E\u0433\u043D\u0435\u043C \u2014 \u0447\u0435\u0442\u0432\u0435\u0440\u043E
      \u0432\u0430\u0448\u0438\u0445 \u0431\u043E\u0439\u0446\u043E\u0432 \u043F\u043E\u0433\u0438\u0431\u043B\u0438.
      \u0421\u0430\u043C\u043E\u043B\u0435\u0442\u044B \u0441\u043E\u043E\u0431\u0449\u0430\u0442
      \u043E \u0432\u0430\u0448\u0435\u043C \u043C\u0435\u0441\u0442\u043E\u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097153
    m_Localized: "\u0421\u043E\u0431\u0430\u043A\u0438 \u0443\u0431\u0438\u0442\u044B,
      \u043D\u043E \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u0438 \u0442\u0440\u0443\u043F\u044B
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0443\u0442
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0445
      \u043F\u0430\u0442\u0440\u0443\u043B\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097154
    m_Localized: "\u0421\u043E\u0431\u0430\u043A\u0438 \u0443\u0431\u0438\u0442\u044B,
      \u043D\u043E \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u0438 \u0442\u0440\u0443\u043F\u044B
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0443\u0442
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0445
      \u043F\u0430\u0442\u0440\u0443\u043B\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097155
    m_Localized: "\u041E\u0442\u0440\u044F\u0434, \u0441\u043B\u0443\u0448\u0430\u044F
      \u0432\u0430\u0448\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u044B, \u043D\u0430\u0447\u0430\u043B
      \u043E\u0442\u0445\u043E\u0434\u0438\u0442\u044C, \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u044F
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430. \u041E\u0434\u0438\u043D
      \u0438\u0437 \u0431\u043E\u0439\u0446\u043E\u0432 \u043C\u0435\u0442\u043A\u0438\u043C\u0438
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438 \u0441\u043D\u044F\u043B
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u0431\u0430\u043A,
      \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0432 \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432
      \u0437\u0430\u043B\u0435\u0447\u044C. \u042D\u0442\u043E \u0434\u0430\u043B\u043E
      \u0432\u0430\u043C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0442\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F "
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097156
    m_Localized: "\u041F\u0440\u0438\u043A\u0430\u0437 \"\u0411\u0435\u0436\u0430\u0442\u044C!\"
      \u0441\u0442\u0430\u043B \u0441\u0438\u0433\u043D\u0430\u043B\u043E\u043C \u043A
      \u043F\u043E\u043B\u043D\u043E\u0439 \u043F\u0430\u043D\u0438\u043A\u0435.
      \u0421\u043E\u043B\u0434\u0430\u0442\u044B \u043F\u043E\u0431\u0440\u043E\u0441\u0430\u043B\u0438
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u0438 \u043A\u0438\u043D\u0443\u043B\u0438\u0441\u044C
      \u0432\u0440\u0430\u0441\u0441\u044B\u043F\u043D\u0443\u044E, \u0434\u0443\u043C\u0430\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u043E \u0441\u0435\u0431\u0435. \u041D\u0435\u043C\u0435\u0446\u043A\u0438\u0435
      \u043E\u0432\u0447\u0430\u0440\u043A\u0438 \u0440\u0432\u0430\u043B\u0438 \u0431\u0435\u0433\u0443\u0449\u0438\u0445,
      \u0430 \u0444\u0430\u0448\u0438\u0441\u0442\u044B \u0434\u043E\u0431\u0438\u0432\u0430\u043B\u0438
      \u0440\u0430\u043D\u0435\u043D\u044B\u0445. \u0412\u044B \u0447\u0443\u0434\u043E\u043C
      \u0443\u0446\u0435\u043B\u0435\u043B\u0438, \u0441\u043E\u0431\u0440\u0430\u0432
      \u043E\u0441\u0442\u0430\u0442\u043A\u0438 \u043E\u0442\u0440\u044F\u0434\u0430
      \u043B\u0438\u0448\u044C \u043A \u0443\u0442\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097157
    m_Localized: "\u0421\u0430\u043C\u044B\u0439 \u0431\u044B\u0441\u0442\u0440\u044B\u0439
      \u0431\u043E\u0435\u0446 \u0432\u044B\u0437\u0432\u0430\u043B\u0441\u044F \u043E\u0442\u0432\u043B\u0435\u0447\u044C
      \u0441\u043E\u0431\u0430\u043A \u0438 \u043D\u0430\u0443\u0442\u0440\u043E
      \u043E\u043D \u0443\u0436\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0432 \u043E\u0442\u0440\u044F\u0434 \u0431\u0435\u0437 \u0441\u0438\u043B.
      \u041E\u043D \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E
      \u0437\u0430\u043C\u0430\u043D\u0438\u043B \u043F\u0441\u043E\u0432 \u0432
      \u0431\u043E\u043B\u043E\u0442\u043E, \u0433\u0434\u0435 \u043E\u043D\u0438
      \u0438 \u0443\u0432\u044F\u0437\u043B\u0438 \u0432 \u0442\u0440\u044F\u0441\u0438\u043D\u0435,
      \u0441\u043F\u0435\u0448\u0430 \u0437\u0430 \u043D\u0438\u043C. \u0415\u043C\u0443
      \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0443\u0432\u0435\u0441\u0442\u0438
      \u043F\u0430\u0442\u0440\u0443\u043B\u044C \u043E\u0442 \u0432\u0430\u0441.
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0444\u0430\u0448\u0438\u0441\u0442\u044B
      \u0440\u0435\u0448\u0430\u0442, \u0447\u0442\u043E \u0432\u0430\u0441 \u0443\u0442\u044F\u043D\u0443\u043B\u043E,
      \u043A\u0430\u043A \u0438 \u0438\u0445 \u0441\u043E\u0431\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097158
    m_Localized: "\u0421\u043E\u0431\u0430\u043A\u0438 \u043D\u0430\u043A\u0438\u043D\u0443\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0441\u043E\u043B\u0434\u0430\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u044F\u0440\u043E\u0441\u0442\u043D\u043E \u0441\u0440\u0430\u0436\u0430\u043B\u0441\u044F
      \u0441 \u043D\u0438\u043C\u0438. \u042D\u0442\u043E \u0431\u044B\u043B\u0430
      \u0441\u0442\u0440\u0430\u0448\u043D\u0430\u044F \u0441\u043C\u0435\u0440\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097159
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u0441\u043B\u0430\u0436\u0435\u043D\u043D\u043E \u0438 \u0431\u044B\u0441\u0442\u0440\u043E.
      \u0412\u044B \u043D\u0430\u0448\u043B\u0438 \u0442\u0440\u043E\u043F\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0432\u044B\u0432\u0435\u043B\u0430
      \u0432\u0430\u0441 \u043F\u0440\u044F\u043C\u043E \u043A \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u043E\u043C\u0443
      \u043A\u0440\u0430\u044E \u043F\u043E\u0436\u0430\u0440\u0430, \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0432
      \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438. \u0411\u043E\u0439\u0446\u044B
      \u0433\u043E\u0440\u0434\u044F\u0442\u0441\u044F \u0441\u0432\u043E\u0438\u043C
      \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0438 \u0432 \u043E\u0433\u043D\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442
      \u0432\u0435\u0440\u043D\u0443\u044E \u0434\u043E\u0440\u043E\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097160
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u0443\u043D\u0435\u0441 \u0436\u0438\u0437\u043D\u0438
      \u0447\u0435\u0442\u0432\u0435\u0440\u044B\u0445 \u0441\u043E\u043B\u0434\u0430\u0442,
      \u0441\u0433\u043E\u0440\u0435\u043B\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u044B.
      \u041D\u043E \u043F\u0430\u0442\u0440\u0443\u043B\u0438, \u0438\u0434\u0443\u0449\u0438\u0435
      \u043F\u043E \u0432\u0430\u0448\u0438\u043C \u0441\u043B\u0435\u0434\u0430\u043C,
      \u043D\u0430 \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u043B\u0438
      \u043F\u043E\u0438\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097161
    m_Localized: "\u0412\u0430\u043C \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0443\u043A\u0440\u044B\u0442\u044C\u0441\u044F
      \u043E\u0442 \u043E\u0433\u043D\u044F, \u043D\u043E \u0433\u043E\u0440\u044F\u0449\u0435\u0435
      \u0434\u0435\u0440\u0435\u0432\u043E \u0443\u043F\u0430\u043B\u043E \u0432
      \u044F\u043C\u0443 \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0438\u0437 \u0432\u0430\u0448\u0438\u0445 \u0431\u043E\u0439\u0446\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097162
    m_Localized: "\u041E\u0434\u0438\u043D \u0441\u043E\u043B\u0434\u0430\u0442,
      \u0431\u043E\u044F\u0432\u0448\u0438\u0439\u0441\u044F \u0441\u0433\u043E\u0440\u0435\u0442\u044C
      \u0437\u0430\u0436\u0438\u0432\u043E, \u0440\u0435\u0448\u0438\u043B, \u0447\u0442\u043E
      \u0443\u0441\u043F\u0435\u0435\u0442 \u0432\u044B\u0431\u0435\u0436\u0430\u0442\u044C
      \u0438\u0437 \u043B\u0435\u0441\u0430. \u041E\u043D \u043A\u0438\u043D\u0443\u043B\u0441\u044F
      \u043F\u0440\u043E\u0447\u044C, \u043D\u043E, \u043D\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0439
      \u0432\u0435\u0449\u043C\u0435\u0448\u043A\u0430\u043C\u0438, \u0441\u043F\u043E\u0442\u043A\u043D\u0443\u043B\u0441\u044F,
      \u0443\u043F\u0430\u043B \u0432 \u043E\u0432\u0440\u0430\u0433 \u0438 \u0440\u0430\u0437\u0431\u0438\u043B\u0441\u044F
      \u043D\u0430\u0441\u043C\u0435\u0440\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097163
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043B
      \u0432\u0430\u0448\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0431\u0435\u0437\u0443\u043C\u0435\u0446 \u043F\u043E\u0448\u0435\u043B \u0431\u044B
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0433\u043E\u043D\u044C, \u043D\u043E
      \u043F\u0443\u0442\u044C \u0434\u043E \u0441\u0432\u043E\u0438\u0445 \u0441\u0442\u0430\u043B
      \u0434\u043E\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097164
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u0440\u0435\u0437\u043A\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u0438\u043B\u0441\u044F,
      \u0438 \u043E\u0433\u043E\u043D\u044C \u043D\u0430\u0447\u0430\u043B \u043E\u043A\u0440\u0443\u0436\u0430\u0442\u044C
      \u0432\u0430\u0441. \u0412 \u043F\u0430\u043D\u0438\u043A\u0435 \u043E\u0442\u0440\u044F\u0434
      \u0447\u0443\u0442\u044C \u043D\u0435 \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u043B
      \u0432\u0441\u0435\u0445. \u0412\u044B \u0432\u044B\u0441\u043A\u043E\u0447\u0438\u043B\u0438
      \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u0438\u0437 \u043E\u0433\u043D\u044F,
      \u043F\u043E\u0442\u0435\u0440\u044F\u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\u0435
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097165
    m_Localized: "\u041F\u043E\u043A\u0430 \u0444\u0430\u0448\u0438\u0441\u0442\u044B
      \u0431\u044B\u043B\u0438 \u0437\u0430\u043D\u044F\u0442\u044B \u0441\u0436\u0438\u0433\u0430\u043D\u0438\u0435\u043C
      \u0434\u043E\u043C\u0430, \u0432\u044B \u0443\u0441\u043F\u0435\u0448\u043D\u043E
      \u043D\u0430\u0448\u043B\u0438 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B, \u043D\u043E \u0432\u0440\u0430\u0433
      \u0437\u0430\u043C\u0435\u0442\u0438\u0442 \u0438\u0445 \u043F\u0440\u043E\u043F\u0430\u0436\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097166
    m_Localized: "\u041F\u043E\u043A\u0430 \u0444\u0430\u0448\u0438\u0441\u0442\u044B
      \u0431\u044B\u043B\u0438 \u0437\u0430\u043D\u044F\u0442\u044B \u0441\u0436\u0438\u0433\u0430\u043D\u0438\u0435\u043C
      \u0434\u043E\u043C\u0430, \u0432\u044B \u0443\u0441\u043F\u0435\u0448\u043D\u043E
      \u043D\u0430\u0448\u043B\u0438 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B, \u043D\u043E \u0432\u0440\u0430\u0433
      \u0437\u0430\u043C\u0435\u0442\u0438\u0442 \u0438\u0445 \u043F\u0440\u043E\u043F\u0430\u0436\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097167
    m_Localized: "\u0412\u044B \u0441\u043C\u043E\u0433\u043B\u0438 \u043F\u0440\u043E\u0439\u0442\u0438
      \u043D\u0435\u0437\u0430\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u043C\u0438,
      \u0442\u0430\u043A \u043A\u0430\u043A \u0444\u0430\u0448\u0438\u0441\u0442\u044B
      \u0431\u044B\u043B\u0438 \u0437\u0430\u043D\u044F\u0442\u044B \u0434\u0440\u0443\u0433\u0438\u043C
      \u0434\u0435\u043B\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097168
    m_Localized: "\u0412\u044B \u0441\u043C\u043E\u0433\u043B\u0438 \u043F\u0440\u043E\u0439\u0442\u0438
      \u043D\u0435\u0437\u0430\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u043C\u0438,
      \u0442\u0430\u043A \u043A\u0430\u043A \u0444\u0430\u0448\u0438\u0441\u0442\u044B
      \u0431\u044B\u043B\u0438 \u0437\u0430\u043D\u044F\u0442\u044B \u0434\u0440\u0443\u0433\u0438\u043C
      \u0434\u0435\u043B\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097169
    m_Localized: "\u0421\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0430\u0442\u0430\u043A\u0430 \u0437\u0430\u0441\u0442\u0430\u043B\u0430 \u0432\u0440\u0430\u0433\u0430
      \u0432\u0440\u0430\u0441\u043F\u043B\u043E\u0445. \u0424\u0430\u0448\u0438\u0441\u0442\u044B
      \u043F\u0435\u0440\u0435\u0431\u0438\u0442\u044B, \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441\u043F\u0430\u0441\u0435\u043D\u044B
      \u0438\u0437 \u043E\u0433\u043D\u044F. \u041E\u043D\u0438 \u0437\u043D\u0430\u044E\u0442,
      \u0447\u0442\u043E \u0444\u0430\u0448\u0438\u0441\u0442\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F
      \u0438 \u0441\u043E\u0436\u0433\u0443\u0442 \u0434\u0435\u0440\u0435\u0432\u043D\u044E
      \u0434\u043E\u0442\u043B\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043E\u043D\u0438 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044E\u0442\u0441\u044F
      \u043A \u0432\u0430\u0448\u0435\u043C\u0443 \u043E\u0442\u0440\u044F\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097170
    m_Localized: "\u0412\u044B \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u043E\u0433\u043E\u043D\u044C,
      \u0438, \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0442\u043E,
      \u0447\u0442\u043E \u0438\u0445 \u0431\u044B\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0432\u044B \u0441\u043C\u043E\u0433\u043B\u0438 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u043E\u0442\u0440\u044F\u0434
      \u0432\u0440\u0430\u0433\u0430. \u041E\u0434\u043D\u0430\u043A\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0431\u043E\u0439\u0446\u043E\u0432.
      \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u043D\u0438\u043A\u043E\u0433\u043E
      \u0441\u043F\u0430\u0441\u0442\u0438 \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C,
      \u0432\u0441\u0435 \u0441\u0433\u043E\u0440\u0435\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097171
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u043B\u0441\u044F,
      \u043D\u043E \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0441\u0442\u0430\u043B\u043E
      \u043C\u0435\u043D\u044C\u0448\u0435. \u0424\u0430\u0448\u0438\u0441\u0442\u044B,
      \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0432\u0448\u0438\u0435
      \u0442\u0443 \u0433\u0440\u0443\u043F\u043F\u0443, \u0442\u0435\u043F\u0435\u0440\u044C
      \u0438\u0434\u0443\u0442 \u043F\u043E \u0432\u0430\u0448\u0435\u043C\u0443
      \u0441\u043B\u0435\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479426097172
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0431\u0440\u0430\u0442\u044C \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0438\u0445,
      \u0441\u0441\u044B\u043B\u0430\u044F\u0441\u044C \u043D\u0430 \u0442\u043E,
      \u0447\u0442\u043E \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u043D\u0430
      \u0438\u0441\u0445\u043E\u0434\u0435, \u0438 \u043B\u0438\u0448\u043D\u0438\u0435
      \u0440\u0442\u044B \u043D\u0435 \u043D\u0443\u0436\u043D\u044B. \u041A\u043E\u043D\u0444\u043B\u0438\u043A\u0442
      \u0435\u0434\u0432\u0430 \u043D\u0435 \u043F\u0435\u0440\u0435\u0440\u043E\u0441
      \u0432 \u0434\u0440\u0430\u043A\u0443, \u0438 \u043B\u044E\u0434\u0435\u0439
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0432 \u043B\u0435\u0441\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479430291456
    m_Localized: "\u0412\u044B \u0440\u0435\u0448\u0438\u043B\u0438 \u043D\u0435
      \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C \u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0438\u0445 \u043F\u043E\u0437\u0430\u0434\u0438.
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u044D\u0442\u043E \u0443\u0431\u0435\u0440\u0435\u0436\u0435\u0442
      \u043E\u0442\u0440\u044F\u0434 \u043E\u0442 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479430291457
    m_Localized: "\u0412\u044B \u0440\u0435\u0448\u0438\u043B\u0438 \u043D\u0435
      \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C \u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0438\u0445 \u043F\u043E\u0437\u0430\u0434\u0438.
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u044D\u0442\u043E \u0443\u0431\u0435\u0440\u0435\u0436\u0435\u0442
      \u043E\u0442\u0440\u044F\u0434 \u043E\u0442 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479430291458
    m_Localized: "\u0412\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B\u0438,
      \u0447\u0442\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0437\u044F\u0442\u044C
      \u0438\u0445 \u0441 \u0441\u043E\u0431\u043E\u0439, \u043D\u043E \u0434\u0430\u043B\u0438
      \u0438\u043C \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432.
      \u0412 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u043E\u043D\u0438 \u0441\u043E\u043E\u0431\u0449\u0438\u043B\u0438 \u0432\u0430\u043C
      \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445
      \u043F\u043E\u0441\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479430291459
    m_Localized: "\u0412\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B\u0438,
      \u0447\u0442\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0437\u044F\u0442\u044C
      \u0438\u0445 \u0441 \u0441\u043E\u0431\u043E\u0439, \u043D\u043E \u0434\u0430\u043B\u0438
      \u0438\u043C \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432.
      \u0412 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u043E\u043D\u0438 \u0441\u043E\u043E\u0431\u0449\u0438\u043B\u0438 \u0432\u0430\u043C
      \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445
      \u043F\u043E\u0441\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479430291460
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u043A\u0438 \u043E\u0442\u043F\u0443\u0433\u043D\u0443\u0442\u044C
      \u043A\u0430\u0431\u0430\u043D\u043E\u0432 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u043B\u0438 \u0438\u0445 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435.
      \u0412\u0441\u043A\u043E\u0440\u0435 \u043E\u043D\u0438 \u044F\u0440\u043E\u0441\u0442\u043D\u043E
      \u043D\u0430\u0431\u0440\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u043D\u0430
      \u043E\u0442\u0440\u044F\u0434, \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0431\u043E\u0439\u0446\u043E\u0432 \u043F\u0430\u043B\u0438 \u043F\u043E\u0434
      \u0443\u0434\u0430\u0440\u0430\u043C\u0438 \u0440\u0430\u0437\u044A\u044F\u0440\u0435\u043D\u043D\u044B\u0445
      \u0437\u0432\u0435\u0440\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479430291461
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u043A\u0438 \u043E\u0442\u043F\u0443\u0433\u043D\u0443\u0442\u044C
      \u043A\u0430\u0431\u0430\u043D\u043E\u0432 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u043B\u0438 \u0438\u0445 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435.
      \u0412\u0441\u043A\u043E\u0440\u0435 \u043E\u043D\u0438 \u044F\u0440\u043E\u0441\u0442\u043D\u043E
      \u043D\u0430\u0431\u0440\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u043D\u0430
      \u043E\u0442\u0440\u044F\u0434, \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0431\u043E\u0439\u0446\u043E\u0432 \u043F\u0430\u043B\u0438 \u043F\u043E\u0434
      \u0443\u0434\u0430\u0440\u0430\u043C\u0438 \u0440\u0430\u0437\u044A\u044F\u0440\u0435\u043D\u043D\u044B\u0445
      \u0437\u0432\u0435\u0440\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479430291462
    m_Localized: "\u0412\u044B \u0441\u043C\u043E\u0433\u043B\u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u043B\u043E\u0433\u043E\u0432\u043E
      \u043A\u0430\u0431\u0430\u043D\u043E\u0432, \u0437\u0430\u0449\u0438\u0449\u0430\u0432\u0449\u0438\u0445
      \u0441\u0432\u043E\u044E \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479430291463
    m_Localized: "\u041E\u0434\u0438\u043D \u0431\u043E\u0435\u0446 \u043D\u0435
      \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043B \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F
      \u0438 \u043F\u043E\u0431\u0435\u0436\u0430\u043B. \u041A\u0430\u0431\u0430\u043D\u044B
      \u0440\u0438\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0430 \u0432\u0430\u0441.
      \u0412 \u0441\u0443\u043C\u0430\u0442\u043E\u0445\u0435 \u043F\u043E\u0433\u0438\u0431\u043B\u043E
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E, \u0430 \u0431\u0435\u0433\u043B\u0435\u0446
      \u0442\u0430\u043A \u0438 \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479430291464
    m_Localized: "\u0412\u0438\u043D\u0442\u043E\u0432\u043A\u0438 \u0441 \u0442\u0440\u0443\u0434\u043E\u043C
      \u0431\u0440\u0430\u043B\u0438 \u0448\u043A\u0443\u0440\u0443, \u043D\u043E
      \u043C\u0435\u0442\u043A\u0438\u0435 \u0437\u0430\u043B\u043F\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0441\u0432\u043E\u0435 \u0434\u0435\u043B\u043E, \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0432
      \u0440\u0430\u0437\u044A\u044F\u0440\u0435\u043D\u043D\u044B\u0445 \u0437\u0432\u0435\u0440\u0435\u0439.
      \u041E\u0442\u0440\u044F\u0434 \u0446\u0435\u043B, \u043E\u0434\u043D\u0430\u043A\u043E
      \u0448\u0443\u043C \u0432\u044B\u0434\u0430\u0441\u0442 \u0432\u0430\u0448\u0435
      \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479430291465
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E
      \u0437\u0430\u043B\u043F\u0430 \u043E\u043D\u0438 \u043D\u0435 \u0443\u0431\u0435\u0436\u0430\u043B\u0438,
      \u0430 \u043A\u0438\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0430 \u0432\u0430\u0441.
      \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0431\u043E\u0439\u0446\u043E\u0432
      \u0437\u0430\u0442\u043E\u043F\u0442\u0430\u043D\u044B \u043D\u0430\u0441\u043C\u0435\u0440\u0442\u044C,
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0432 \u043F\u0430\u043D\u0438\u043A\u0435
      \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C \u043F\u043E
      \u043B\u0435\u0441\u0443. \u041A \u0443\u0442\u0440\u0443 \u0432\u044B \u043A\u043E\u0435-\u043A\u0430\u043A
      \u0441\u043E\u0431\u0440\u0430\u043B\u0438 \u043E\u0442\u0440\u044F\u0434,
      \u043D\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043B\u044E\u0434\u0435\u0439,
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u0438 \u0432\u0440\u0435\u043C\u044F.
      \u0410 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u0432 \u043D\u043E\u0447\u043D\u043E\u043C
      \u043B\u0435\u0441\u0443 \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
      \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u043B\u0438 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043F\u0430\u0442\u0440\u0443\u043B\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 153648479430291466
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0432\u0435\u0448\u0435\u043D\u043D\u044B\u0445
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0436\u0438\u0432\u044B\u043C.
      \u0412\u044B \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043B\u0438 \u0435\u0433\u043E
      \u0440\u0430\u043D\u044B \u0438 \u0432\u0437\u044F\u043B\u0438 \u0441 \u0441\u043E\u0431\u043E\u0439.
      \u041C\u043E\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0434\u0443\u0445 \u043E\u0442\u0440\u044F\u0434\u0430
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F. \u041D\u043E \u043F\u0430\u0442\u0440\u0443\u043B\u044C
      \u0437\u0430\u043C\u0435\u0442\u0438\u0442 \u043F\u0440\u043E\u043F\u0430\u0436\u0443
      \u0438 \u043D\u0430\u0447\u043D\u0435\u0442 \u043F\u043E\u0438\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479430291467
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0432\u0435\u0448\u0435\u043D\u043D\u044B\u0445
