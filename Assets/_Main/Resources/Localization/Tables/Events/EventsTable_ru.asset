  - m_Id: 153648479409319938
    m_Localized: "\u0421\u0430\u043C\u044B\u0439 \u043B\u0435\u0433\u043A\u0438\u0439
      \u0431\u043E\u0435\u0446 \u043F\u0435\u0440\u0432\u044B\u043C \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u043B\u0441\u044F
      \u043D\u0430 \u0442\u043E\u0442 \u0431\u0435\u0440\u0435\u0433. \u0417\u0430\u0442\u0435\u043C
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0440\u0435\u043C\u043D\u0435\u0439
      \u0438 \u0432\u0435\u0440\u0435\u0432\u043E\u043A \u0441\u043E\u043B\u0434\u0430\u0442\u044B
      \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u0438 \u0432\u0441\u0435
      \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435, \u0441\u0442\u0440\u0430\u0445\u0443\u044F
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430. \u041A\u043E\u0433\u0434\u0430
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0441\u0442\u0443\u043F\u0438\u043B
      \u043D\u0430 \u0437\u0435\u043C\u043B\u044E, \u043E\u0442\u0440\u044F\u0434
      \u0432\u0437\u0434\u043E\u0445\u043D\u0443\u043B \u0441 \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0438\u0435\u043C
      \u2014 \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 \u043F\u043E\u0442\u0435\u0440\u0438,
      \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 \u043E\u0448\u0438\u0431\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319939
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430 \u043F\u043E
      \u0431\u0440\u0435\u0432\u043D\u0443 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043E\u043F\u0430\u0441\u043D\u043E\u0439: \u043E\u0434\u0438\u043D \u0432\u0430\u0448
      \u0431\u043E\u0435\u0446 \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0440\u0430\u0432\u043D\u043E\u0432\u0435\u0441\u0438\u0435,
      \u0441\u043E\u0440\u0432\u0430\u043B\u0441\u044F, \u0438 \u0435\u0433\u043E
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E \u0443\u043D\u0435\u0441\u043B\u043E
      \u0442\u0435\u0447\u0435\u043D\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319940
    m_Localized: "\u0422\u0435\u0447\u0435\u043D\u0438\u0435 \u0440\u0435\u043A\u0438
      \u043D\u0435 \u043C\u0435\u043D\u044F\u043B\u043E\u0441\u044C, \u0432\u044B
      \u0448\u043B\u0438 \u0432\u0441\u0435 \u0434\u0430\u043B\u044C\u0448\u0435.
      \u041D\u0430\u043A\u043E\u043D\u0435\u0446 \u0432\u044B \u043D\u0430\u0448\u043B\u0438
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u0438 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C, \u043D\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0438
      \u0441\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319941
    m_Localized: "\u0414\u0432\u043E\u0435 \u0441\u043E\u043B\u0434\u0430\u0442 \u043E\u0441\u043B\u0443\u0448\u0430\u043B\u0430\u0441\u044C
      \u0438 \u043F\u043E\u043B\u0435\u0437\u043B\u0438 \u043D\u0430 \u0431\u0440\u0435\u0432\u043D\u043E.
      \u041E\u0434\u0438\u043D \u043D\u0435 \u0443\u0434\u0435\u0440\u0436\u0430\u043B\u0441\u044F
      \u0438 \u0443\u043F\u0430\u043B, \u0435\u0433\u043E \u043E\u0442\u043D\u0435\u0441\u043B\u043E
      \u0441\u0438\u043B\u044C\u043D\u044B\u043C \u0442\u0435\u0447\u0435\u043D\u0438\u0435\u043C.
      \u0412\u0442\u043E\u0440\u043E\u0439, \u0443\u0432\u0438\u0434\u0435\u0432,
      \u0447\u0442\u043E \u043D\u0438\u043A\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u0438\u0434\u0442\u0438
      \u043F\u043E \u0431\u0440\u0435\u0432\u043D\u0443, \u043E\u0441\u043E\u0437\u043D\u0430\u043B
      \u0441\u0432\u043E\u044E \u043E\u0448\u0438\u0431\u043A\u0443, \u0438 \u043D\u0435
      \u0440\u0435\u0448\u0438\u043B\u0441\u044F \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F
      \u043A \u0432\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319942
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u044F\u0433\u043E\u0434\u044B
      \u0438 \u0433\u0440\u0438\u0431\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0441\u044A\u0435\u0434\u043E\u0431\u043D\u044B\u043C\u0438. \u0411\u043E\u0439\u0446\u044B
      \u043E\u0431\u0440\u0430\u0434\u043E\u0432\u0430\u043B\u0438\u0441\u044C, \u0447\u0442\u043E
      \u0445\u043E\u0442\u044C \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0431\u044B\u0442\u044C
      \u043E \u0433\u043E\u043B\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319943
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u044F\u0433\u043E\u0434\u044B
      \u0438 \u0433\u0440\u0438\u0431\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0441\u044A\u0435\u0434\u043E\u0431\u043D\u044B\u043C\u0438. \u0411\u043E\u0439\u0446\u044B
      \u043E\u0431\u0440\u0430\u0434\u043E\u0432\u0430\u043B\u0438\u0441\u044C, \u0447\u0442\u043E
      \u0445\u043E\u0442\u044C \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0431\u044B\u0442\u044C
      \u043E \u0433\u043E\u043B\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319944
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u0432\u043E\u0440\u0447\u0430\u043B,
      \u043D\u043E \u0448\u0435\u043B \u0437\u0430 \u0432\u0430\u043C\u0438. \u041A\u043E\u0433\u0434\u0430
      \u0432\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C
      \u0443 \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u0434\u0443\u0431\u0430
      \u0438 \u043F\u0440\u0438\u0441\u043B\u0443\u0448\u0430\u043B\u0438\u0441\u044C
      \u043A \u0436\u0443\u0436\u0436\u0430\u043D\u0438\u044E, \u0441\u043A\u0435\u043F\u0442\u0438\u0446\u0438\u0437\u043C
      \u0441\u043C\u0435\u043D\u0438\u043B\u0441\u044F \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E\u043C.
      \u0427\u0435\u0440\u0435\u0437 \u043F\u043E\u043B\u0447\u0430\u0441\u0430 \u0443
      \u0432\u0441\u0435\u0445 \u0431\u044B\u043B\u0438 \u043A\u0443\u0441\u043A\u0438
      \u0441\u043E\u0442\u043E\u0432\u043E\u0433\u043E \u043C\u0435\u0434\u0430.
      \u0414\u043E\u0432\u0435\u0440\u0438\u0435 \u043A \u0432\u0430\u043C \u0443\u043A\u0440\u0435\u043F\u0438\u043B\u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319945
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442\u044B, \u0438 \u0442\u0430\u043A
      \u043E\u0437\u043B\u043E\u0431\u043B\u0435\u043D\u043D\u044B\u0435, \u0432\u043E\u0441\u043F\u0440\u0438\u043D\u044F\u043B\u0438
      \u0432\u0430\u0448 \u043F\u0440\u0438\u043A\u0430\u0437 \u043A\u0430\u043A
      \u0438\u0437\u0434\u0435\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E.
      \u041D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E \u043E\u0442 \u0432\u0430\u0441
      \u043E\u043D\u0438 \u0441\u043C\u043E\u0433\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E
      \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435,
      \u0430 \u043D\u043E\u0447\u044C\u044E \u0432\u0435\u0441\u044C \u043E\u0442\u0440\u044F\u0434
      \u0443\u0441\u043B\u044B\u0448\u0430\u043B \u0438\u0445 \u043A\u043E\u0440\u0447\u0430\u0449\u0438\u043C\u0438\u0441\u044F
      \u0432 \u0441\u0443\u0434\u043E\u0440\u043E\u0433\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319946
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442 \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043E\u0442 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0433\u0440\u0438\u0431\u043E\u0432
      \u0438 \u044F\u0433\u043E\u0434, \u043D\u043E \u0442\u0435, \u0447\u0442\u043E
      \u043E\u043D \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B,
      \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u0431\u0435\u0437\u0432\u0440\u0435\u0434\u043D\u044B\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319947
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442 \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043E\u0442 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0433\u0440\u0438\u0431\u043E\u0432
      \u0438 \u044F\u0433\u043E\u0434, \u043D\u043E \u0442\u0435, \u0447\u0442\u043E
      \u043E\u043D \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B,
      \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u0431\u0435\u0437\u0432\u0440\u0435\u0434\u043D\u044B\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319948
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u0432\u044B \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E
      \u043F\u0440\u043E\u0448\u043B\u0438 \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u0440\u0435\u0432\u043D\u044E,
      \u0441\u043E\u0431\u0440\u0430\u0432 \u043F\u0440\u0438\u043F\u0430\u0441\u044B.
      \u0423\u0442\u0440\u043E\u043C \u043A\u0442\u043E-\u0442\u043E \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0437\u0430\u043C\u0435\u0442\u0438\u0442 \u0438\u0445 \u043F\u0440\u043E\u043F\u0430\u0436\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319949
    m_Localized: "\u0412 \u043E\u0434\u043D\u043E\u043C \u0438\u0437 \u0434\u043E\u043C\u043E\u0432
      \u0441\u043E\u043B\u0434\u0430\u0442 \u0443\u0432\u0438\u0434\u0435\u043B \u043D\u0430
      \u0441\u0442\u0435\u043D\u0435 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438
      \u0445\u043E\u0437\u044F\u0438\u043D\u0430, \u0441 \u043A\u0430\u0437\u043D\u044F\u043C\u0438
      \u0432 \u043A\u043E\u043D\u0446\u043B\u0430\u0433\u0435\u0440\u044F\u0445.
      \u041D\u0435 \u0441\u0434\u0435\u0440\u0436\u0430\u0432\u0448\u0438\u0441\u044C,
      \u0431\u043E\u0435\u0446 \u0432\u044B\u0445\u0432\u0430\u0442\u0438\u043B \u043D\u043E\u0436,
      \u043D\u043E \u0448\u0443\u043C \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u043B
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445. \u0412\u0430\u043C
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0431\u044B\u0441\u0442\u0440\u043E
      \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u0434\u0435\u0440\u0435\u0432\u043D\u044E.
      \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u0432\u044B
      \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0438 \u043D\u0438\u0447\u0435\u0433\u043E
      \u0432\u0437\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319950
    m_Localized: "\u0412\u044B \u043E\u0431\u043E\u0448\u043B\u0438 \u0434\u0435\u0440\u0435\u0432\u043D\u044E,
      \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0432 \u043D\u0430 \u044D\u0442\u043E
      \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043C\u0435\u0441\u0442\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319951
    m_Localized: "\u0412\u044B \u043E\u0431\u043E\u0448\u043B\u0438 \u0434\u0435\u0440\u0435\u0432\u043D\u044E,
      \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0432 \u043D\u0430 \u044D\u0442\u043E
      \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043C\u0435\u0441\u0442\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319952
    m_Localized: "\u041F\u043E\u043F\u043E\u043B\u043D\u044F\u044F \u043F\u0440\u0438\u043F\u0430\u0441\u044B,
      \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u043E\u043B\u0434\u0430\u0442
      \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0441\u044F \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u044E
      \u0441\u0442\u0430\u0440\u0438\u043A\u0430. \u0412 \u0441\u0442\u0440\u0430\u0445\u0435
      \u0438\u043B\u0438 \u0433\u043D\u0435\u0432\u0435 \u0431\u043E\u0439\u0446\u044B
      \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u043E\u0433\u043E\u043D\u044C \u043F\u043E
      \u043C\u0435\u0441\u0442\u043D\u044B\u043C. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043D\u0435\u0442 \u043D\u0438
      \u0434\u0443\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319953
    m_Localized: "\u041F\u043E\u043F\u043E\u043B\u043D\u044F\u044F \u043F\u0440\u0438\u043F\u0430\u0441\u044B,
      \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u043E\u043B\u0434\u0430\u0442
      \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0441\u044F \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u044E
      \u0441\u0442\u0430\u0440\u0438\u043A\u0430. \u0412 \u0441\u0442\u0440\u0430\u0445\u0435
      \u0438\u043B\u0438 \u0433\u043D\u0435\u0432\u0435 \u0431\u043E\u0439\u0446\u044B
      \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u043E\u0433\u043E\u043D\u044C \u043F\u043E
      \u043C\u0435\u0441\u0442\u043D\u044B\u043C. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043D\u0435\u0442 \u043D\u0438
      \u0434\u0443\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319954
    m_Localized: "\u0412\u044B \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438
      \u043D\u0435\u0440\u0432\u043D\u043E\u0433\u043E \u0441\u043E\u043B\u0434\u0430\u0442\u0430
      \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C, \u0438 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439
      \u043D\u043E\u0447\u044C\u044E \u043E\u043D \u0443\u0441\u043B\u044B\u0448\u0430\u043B
      \u0448\u043E\u0440\u043E\u0445 \u0438 \u0443\u0432\u0438\u0434\u0435\u043B,
      \u043A\u0430\u043A \u0432\u043E\u043B\u043A\u0438 \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044C
      \u043A \u0447\u0430\u0441\u043E\u0432\u043E\u043C\u0443, \u043E\u0434\u043D\u0438\u043C
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u043C \u043E\u043D \u0443\u0431\u0438\u043B
      \u0432\u043E\u043B\u043A\u0430, \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B
      \u0432\u0441\u043A\u043E\u0447\u0438\u0442\u044C \u0432\u0441\u0435\u0445.
      \u041E\u0442\u0431\u0438\u0432\u0448\u0438\u0441\u044C \u043E\u0442 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445,
      \u0432\u044B \u043F\u043E\u043D\u044F\u043B\u0438: \u044D\u0442\u043E \u0431\u044B\u043B\u0430
      \u043D\u0435 \u043D\u0435\u0440\u0432\u043E\u0437\u043D\u043E\u0441\u0442\u044C,
      \u0430 \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u0438\u043D\u043E\u0433\u0434\u0430 \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319955
    m_Localized: "\u0411\u043E\u0435\u0446 \u0431\u044B\u043B \u0443\u0431\u0435\u0436\u0434\u0435\u043D,
      \u0447\u0442\u043E \u0437\u0430 \u043E\u0442\u0440\u044F\u0434\u043E\u043C
      \u0441\u043B\u0435\u0434\u0438\u043B\u0438, \u043D\u043E \u043F\u043E\u0434\u0447\u0438\u043D\u0438\u043B\u0441\u044F
      \u043F\u0440\u0438\u043A\u0430\u0437\u0443 \u0438 \u0443\u0448\u0435\u043B
      \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C. \u0423\u0442\u0440\u043E\u043C
      \u0432\u044B \u043D\u0430\u0448\u043B\u0438 \u0434\u0432\u043E\u0438\u0445
      \u0447\u0430\u0441\u043E\u0432\u044B\u0445 \u0441 \u043F\u0435\u0440\u0435\u0433\u0440\u044B\u0437\u0435\u043D\u043D\u044B\u043C\u0438
      \u0433\u043B\u043E\u0442\u043A\u0430\u043C\u0438 \u2014 \u0432\u043E\u043B\u043A\u0438
      \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0438\u043C
      \u0448\u0430\u043D\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319956
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u0440\u0430\u0437\u0434\u0430\u043B\u0441\u044F
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B. \u041E\u0442\u0440\u044F\u0434
      \u0432\u0441\u043A\u043E\u0447\u0438\u043B \u0438 \u0443\u0432\u0438\u0434\u0435\u043B
      \u0443\u0431\u0438\u0442\u043E\u0433\u043E \u0432\u043E\u043B\u043A\u0430 \u0438
      \u0441\u043E\u043B\u0434\u0430\u0442\u0430 \u043D\u0430\u0434 \u043D\u0438\u043C:
      \xAB\u042F \u0436\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0437\u0430
      \u043D\u0430\u043C\u0438 \u0441\u043B\u0435\u0434\u0438\u043B\u0438!\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514240
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u0440\u0430\u0437\u0434\u0430\u043B\u0441\u044F
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B. \u041E\u0442\u0440\u044F\u0434
      \u0432\u0441\u043A\u043E\u0447\u0438\u043B \u0438 \u0443\u0432\u0438\u0434\u0435\u043B
      \u0443\u0431\u0438\u0442\u043E\u0433\u043E \u0432\u043E\u043B\u043A\u0430 \u0438
      \u0441\u043E\u043B\u0434\u0430\u0442\u0430 \u043D\u0430\u0434 \u043D\u0438\u043C:
      \xAB\u042F \u0436\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0437\u0430
      \u043D\u0430\u043C\u0438 \u0441\u043B\u0435\u0434\u0438\u043B\u0438!\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514241
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u0432\u044B \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0438\u0441\u044C
      \u043E\u0442 \u043A\u0440\u0438\u043A\u043E\u0432 \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0435\u043A\u0443.
      \u041A\u043E\u0433\u0434\u0430 \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E \u043C\u0435\u0441\u0442\u0430, \u043A\u0440\u0438\u043A\u0438
      \u0441\u0442\u0438\u0445\u043B\u0438. \u0412\u044B \u043D\u0430\u0448\u043B\u0438
      \u043C\u0435\u0440\u0442\u0432\u043E\u0433\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0433\u043E
      \u0438 \u0442\u0435\u043B\u0430 \u0442\u0440\u0435\u0445 \u0432\u043E\u043B\u043A\u043E\u0432.
      \u0412\u0441\u0435-\u0442\u0430\u043A\u0438 \u043E\u043D \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u0443\u0433\u0440\u043E\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514242
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u0432\u044B \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0438\u0441\u044C
      \u043E\u0442 \u043A\u0440\u0438\u043A\u043E\u0432 \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0435\u043A\u0443.
      \u041A\u043E\u0433\u0434\u0430 \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E \u043C\u0435\u0441\u0442\u0430, \u043A\u0440\u0438\u043A\u0438
      \u0441\u0442\u0438\u0445\u043B\u0438. \u0412\u044B \u043D\u0430\u0448\u043B\u0438
      \u043C\u0435\u0440\u0442\u0432\u043E\u0433\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0433\u043E
      \u0438 \u0442\u0435\u043B\u0430 \u0442\u0440\u0435\u0445 \u0432\u043E\u043B\u043A\u043E\u0432.
      \u0412\u0441\u0435-\u0442\u0430\u043A\u0438 \u043E\u043D \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u0443\u0433\u0440\u043E\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514243
    m_Localized: "\u0412\u044B \u0440\u0435\u0448\u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C:
      \u0432 \u0442\u0430\u043A\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443
      \u043F\u0430\u0442\u0440\u0443\u043B\u0438 \u0442\u043E\u0436\u0435 \u043F\u0440\u0438\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438
      \u043F\u043E\u0438\u0441\u043A\u0438, \u0430 \u043A \u0443\u0442\u0440\u0443
      \u0432\u0441\u0435 \u0441\u043B\u0435\u0434\u044B \u0441\u043C\u044B\u043B
      \u0434\u043E\u0436\u0434\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514244
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u0438\u0435 \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u043D\u0435\u043D\u0430\u0434\u0435\u0436\u043D\u044B\u043C, \u0442\u0430\u043A
      \u043A\u0430\u043A \u0432\u043E\u0434\u0430 \u0437\u0430\u043B\u0438\u043B\u0430
      \u0432\u0441\u0435. \u0411\u043E\u0439\u0446\u044B \u043F\u0440\u043E\u043C\u043E\u043A\u043B\u0438
      \u0434\u043E \u043D\u0438\u0442\u043A\u0438 \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0432\u0435\u0449\u043C\u0435\u0448\u043A\u043E\u0432 \u0441 \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438
      \u043F\u0440\u043E\u043C\u043E\u043A\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514245
    m_Localized: "\u041B\u0438\u0432\u0435\u043D\u044C \u0445\u043B\u0435\u0441\u0442\u0430\u043B,
      \u043D\u043E \u043E\u0442\u0440\u044F\u0434 \u0448\u0435\u043B. \u0412\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u043E\u0434\u0438\u043D \u0438\u0437 \u0431\u043E\u0439\u0446\u043E\u0432
      \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0441\u044F \u0432 \u044F\u043C\u0443
      \u2014 \u044D\u0442\u043E \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0432\u0445\u043E\u0434 \u0432 \u0437\u0435\u043C\u043B\u044F\u043D\u043A\u0443,
      \u0433\u0434\u0435 \u0443\u043A\u0440\u044B\u0432\u0430\u043B\u0438\u0441\u044C
      \u0434\u0432\u043E\u0435 \u0432\u0430\u0448\u0438\u0445 \u043B\u0435\u0442\u0447\u0438\u043A\u043E\u0432
      \u0441\u0431\u0438\u0442\u043E\u0433\u043E \u0441\u0430\u043C\u043E\u043B\u0435\u0442\u0430.
      \u041E\u043D\u0438 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0438\u0441\u044C
      \u043A \u0432\u0430\u043C, \u043F\u043E\u0434\u0435\u043B\u0438\u043B\u0438\u0441\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438 \u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0435\u0439
      \u043E \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u043E\u0439 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 "
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514246
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u0431\u044B\u043B\u0430 \u0442\u044F\u0436\u0435\u043B\u0430:
      \u0441\u043E\u043B\u0434\u0430\u0442\u044B \u0447\u0430\u0441\u0442\u043E \u043F\u0430\u0434\u0430\u043B\u0438.
      \u0412\u044B \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u043B\u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442,
      \u043D\u043E \u043F\u043E \u043F\u0443\u0442\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514247
    m_Localized: "\u041F\u043E\u0438\u0441\u043A \u043D\u043E\u0432\u043E\u0433\u043E
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u0441\u044F,
      \u043D\u043E \u0432 \u0438\u0442\u043E\u0433\u0435 \u0432\u044B \u0432\u044B\u0448\u043B\u0438
      \u043D\u0430 \u043D\u0443\u0436\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514248
    m_Localized: "\u0412 \u043F\u043E\u0438\u0441\u043A\u0430\u0445 \u043E\u0431\u0445\u043E\u0434\u0430
      \u0432\u044B \u0437\u0430\u0431\u0440\u0435\u043B\u0438 \u0432 \u043D\u0438\u0437\u0438\u043D\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0440\u0430\u0437\u043C\u044B\u043B\u043E
      \u0442\u0430\u043A, \u0447\u0442\u043E \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043A\u0430\u0440\u0430\u0431\u043A\u0430\u0442\u044C\u0441\u044F \u043F\u043E
      \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u0438\u043C \u0441\u043A\u043B\u043E\u043D\u0430\u043C.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u0431\u043E\u0439\u0446\u043E\u0432
      \u0441\u043E\u0440\u0432\u0430\u043B\u0441\u044F \u0438 \u043F\u043E\u0432\u0440\u0435\u0434\u0438\u043B
      \u043D\u043E\u0433\u0443. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043D\u0435\u0441\u0442\u0438 \u0435\u0433\u043E \u043D\u0430 \u0441\u0435\u0431\u0435,
      \u043F\u043E\u0442\u0435\u0440\u044F\u0432 \u0435\u0449\u0435 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438. \u0414\u043E\u0436\u0434\u044C
      \u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F, \u043D\u043E \u0432\u0430\u0448
      \u043E\u0442\u0440\u044F\u0434 \u0438\u0441\u0442\u043E\u0449\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514249
    m_Localized: "\u041A\u043E\u0441\u0442\u0435\u0440 \u0441\u043E\u0433\u0440\u0435\u043B
      \u0441\u043E\u043B\u0434\u0430\u0442, \u043D\u043E \u0435\u0433\u043E \u0442\u043E\u0447\u043D\u043E
      \u043A\u0442\u043E-\u0442\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514250
    m_Localized: "\u041A\u043E\u0441\u0442\u0435\u0440 \u0441\u043E\u0433\u0440\u0435\u043B
      \u0441\u043E\u043B\u0434\u0430\u0442, \u043D\u043E \u0435\u0433\u043E \u0442\u043E\u0447\u043D\u043E
      \u043A\u0442\u043E-\u0442\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514251
    m_Localized: "\u0411\u0435\u0437 \u043A\u043E\u0441\u0442\u0440\u0430 \u0431\u043E\u0439\u0446\u044B
      \u043C\u0435\u0440\u0437\u043B\u0438, \u043E\u0434\u0438\u043D \u043D\u0435
      \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F \u0443\u0442\u0440\u043E\u043C.
      \u0412\u0430\u0448\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0443\u0431\u0435\u0440\u0435\u0433\u043B\u043E
      \u043E\u0442\u0440\u044F\u0434 \u043E\u0442 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F,
      \u043D\u043E \u043A\u0430\u043A\u043E\u0439 \u0446\u0435\u043D\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514252
    m_Localized: "\u0411\u0435\u0437 \u043A\u043E\u0441\u0442\u0440\u0430 \u0431\u043E\u0439\u0446\u044B
      \u043C\u0435\u0440\u0437\u043B\u0438, \u043E\u0434\u0438\u043D \u043D\u0435
      \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F \u0443\u0442\u0440\u043E\u043C.
      \u0412\u0430\u0448\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0443\u0431\u0435\u0440\u0435\u0433\u043B\u043E
      \u043E\u0442\u0440\u044F\u0434 \u043E\u0442 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F,
      \u043D\u043E \u043A\u0430\u043A\u043E\u0439 \u0446\u0435\u043D\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514253
    m_Localized: "\u041A\u043E\u0441\u0442\u0435\u0440 \u0438 \u0433\u043E\u0440\u044F\u0447\u0430\u044F
      \u0435\u0434\u0430 \u043F\u043E\u043C\u043E\u0433\u043B\u0438 \u0441\u043E\u0433\u0440\u0435\u0442\u044C
      \u0431\u043E\u0439\u0446\u043E\u0432, \u0438 \u0443\u0442\u0440\u043E\u043C
      \u0432\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0438 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514254
    m_Localized: "\u041A\u043E\u0441\u0442\u0435\u0440 \u0438 \u0433\u043E\u0440\u044F\u0447\u0430\u044F
      \u0435\u0434\u0430 \u043F\u043E\u043C\u043E\u0433\u043B\u0438 \u0441\u043E\u0433\u0440\u0435\u0442\u044C
      \u0431\u043E\u0439\u0446\u043E\u0432, \u0438 \u0443\u0442\u0440\u043E\u043C
      \u0432\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0438 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514255
    m_Localized: "\u0412\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0431\u043E\u0439\u0446\u0430
      \u0443\u043C\u0438\u0440\u0430\u0442\u044C \u043E\u0442 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0438.
      \u041E\u0442\u043E\u0439\u0434\u044F \u043D\u0430 \u043F\u0440\u0438\u043B\u0438\u0447\u043D\u043E\u0435
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435, \u0432\u044B
      \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B.
      \u0411\u043E\u0439\u0446\u044B \u0431\u044B\u043B\u0438 \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B
      \u0432\u0430\u0448\u0438\u043C \u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514256
    m_Localized: "\u0412\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0431\u043E\u0439\u0446\u0430
      \u0443\u043C\u0438\u0440\u0430\u0442\u044C \u043E\u0442 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0438.
      \u041E\u0442\u043E\u0439\u0434\u044F \u043D\u0430 \u043F\u0440\u0438\u043B\u0438\u0447\u043D\u043E\u0435
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435, \u0432\u044B
      \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B.
      \u0411\u043E\u0439\u0446\u044B \u0431\u044B\u043B\u0438 \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B
      \u0432\u0430\u0448\u0438\u043C \u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514257
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442\u044B \u043D\u0430\u0448\u043B\u0438
      \u043D\u0443\u0436\u043D\u043E\u0435 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u043F\u043E \u0441\u043E\u0432\u0435\u0442\u0443 \u0431\u043E\u0439\u0446\u0430,
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044E\u0449\u0435\u0433\u043E\u0441\u044F
      \u0432 \u0442\u0440\u0430\u0432\u0430\u0445. \u041E\u043D \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B
      \u043D\u0430\u0441\u0442\u043E\u0439\u043A\u0443, \u0438 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0434\u0435\u043D\u044C \u0431\u043E\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0448\u0435\u043B
      \u043D\u0430 \u043F\u043E\u043F\u0440\u0430\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514258
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442\u044B \u043D\u0430\u0448\u043B\u0438
      \u043D\u0443\u0436\u043D\u043E\u0435 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u043F\u043E \u0441\u043E\u0432\u0435\u0442\u0443 \u0431\u043E\u0439\u0446\u0430,
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044E\u0449\u0435\u0433\u043E\u0441\u044F
      \u0432 \u0442\u0440\u0430\u0432\u0430\u0445. \u041E\u043D \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B
      \u043D\u0430\u0441\u0442\u043E\u0439\u043A\u0443, \u0438 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0434\u0435\u043D\u044C \u0431\u043E\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0448\u0435\u043B
      \u043D\u0430 \u043F\u043E\u043F\u0440\u0430\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514259
    m_Localized: "\u0411\u043E\u0435\u0446 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
