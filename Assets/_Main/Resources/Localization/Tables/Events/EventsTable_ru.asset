  m_TableData:
  - m_Id: 1730823741440
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u043D\u0430\u0442\u044B\u043A\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043C\u0438\u043D\u043D\u043E\u0435 \u043F\u043E\u043B\u0435.
      \u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0432\u0448\u0438\u0441\u044C,
      \u0432\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435, \u0447\u0442\u043E
      \u043B\u044E\u0431\u043E\u0435 \u043D\u0435\u0432\u0435\u0440\u043D\u043E\u0435
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0441\u0442\u043E\u0438\u0442\u044C \u0436\u0438\u0437\u043D\u0438 \u043A\u0430\u0436\u0434\u043E\u043C\u0443
      \u0431\u043E\u0439\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730895044608
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u0441\u043E\u043B\u0434\u0430\u0442
      \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442 \u043D\u0435\u043C\u0435\u0446\u043A\u0443\u044E
      \u0434\u0435\u0432\u043E\u0447\u043A\u0443 \u043B\u0435\u0442 \u0434\u0435\u0441\u044F\u0442\u0438,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F, \u0443\u0432\u0438\u0434\u0435\u0432
      \u0432\u0430\u0448 \u043E\u0442\u0440\u044F\u0434, \u043F\u0440\u044F\u0447\u0435\u0442\u0441\u044F
      \u0437\u0430 \u0434\u0435\u0440\u0435\u0432\u043E\u043C. \u0411\u043E\u0435\u0446
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043A \u043D\u0435\u0439
      \u0438, \u0432\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0441\u044C, \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043E\u043D\u0430 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430\u0441\u044C
      \u0438 \u0435\u0435 \u0434\u0435\u0440\u0435\u0432\u043D\u044F \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0435\u043A\u0443.
      \u041E\u043D \u043F\u0440\u043E\u0441\u0438\u0442 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u0435\u0435 \u043E\u0431\u0440\u0430\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238912
    m_Localized: "\u041D\u0430 \u043F\u0443\u0442\u0438 \u0432\u044B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442\u0435
      \u0440\u0435\u043A\u0443 \u0441 \u0431\u044B\u0441\u0442\u0440\u044B\u043C
      \u0442\u0435\u0447\u0435\u043D\u0438\u0435\u043C, \u0447\u0435\u0440\u0435\u0437
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043B\u0435\u0436\u0438\u0442 \u0443\u0437\u043A\u0438\u0439
      \u043C\u043E\u0441\u0442 \u0438\u0437 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u0431\u0440\u0435\u0432\u043D\u0430. \u041F\u0435\u0440\u0435\u0441\u0435\u0447\u044C
      \u0435\u0433\u043E \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u043E\u043F\u0430\u0441\u043D\u044B\u043C,
      \u043D\u043E \u044D\u0442\u043E \u0441\u0430\u043C\u044B\u0439 \u0431\u044B\u0441\u0442\u0440\u044B\u0439
      \u043F\u0443\u0442\u044C \u0432\u043F\u0435\u0440\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238913
    m_Localized: "\u0412\u0430\u0448\u0438 \u0441\u043E\u043B\u0434\u0430\u0442\u044B
      \u043D\u0430\u0442\u044B\u043A\u0430\u044E\u0442\u0441\u044F \u043D\u0430 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u043B\u0435\u0441\u0430, \u043F\u043E\u043A\u0440\u044B\u0442\u044B\u0439
      \u0433\u0440\u0438\u0431\u0430\u043C\u0438 \u0438 \u044F\u0433\u043E\u0434\u0430\u043C\u0438.
      \u042D\u0442\u043E \u0448\u0430\u043D\u0441 \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B, \u043D\u043E \u0435\u0441\u0442\u044C
      \u0440\u0438\u0441\u043A \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238914
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442
      \u043D\u0435\u043C\u0435\u0446\u043A\u0443\u044E \u0434\u0435\u0440\u0435\u0432\u043D\u044E.
      \u041E\u043A\u043E\u043B\u043E \u043D\u0435\u0435 \u0442\u0438\u0445\u043E,
      \u043D\u043E \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
      \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043B\u0438 \u0442\u0430\u043C
      \u043D\u0435\u043C\u0446\u044B. \u042D\u0442\u043E \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u043F\u0438\u0449\u0438 \u0438
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432, \u043D\u043E \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430\u044F
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238915
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u0432\u0430\u0448\u0438\u0445
      \u0441\u043E\u043B\u0434\u0430\u0442 \u043E\u0447\u0435\u043D\u044C \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u0435\u0442
      \u0443\u0436\u0435 \u043F\u0430\u0440\u0443 \u0434\u043D\u0435\u0439, \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
      \u0434\u0435\u0440\u0436\u0438\u0442 \u043E\u0440\u0443\u0436\u0438\u0435 \u043D\u0430
      \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043A\u0435. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u0435\u0433\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u0434\u0435\u0436\u0443\u0440\u0438\u0442\u044C
      \u043D\u043E\u0447\u044C\u044E \u0432 \u0434\u043E\u0437\u043E\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238916
    m_Localized: "\u0421\u0438\u043B\u044C\u043D\u044B\u0439 \u0434\u043E\u0436\u0434\u044C
      \u043B\u044C\u0435\u0442 \u0431\u0435\u0437 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438,
      \u0438 \u0442\u0440\u043E\u043F\u0430 \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438
      \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0432
      \u0432\u044F\u0437\u043A\u0443\u044E \u043D\u0435\u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043C\u0443\u044E
      \u0433\u0440\u044F\u0437\u044C, \u0437\u0430\u0442\u0440\u0443\u0434\u043D\u044F\u044E\u0449\u0443\u044E
      \u043A\u0430\u0436\u0434\u043E\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238917
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u0443\u0434\u0430\u0440\u044F\u0435\u0442 \u0440\u0435\u0437\u043A\u0438\u0439
      \u0445\u043E\u043B\u043E\u0434, \u0432\u0430\u0448\u0438 \u0431\u043E\u0439\u0446\u044B
      \u0434\u0440\u043E\u0436\u0430\u0442 \u043E\u0442 \u0445\u043E\u043B\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238918
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u0432\u0430\u0448\u0438\u0445
      \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u0439 \u0441\u0438\u043B\u044C\u043D\u043E
      \u0437\u0430\u0431\u043E\u043B\u0435\u0432\u0430\u0435\u0442, \u0435\u0433\u043E
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u0438\u0442\u044C.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u0441\u043E\u043B\u0434\u0430\u0442
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u043E\u043D
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u0432 \u0442\u0440\u0430\u0432\u0430\u0445,
      \u043D\u043E \u0438\u0445 \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238919
    m_Localized: "\u0413\u0443\u0441\u0442\u043E\u0439 \u0442\u0443\u043C\u0430\u043D
      \u043E\u043A\u0443\u0442\u044B\u0432\u0430\u0435\u0442 \u043B\u0435\u0441,
      \u0438 \u0432\u0441\u043A\u043E\u0440\u0435 \u0432\u044B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442\u0435,
      \u0447\u0442\u043E \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u043B\u0434\u0430\u0442
      \u0438\u0437 \u043E\u0442\u0440\u044F\u0434\u0430 \u043F\u0440\u043E\u043F\u0430\u043B\u0438
      \u0438\u0437 \u0432\u0438\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238920
    m_Localized: "\u0412\u044B \u043D\u0430\u0442\u044B\u043A\u0430\u0435\u0442\u0435\u0441\u044C
      \u043D\u0430 \u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0439 \u0441\u043A\u043B\u0430\u0434
      \u0441 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438,
      \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u0431\u0435\u0437
      \u043E\u0445\u0440\u0430\u043D\u044B. \u041E\u0434\u0438\u043D \u0438\u0437
      \u0441\u043E\u043B\u0434\u0430\u0442 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0440\u0430\u0441\u0442\u044F\u0436\u043A\u0438,
      \u0442\u0430\u043A \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0438\u043C \u043F\u0440\u043E\u0449\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u0434\u0430\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238921
    m_Localized: "\u041E\u043A\u0430\u0437\u0430\u0432\u0448\u0438\u0441\u044C \u0431\u0435\u0437
      \u043A\u0430\u0440\u0442 \u0438 \u043A\u043E\u043C\u043F\u0430\u0441\u043E\u0432
      \u0434\u043E\u043B\u0433\u043E\u0435 \u0432\u0440\u0435\u043C\u044F, \u0432\u0430\u0448\u0438
      \u0441\u043E\u043B\u0434\u0430\u0442\u044B \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u0441\u043F\u043E\u0440\u0438\u0442\u044C \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u043E\u0439,
      \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
      \u0432\u0430\u0448\u0435 \u043C\u0435\u0441\u0442\u043E\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238922
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u0441\u043E\u043B\u0434\u0430\u0442
      \u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442\u0441\u044F \u0438 \u043B\u043E\u043C\u0430\u0435\u0442
      \u043D\u043E\u0433\u0443. \u0418\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435
      \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
      \u043E\u043D \u043D\u0435 \u043C\u043E\u0436\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238923
    m_Localized: "\u0412\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u043F\u0435\u0440\u0435\u0434
      \u0432\u0430\u043C\u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0431\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u0430\u044F \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C.
      \u041E\u0434\u0438\u043D \u043D\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u0448\u0430\u0433
      \u2014 \u0438 \u043C\u043E\u0436\u043D\u043E \u0443\u0432\u044F\u0437\u043D\u0443\u0442\u044C
      \u0438\u043B\u0438 \u0434\u0430\u0436\u0435 \u0443\u0442\u043E\u043D\u0443\u0442\u044C
      \u0432 \u0442\u0440\u044F\u0441\u0438\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238924
    m_Localized: "\u0412\u0434\u0430\u043B\u0435\u043A\u0435 \u0432\u044B \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442\u0435
      \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0438\u0439 \u043B\u0430\u0433\u0435\u0440\u044C,
      \u043F\u043E\u043B\u043D\u044B\u0439 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u0438 \u0441\u043E\u043B\u0434\u0430\u0442. \u042D\u0442\u043E \u0448\u0430\u043D\u0441
      \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u044B,
      \u043D\u043E \u0440\u0438\u0441\u043A \u0432\u0435\u043B\u0438\u043A: \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432
      \u043C\u043D\u043E\u0433\u043E, \u0438 \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0435
      \u043C\u043E\u0436\u0435\u0442 \u043E\u0431\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238925
    m_Localized: "\u041D\u0430\u0434 \u043B\u0435\u0441\u043E\u043C \u043F\u0440\u043E\u043D\u043E\u0441\u044F\u0442\u0441\u044F
      \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0438\u0435 \u0441\u0430\u043C\u043E\u043B\u0435\u0442\u044B,
      \u0438 \u0432\u0441\u043A\u043E\u0440\u0435 \u0441\u043B\u044B\u0448\u043D\u044B
      \u0437\u0432\u0443\u043A\u0438 \u0431\u043E\u043C\u0431\u0430\u0440\u0434\u0438\u0440\u043E\u0432\u043A\u0438.
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043E\u043D\u0438 \u0446\u0435\u043B\u044F\u0442\u0441\u044F
      \u043D\u0435 \u0432 \u0432\u0430\u0441, \u0438 \u0441\u043D\u0430\u0440\u044F\u0434\u044B
      \u043F\u0440\u043E\u0439\u0434\u0443\u0442 \u043C\u0438\u043C\u043E... "
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238926
    m_Localized: "\u0412\u0434\u0430\u043B\u0435\u043A\u0435 \u0440\u0430\u0437\u0434\u0430\u0435\u0442\u0441\u044F
      \u043B\u0430\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0431\u044B\u0441\u0442\u0440\u043E
      \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442\u0441\u044F. \u0424\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0438\u0435
      \u0441\u043E\u0431\u0430\u043A\u0438 \u0432\u043E\u0442-\u0432\u043E\u0442
      \u043D\u0430\u0441\u0442\u0438\u0433\u043D\u0443\u0442 \u0432\u0430\u0448 \u043E\u0442\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238927
    m_Localized: "\u0412\u044B \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442\u0435
      \u043F\u043E\u0436\u0430\u0440 \u0432 \u043B\u0435\u0441\u0443. \u041F\u043B\u0430\u043C\u044F
      \u0435\u0449\u0435 \u0434\u0430\u043B\u0435\u043A\u043E, \u043D\u043E \u0441\u0443\u0445\u0438\u0435
      \u0434\u0435\u0440\u0435\u0432\u044C\u044F \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0441\u0442\u0440\u043E
      \u0437\u0430\u0433\u043E\u0440\u0435\u0442\u044C\u0441\u044F, \u043E\u0442\u0440\u0435\u0437\u0430\u044F
      \u043F\u0443\u0442\u044C \u043A \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238928
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043A \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u0438 \u0432\u0438\u0434\u0438\u0442,
      \u043A\u0430\u043A \u0444\u0430\u0448\u0438\u0441\u0442\u044B \u043F\u043E\u0434\u0436\u0438\u0433\u0430\u044E\u0442
      \u0434\u043E\u043C. \u0418\u0437\u043D\u0443\u0442\u0440\u0438 \u0441\u043B\u044B\u0448\u043D\u044B
      \u043A\u0440\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238929
    m_Localized: "\u0412 \u043B\u0435\u0441\u0443 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E
      \u043D\u0430 \u0432\u0430\u0441 \u0432\u044B\u0431\u0435\u0433\u0430\u0435\u0442
      \u0433\u0440\u0443\u043F\u043F\u0430 \u0438\u0441\u043F\u0443\u0433\u0430\u043D\u043D\u044B\u0445
      \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0438\u0445, \u0441\u043F\u0430\u0441\u0430\u044E\u0449\u0438\u0445\u0441\u044F
      \u0431\u0435\u0433\u0441\u0442\u0432\u043E\u043C \u043E\u0442 \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432.
      \u041E\u043D\u0438 \u043F\u0440\u043E\u0441\u044F\u0442 \u043F\u043E\u043C\u043E\u0449\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238930
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044E
      \u0434\u0438\u043A\u0438\u0445 \u043A\u0430\u0431\u0430\u043D\u043E\u0432.
      \u041F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0432 \u0443\u0433\u0440\u043E\u0437\u0443,
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u044E\u0442
      \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u043E, \u0437\u0430\u0449\u0438\u0449\u0430\u044F
      \u0441\u0432\u043E\u0435 \u043B\u043E\u0433\u043E\u0432\u043E. \u041D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435
      \u0440\u0430\u0441\u0442\u0435\u0442, \u0438 \u043C\u0430\u043B\u0435\u0439\u0448\u0435\u0435
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0441\u043F\u0440\u043E\u0432\u043E\u0446\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0438\u0445 \u0430\u0442\u0430\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238931
    m_Localized: "\u041F\u0443\u0442\u044C \u0432\u044B\u0432\u043E\u0434\u0438\u0442
      \u0432\u0430\u0441 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443, \u0432\u0434\u043E\u043B\u044C
      \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0441\u0442\u043E\u044F\u0442 \u043A\u0440\u0435\u0441\u0442\u044B
      \u0441 \u0440\u0430\u0441\u043F\u044F\u0442\u044B\u043C\u0438 \u043B\u044E\u0434\u044C\u043C\u0438.
      \u042D\u0442\u043E \u0443\u0436\u0430\u0441\u043D\u043E\u0435 \u0437\u0440\u0435\u043B\u0438\u0449\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238932
    m_Localized: "\u0412 \u043B\u0435\u0441\u0443 \u0432\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435
      \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u0443\u044E \u0444\u0435\u0440\u043C\u0443,
      \u0433\u0434\u0435 \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E
      \u0431\u044B \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C \u0438
      \u043D\u0430\u0439\u0442\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u044B,
      \u043D\u043E \u043C\u0435\u0441\u0442\u043E \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u0437\u0430\u0441\u0430\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238933
    m_Localized: "\u0412\u044B \u043D\u0430\u0442\u044B\u043A\u0430\u0435\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0440\u0430\u043D\u0435\u043D\u043E\u0433\u043E \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u043E\u0433\u043E
      \u0441\u043E\u043B\u0434\u0430\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439,
      \u0434\u0440\u043E\u0436\u0430, \u043F\u0440\u043E\u0441\u0438\u0442 \u043F\u043E\u0449\u0430\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238934
    m_Localized: "\u0423 \u043B\u0435\u0441\u043D\u043E\u0439 \u043E\u043F\u0443\u0448\u043A\u0438
      \u0437\u0430\u0442\u0430\u0438\u043B\u0438\u0441\u044C \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0438\u0435
      \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u044B. \u0412\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u044D\u0442\u043E, \u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0438 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u043E\u0433\u043E\u043D\u044C
      \u043F\u043E \u0433\u0440\u0443\u043F\u043F\u0435 \u0431\u0435\u0433\u0443\u0449\u0438\u0445
      \u043B\u044E\u0434\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238935
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u043B\u0435\u0441
      \u043E\u043A\u0443\u0442\u044B\u0432\u0430\u0435\u0442 \u0433\u0443\u0441\u0442\u043E\u0439
      \u0442\u0443\u043C\u0430\u043D, \u0441\u043A\u0440\u044B\u0432\u0430\u044F
      \u0432\u0441\u0435 \u0432\u043E\u043A\u0440\u0443\u0433 \u0438 \u0437\u0430\u0442\u0440\u0443\u0434\u043D\u044F\u044F
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u0430\u0436\u043D\u043E \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238936
    m_Localized: "\u041D\u0430 \u043F\u0443\u0442\u0438 \u0432\u044B \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0435
      \u0433\u0440\u0443\u043F\u043F\u0443 \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0445
      \u0434\u0438\u0432\u0435\u0440\u0441\u0430\u043D\u0442\u043E\u0432, \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0432\u0448\u0438\u0445
      \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u0440\u0435\u0439\u0434
      \u043D\u0430 \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0438\u0439 \u043F\u043E\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238937
    m_Localized: "\u0412\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435
      \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u044E\u0442 \u0441\u0438\u0433\u043D\u0430\u043B\u044C\u043D\u044B\u0435
      \u0440\u0430\u043A\u0435\u0442\u044B, \u043E\u0441\u0432\u0435\u0449\u0430\u044F
      \u0432\u0441\u0435 \u0432 \u043B\u0435\u0441\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238938
    m_Localized: "\u041D\u0430 \u043F\u0443\u0442\u0438 \u0432\u044B \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0435
      \u0436\u0435\u043D\u0449\u0438\u043D\u0443 \u0441 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C
      \u0440\u0435\u0431\u0435\u043D\u043A\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0443\u043C\u043E\u043B\u044F\u0435\u0442 \u043F\u043E\u043C\u043E\u0447\u044C
      \u0435\u0439 \u0441\u043A\u0440\u044B\u0442\u044C\u0441\u044F \u043E\u0442
      \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238939
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u0432\u0430\u0448\u0438\u0445
      \u0441\u043E\u043B\u0434\u0430\u0442 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0442\u044C \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435, \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043F\u043E\u0437\u0430\u0434\u0438 \u043E\u0442\u0440\u044F\u0434\u0430 \u0438
      \u0434\u0430\u0436\u0435 \u043F\u043E\u0439\u043C\u0430\u043D \u043D\u0430
      \u043F\u043E\u043F\u044B\u0442\u043A\u0435 \u043F\u043E\u0431\u0435\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238940
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u043D\u0430\u0442\u044B\u043A\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043F\u043E\u043B\u0435 \u0441 \u043E\u0432\u0440\u0430\u0433\u043E\u043C,
      \u0443\u0441\u0435\u044F\u043D\u043D\u043E\u0435 \u0442\u0435\u043B\u0430\u043C\u0438,
      \u0441\u0440\u0435\u0434\u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043B\u0435\u0436\u0430\u0442
      \u0438 \u0438\u0445 \u043F\u0440\u0435\u0436\u043D\u0438\u0435 \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0438.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u0431\u043E\u0439\u0446\u043E\u0432
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u043E\u0442\u0434\u0430\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043F\u043E\u0447\u0435\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238941
    m_Localized: "\u0412\u044B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442\u0435
      \u0437\u0430\u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0443\u044E
      \u043F\u0430\u043B\u0430\u0442\u043A\u0443 \u0441 \u0440\u0430\u0434\u0438\u043E\u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0447\u0438\u043A\u043E\u043C.
      \u042D\u0442\u043E \u0448\u0430\u043D\u0441 \u0432\u044B\u0439\u0442\u0438
      \u043D\u0430 \u0441\u0432\u044F\u0437\u044C \u0441 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238942
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u0438\u0441\u0447\u0435\u0437\u0430\u0442\u044C \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
      \u0447\u0435\u043C \u043E\u0436\u0438\u0434\u0430\u043B\u043E\u0441\u044C.
      \u041F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u044F \u0440\u0430\u0441\u0442\u0443\u0442,
      \u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0431\u044B\u0441\u0442\u0440\u043E
      \u043D\u0430\u0439\u0442\u0438 \u0432\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043D\u0430\u0447\u043D\u0435\u0442\u0441\u044F
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442
      \u0438 \u0432\u044B \u043D\u0430\u0447\u043D\u0435\u0442\u0435 \u0433\u043E\u043B\u043E\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238943
    m_Localized: "\u0412\u0430\u0448 \u043B\u0443\u0447\u0448\u0438\u0439 \u0434\u0440\u0443\u0433
      \u0438 \u0442\u043E\u0432\u0430\u0440\u0438\u0449 \u0434\u0435\u0442\u0441\u0442\u0432\u0430
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0441\u043E\u0431\u043E\u0439, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432. \u041E\u043D \u0443\u0432\u0435\u0440\u044F\u0435\u0442,
      \u0447\u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0442 \u0434\u043E\u0433\u043D\u0430\u0442\u044C
      \u0432\u0430\u0441, \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0441\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0436\u0430\u0440\u043A\u043E \u0434\u043B\u044F \u043D\u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238944
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u0431\u043E\u0439\u0446\u043E\u0432
      \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442, \u0447\u0442\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u043A\u0440\u0435\u0441\u0442\u0438\u043A \u0441\u0432\u043E\u0435\u0439 \u043C\u0430\u0442\u0435\u0440\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0434\u043B\u044F \u043D\u0435\u0433\u043E
      \u0434\u043E\u0440\u043E\u0433. \u041E\u043D \u043F\u0440\u043E\u0441\u0438\u0442
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F \u0438
      \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238945
    m_Localized: "\u0412 \u043B\u0435\u0441\u0443 \u043E\u0442\u0440\u044F\u0434
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u043B\u0443\u0437\u0430\u0442\u043E\u043F\u043B\u0435\u043D\u043D\u044B\u0439
      \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0438\u0439 \u0442\u0430\u043D\u043A,
      \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044B\u0439 \u044D\u043A\u0438\u043F\u0430\u0436\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238946
    m_Localized: "\u041F\u0440\u0438 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0435
      \u0447\u0435\u0440\u0435\u0437 \u0440\u0435\u043A\u0443 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u043E\u0431\u0441\u0442\u0440\u0435\u043B, \u043D\u043E \u0432\u044B \u043D\u0435
      \u0432\u0438\u0434\u0438\u0442\u0435, \u043E\u0442\u043A\u0443\u0434\u0430
      \u043E\u043D \u0432\u0435\u0434\u0435\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238947
    m_Localized: "\u0412\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u0432
      \u043B\u0435\u0441\u0443 \u044F\u0449\u0438\u043A, \u0441\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439
      \u0441 \u043F\u0430\u0440\u0430\u0448\u044E\u0442\u043E\u043C, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u043B\u0435\u0436\u0430\u0442 \u043F\u043E\u0434\u0434\u0435\u043B\u044C\u043D\u044B\u0435
      \u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0435 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u0438 \u0444\u043E\u0440\u043C\u0430. \u0421\u043A\u043E\u0440\u0435\u0435
      \u0432\u0441\u0435\u0433\u043E, \u044D\u0442\u043E \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u0438
      \u0434\u0438\u0432\u0435\u0440\u0441\u0430\u043D\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238948
    m_Localized: "\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043B\u043A\u0438
      \u0441 \u0444\u0430\u0448\u0438\u0441\u0442\u0430\u043C\u0438 \u0443\u0434\u0430\u0435\u0442\u0441\u044F
      \u043F\u043B\u0435\u043D\u0438\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u0441\u043E\u043B\u0434\u0430\u0442. \u0411\u043E\u0439\u0446\u044B \u0441\u043F\u043E\u0440\u044F\u0442,
      \u0447\u0442\u043E \u0441 \u043D\u0438\u043C\u0438 \u0434\u0435\u043B\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238949
    m_Localized: "\u0412\u044B \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442\u0435
      \u0434\u0432\u0435 \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0438\u0435
      \u043C\u0430\u0448\u0438\u043D\u044B, \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0432\u0448\u0438\u0435\u0441\u044F
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435. \u0418\u0437 \u043F\u0435\u0440\u0432\u043E\u0439
      \u0432\u044B\u0445\u043E\u0434\u044F\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0441\u043E\u043B\u0434\u0430\u0442 \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u043A\u043E \u0432\u0442\u043E\u0440\u043E\u0439, \u043F\u0440\u0438\u043A\u0430\u0437\u044B\u0432\u0430\u044F
      \u043F\u043B\u0435\u043D\u043D\u044B\u043C \u0432\u044B\u0439\u0442\u0438.
      \u0412 \u044D\u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442 \u0432\u044B
      \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435: \u0435\u0449\u0435
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0439
      \u2014 \u0438 \u043F\u043B\u0435\u043D\u043D\u0438\u043A\u043E\u0432 \u0440\u0430\u0441\u0441\u0442\u0440\u0435\u043B\u044F\u044E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238950
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437
      \u043C\u0438\u043D\u043D\u043E\u0435 \u043F\u043E\u043B\u0435, \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E
      \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044F \u0448\u0430\u0433\u0438 \u0434\u0440\u0443\u0433
      \u0437\u0430 \u0434\u0440\u0443\u0433\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238951
    m_Localized: "\u041F\u043E\u0439\u0442\u0438 \u0432 \u043E\u0431\u0445\u043E\u0434
      \u043C\u0438\u043D\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u044F, \u0445\u043E\u0442\u044F
      \u044D\u0442\u043E \u0438 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0442
      \u0432\u0430\u0441, \u043D\u043E \u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u0436\u0438\u0437\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238952
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0444\u0443\u0433\u0430\u0441\u043D\u044B\u0435
      \u0433\u0440\u0430\u043D\u0430\u0442\u044B, \u0447\u0442\u043E\u0431\u044B
      \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043C\u0438\u043D\u044B
      \u043D\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u043C \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238953
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0434\u0435\u0432\u043E\u0447\u043A\u0443,
      \u0440\u0435\u0448\u0438\u0432 \u043D\u0435 \u0443\u0441\u043B\u043E\u0436\u043D\u044F\u0442\u044C
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044E \u043B\u0438\u0448\u043D\u0438\u043C\u0438
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238954
    m_Localized: "\u0423\u0431\u0438\u0442\u044C \u0434\u0435\u0432\u043E\u0447\u043A\u0443
      \u2014 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u043E,
      \u0447\u0442\u043E \u0435\u0441\u043B\u0438 \u0435\u0451 \u043D\u0430\u0439\u0434\u0451\u0442
      \u043F\u0430\u0442\u0440\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238955
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C \u0431\u043E\u0439\u0446\u0443
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u0434\u0435\u0432\u043E\u0447\u043A\u0443
      \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u044E, \u0434\u0430\u0436\u0435
      \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u043E\u0439\u043D\u044B
      \u043D\u0430\u0434\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C
      \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238956
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043F\u0435\u0440\u0435\u043F\u043B\u044B\u0442\u044C
      \u0440\u0435\u043A\u0443, \u0431\u043E\u0440\u044F\u0441\u044C \u0441 \u0431\u044B\u0441\u0442\u0440\u044B\u043C
      \u0442\u0435\u0447\u0435\u043D\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238957
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043F\u043E \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u043E\u043C\u0443
      \u0431\u0440\u0435\u0432\u043D\u0443, \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E
      \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u044F\u0441\u044C \u0434\u0440\u0443\u0433
      \u0437\u0430 \u0434\u0440\u0443\u0433\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238958
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u0432\u0434\u043E\u043B\u044C \u0440\u0435\u043A\u0438 \u0432 \u043F\u043E\u0438\u0441\u043A\u0430\u0445
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E \u043C\u0435\u0441\u0442\u0430
      \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B \u0434\u043B\u044F
      \u0432\u0441\u0435\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238959
    m_Localized: "\u041E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u0442\u044C
      \u0441\u0431\u043E\u0440 \u044F\u0433\u043E\u0434 \u0438 \u0433\u0440\u0438\u0431\u043E\u0432,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B, \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0435
      \u0434\u043B\u044F \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238960
    m_Localized: "\u0418\u0437\u0431\u0435\u0433\u0430\u0442\u044C \u0441\u0431\u043E\u0440\u0430
      \u044F\u0433\u043E\u0434 \u0438 \u0433\u0440\u0438\u0431\u043E\u0432, \u043E\u043F\u0430\u0441\u0430\u044F\u0441\u044C
      \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238961
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u044F\u0433\u043E\u0434\u044B
      \u0438 \u0433\u0440\u0438\u0431\u044B, \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0432
      \u0438\u0445 \u043D\u0430 \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u0446\u0435
      \u0438\u0437 \u043E\u0442\u0440\u044F\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238962
    m_Localized: "\u0414\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u043D\u043E\u0447\u0438
      \u0438 \u043F\u0440\u043E\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0435\u0440\u0435\u0432\u043D\u044E \u043F\u043E\u043F\u0443\u0442\u043D\u043E
      \u0441\u043E\u0431\u0438\u0440\u0430\u044F \u043F\u0440\u0438\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238963
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0434\u0435\u0440\u0435\u0432\u043D\u044E,
      \u0438\u0437\u0431\u0435\u0433\u0430\u044F \u0440\u0438\u0441\u043A\u0430 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u044F
      \u0441 \u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u0436\u0438\u0442\u0435\u043B\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238964
    m_Localized: "\u041F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0438 \u0431\u044B\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u044B\u043C\u0438
      \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C\u0441\u044F, \u0435\u0441\u043B\u0438
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u0435 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238965
    m_Localized: "\u0417\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u0431\u043E\u0439\u0446\u0430,
      \u0434\u0430\u0432 \u0435\u043C\u0443 \u0448\u0430\u043D\u0441 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C
      \u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0441\u0438\u043B\u044B "
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238966
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043D\u0435\u0440\u0432\u043D\u043E\u0433\u043E
      \u0441\u043E\u043B\u0434\u0430\u0442\u0430 \u043D\u0430 \u043F\u043E\u0441\u0442\u0443
      \u2014 \u0435\u0433\u043E \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      \u043C\u043E\u0436\u0435\u0442 \u0441\u043F\u0430\u0441\u0442\u0438 \u0432\u0435\u0441\u044C
      \u043E\u0442\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238967
    m_Localized: "\u0418\u0437\u044A\u044F\u0442\u044C \u043E\u0440\u0443\u0436\u0438\u0435
      \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439, \u0435\u0441\u043B\u0438
      \u0441\u043E\u043B\u0434\u0430\u0442 \u0432\u044B\u0434\u0430\u0441\u0442 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      \u043E\u0442\u0440\u044F\u0434\u0430 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u043C
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238968
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C\u0441\u044F \u043E\u0442 \u0434\u043E\u0436\u0434\u044F
      \u0438 \u0432\u044B\u0436\u0434\u0430\u0442\u044C \u0432\u0440\u0435\u043C\u044F,
      \u043F\u043E\u043A\u0430 \u043E\u043D \u0443\u0442\u0438\u0445\u043D\u0435\u0442,
      \u0430 \u043F\u043E\u0442\u043E\u043C \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238969
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0438\u0434\u0442\u0438,
      \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0433\u0440\u044F\u0437\u044C
      \u0438 \u0445\u043E\u043B\u043E\u0434, \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044F
      \u0442\u0435\u043C\u043F \u043E\u0442\u0440\u044F\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238970
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439
      \u043F\u0443\u0442\u044C, \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0430\u0442\u044C
      \u0431\u043E\u0439\u0446\u043E\u0432 \u0438\u0437\u043B\u0438\u0448\u043D\u0438\u043C
      \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u044F\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238971
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0441\u0442\u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u043A\u043E\u0441\u0442\u0451\u0440, \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0433\u0440\u0435\u0442\u044C\u0441\u044F,
      \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0432\u0441\u0435
      \u0440\u0438\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238972
    m_Localized: "\u0423\u0442\u0435\u043F\u043B\u0438\u0442\u044C \u043C\u0435\u0441\u0442\u043E
      \u0434\u043B\u044F \u043D\u043E\u0447\u043B\u0435\u0433\u0430 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u0441\u0443\u0445\u0438\u0445 \u043B\u0438\u0441\u0442\u044C\u0435\u0432,
      \u0435\u043B\u043E\u0432\u044B\u0445 \u0432\u0435\u0442\u043E\u043A \u0438
      \u0434\u0440\u0443\u0433\u0438\u0445 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238973
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0441\u0442\u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u043A\u043E\u0441\u0442\u0451\u0440 \u0438 \u043F\u043B\u043E\u0442\u043D\u043E
      \u043F\u043E\u0435\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238974
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0431\u043E\u043B\u044C\u043D\u043E\u0433\u043E
      \u0431\u043E\u0439\u0446\u0430, \u043F\u043E\u043D\u0438\u043C\u0430\u044F,
      \u0447\u0442\u043E \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0430 \u0443\u0433\u0440\u043E\u0436\u0430\u0435\u0442
      \u0432\u0441\u0435\u0439 \u0433\u0440\u0443\u043F\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238975
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0441\u043E\u043B\u0434\u0430\u0442
      \u043D\u0430 \u043F\u043E\u0438\u0441\u043A\u0438 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238976
    m_Localized: "\u0421\u043C\u0430\u0441\u0442\u0435\u0440\u0438\u0442\u044C \u0434\u043B\u044F
      \u043D\u0435\u0433\u043E \u043D\u043E\u0441\u0438\u043B\u043A\u0438 \u0438
      \u0432\u0437\u044F\u0442\u044C \u0441 \u0441\u043E\u0431\u043E\u0439, \u043D\u0430\u0434\u0435\u044F\u0441\u044C,
      \u0447\u0442\u043E \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
      \u0435\u0433\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238977
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0438 \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043F\u0440\u0438\u0432\u0430\u043B
      \u0434\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430 \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u0445
      \u0441\u043E\u043B\u0434\u0430\u0442, \u043D\u0435 \u043E\u0442\u0445\u043E\u0434\u044F
      \u043E\u0442 \u043F\u0440\u0438\u0432\u0430\u043B\u0430 \u0434\u0430\u043B\u0435\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238978
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C,
      \u043E\u0441\u043E\u0437\u043D\u0430\u0432\u0430\u044F, \u0447\u0442\u043E
      \u043E\u0442\u0440\u044F\u0434 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
      \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C \u0441\u0435\u0431\u0435
      \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238979
    m_Localized: "\u041A\u0440\u0438\u0447\u0430\u0442\u044C, \u0438 \u0437\u0432\u0430\u0442\u044C
      \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u0439, \u0438 \u0435\u0441\u043B\u0438
      \u044D\u0442\u043E \u043D\u0435 \u0434\u0430\u0441\u0442 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432,
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u044C \u043F\u0430\u0440\u0443
      \u0440\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238980
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0440\u0430\u0441\u0442\u044F\u0436\u043A\u0438
      \u0438 \u043E\u0442\u043E\u0439\u0442\u0438, \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0432
      \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0439 \u0441\u044E\u0440\u043F\u0440\u0438\u0437
      \u0434\u043B\u044F \u0432\u0440\u0430\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238981
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0441\u043A\u043B\u0430\u0434,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u044C
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u0438 \u043D\u0435 \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C\u044E
      \u043E\u0442\u0440\u044F\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238982
    m_Localized: "\u0423\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0437\u0430\u0441\u0430\u0434\u0443,
      \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0432 \u0441\u043A\u043B\u0430\u0434
      \u043A \u043E\u0431\u043E\u0440\u043E\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238983
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C
      \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043F\u043E
      \u043E\u0434\u043D\u043E\u043C\u0443 \u0441\u043E\u043B\u0434\u0430\u0442\u0443
      \u043D\u0430 \u0440\u0430\u0437\u043D\u044B\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
      \u0434\u043B\u044F \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0438 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238984
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u043D\u0430\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u043C\u0443 \u043F\u0443\u0442\u0438,
      \u0434\u0435\u0440\u0436\u0430\u0441\u044C \u0432\u043C\u0435\u0441\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238985
    m_Localized: "\u041F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F \u043D\u0430
      \u0432\u043E\u0437\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u0438\u043B\u0438 \u0434\u0435\u0440\u0435\u0432\u043E \u0434\u043B\u044F
      \u043F\u043E\u0438\u0441\u043A\u0430 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238986
    m_Localized: "\u0421\u043C\u0430\u0441\u0442\u0435\u0440\u0438\u0442\u044C \u0434\u043B\u044F
      \u043D\u0435\u0433\u043E \u0448\u0438\u043D\u044B \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238987
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
      \u0431\u0435\u0437 \u043D\u0435\u0433\u043E \u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0435\u043C\u0443 \u043F\u0440\u0438\u043F\u0430\u0441\u044B, \u043C\u044B
      \u043D\u0435 \u043C\u043E\u0436\u0435\u043C \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238988
    m_Localized: "\u0417\u0430\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u044C \u0431\u043E\u0439\u0446\u0430,
      \u043B\u0443\u0447\u0448\u0435 \u043C\u044B - \u0447\u0435\u043C \u0432 \u043F\u043B\u0435\u043D
      \u043A \u043D\u0435\u043C\u0446\u0430\u043C, \u0430 \u0442\u0430\u043A\u0436\u0435
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u043D\u0430\u043C \u043D\u0443\u0436\u043D\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238989
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439
      \u043F\u0443\u0442\u044C, \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C
      \u0436\u0438\u0437\u043D\u044F\u043C\u0438 \u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438
      \u0432 \u0431\u043E\u043B\u043E\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238990
    m_Localized: "\u0420\u0438\u0441\u043A\u043D\u0443\u0442\u044C \u0438 \u043F\u0440\u043E\u0439\u0442\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0431\u043E\u043B\u043E\u0442\u043E, \u0441\u043B\u0435\u0434\u044F
      \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u043C \u0448\u0430\u0433\u043E\u043C,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0443\u0432\u044F\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238991
    m_Localized: "\u0421\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432, \u0441\u0432\u044F\u0437\u0430\u0442\u044C
      \u0438\u0437 \u0442\u043A\u0430\u043D\u0438 \u0432\u0435\u0440\u0451\u0432\u043A\u0443
      \u0438 \u043E\u0431\u043C\u043E\u0442\u0430\u0442\u044C \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0431\u043E\u0439\u0446\u0430, \u0434\u0432\u0438\u0433\u0430\u044F\u0441\u044C
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0438 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238992
    m_Localized: "\u0414\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u043D\u043E\u0447\u0438,
      \u0443\u043A\u0440\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0438 \u043E\u0442\u043E\u0439\u0442\u0438 \u043F\u043E\u0434 \u043F\u043E\u043A\u0440\u043E\u0432\u043E\u043C
      \u0442\u0435\u043C\u043D\u043E\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238993
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0430\u0442\u044C \u043E\u0442\u0440\u044F\u0434
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238994
    m_Localized: "\u0414\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u043D\u043E\u0447\u0438
      \u0438 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C,
      \u0437\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044F \u043F\u0440\u0438\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238995
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0443\u043A\u0440\u044B\u0442\u0438\u0435
      \u0432 \u043B\u0435\u0441\u0443, \u0441\u043F\u0430\u0441\u0430\u044F\u0441\u044C
      \u043E\u0442 \u0431\u043E\u043C\u0431\u0430\u0440\u0434\u0438\u0440\u043E\u0432\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238996
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
      \u0434\u0435\u0440\u0436\u0430\u0441\u044C \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438
      \u0434\u0440\u0443\u0433 \u043E\u0442 \u0434\u0440\u0443\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238997
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043E\u0433\u043E\u043D\u044C
      \u043F\u043E \u0432\u0440\u0430\u0433\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238998
    m_Localized: "\u0417\u0430\u043D\u044F\u0442\u044C \u043E\u0431\u043E\u0440\u043E\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u0438 \u043E\u0442\u0431\u0438\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899238999
    m_Localized: "\u0411\u0435\u0436\u0430\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239000
    m_Localized: "\u041F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u043E\u0434\u043D\u0438\u043C \u0431\u043E\u0439\u0446\u043E\u043C \u0440\u0430\u0434\u0438
      \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u044F \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043E\u0442\u0440\u044F\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239001
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0432\u0434\u043E\u043B\u044C
      \u043E\u0433\u043D\u044F, \u0443 \u043D\u0430\u0441 \u043D\u0435\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0435 \u043C\u0430\u043D\u0435\u0432\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239002
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0443\u043A\u0440\u044B\u0442\u0438\u0435
      \u0432 \u044F\u043C\u0430\u0445, \u0432\u043E\u0434\u043E\u0451\u043C\u0430\u0445
      \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0445
      \u043C\u0435\u0441\u0442\u0430\u0445 \u043E\u0442 \u043E\u0433\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239003
    m_Localized: "\u0414\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043E\u0442 \u0432\u0435\u0442\u0440\u0430, \u043E\u0431\u0445\u043E\u0434\u044F
      \u043E\u0433\u043E\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239004
    m_Localized: "\u041E\u0431\u044B\u0441\u043A\u0430\u0442\u044C \u0434\u0440\u0443\u0433\u0438\u0435
      \u0434\u043E\u043C\u0430 \u0434\u043B\u044F \u043F\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239005
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u044D\u0442\u043E \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0435
      \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u0435, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0430\u0442\u044C \u043E\u0442\u0440\u044F\u0434
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239006
    m_Localized: "\u0423\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432
      \u0438 \u0441\u043F\u0430\u0441\u0442\u0438 \u043B\u044E\u0434\u0435\u0439,
      \u043D\u0435 \u0442\u0435\u0440\u044F\u044F \u0432\u0440\u0435\u043C\u0435\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239007
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0438\u0445
      \u0441 \u0441\u043E\u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239008
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0438\u0445,
      \u043F\u043E\u043D\u0438\u043C\u0430\u044F, \u0447\u0442\u043E \u0432\u0430\u043C
      \u043D\u0435 \u043D\u0443\u0436\u043D\u044B \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239009
    m_Localized: "\u041F\u043E\u0434\u0435\u043B\u0438\u0442\u0441\u044F \u0441 \u043D\u0438\u043C\u0438
      \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438 \u0438 \u0443\u043A\u0430\u0437\u0430\u0442\u044C
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239010
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u043E\u0442\u043F\u0443\u0433\u043D\u0443\u0442\u044C \u043A\u0430\u0431\u0430\u043D\u043E\u0432
      \u0433\u0440\u043E\u043C\u043A\u0438\u043C\u0438 \u0437\u0432\u0443\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239011
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C
      \u043D\u0430\u0437\u0430\u0434, \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u0432
      \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239012
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043E\u0433\u043E\u043D\u044C
      \u043F\u043E \u043A\u0430\u0431\u0430\u043D\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239013
    m_Localized: "\u0421\u043D\u044F\u0442\u044C \u043B\u044E\u0434\u0435\u0439 \u0441
      \u043A\u0440\u0435\u0441\u0442\u043E\u0432 \u0438 \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u0438\u0442\u044C,
      \u043E\u0442\u0434\u0430\u0432 \u0438\u043C \u0434\u0430\u043D\u044C \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239014
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E
      \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439, \u043E\u043F\u0430\u0441\u0430\u044F\u0441\u044C
      \u0437\u0430\u0441\u0430\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239015
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C,
      \u0430 \u0437\u0430\u0442\u0435\u043C \u0441\u043D\u044F\u0442\u044C \u0441
      \u043A\u0440\u0435\u0441\u0442\u043E\u0432 \u043F\u043E\u0433\u0438\u0431\u0448\u0438\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239016
    m_Localized: "\u041E\u0431\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0444\u0435\u0440\u043C\u0443 \u0438 \u0441\u043E\u0431\u0440\u0430\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239017
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C,
      \u043D\u0435 \u0442\u0440\u0430\u0442\u044F \u0432\u0440\u0435\u043C\u044F
      \u043D\u0430 \u043E\u0441\u043C\u043E\u0442\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239018
    m_Localized: "\u041E\u043A\u0440\u0443\u0436\u0438\u0442\u044C \u0444\u0435\u0440\u043C\u0443
      \u0438 \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0441\u0442\u0435\u043C\u043D\u0435\u0435\u0442, \u0447\u0442\u043E\u0431\u044B
      \u043A \u043D\u0435\u0439 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239019
    m_Localized: "\u041E\u043A\u0430\u0437\u0430\u0442\u044C \u043F\u043E\u043C\u043E\u0449\u044C
      \u043D\u0435\u043C\u0435\u0446\u043A\u043E\u043C\u0443 \u0441\u043E\u043B\u0434\u0430\u0442\u0443,
      \u043F\u043E\u043C\u043D\u044F, \u0447\u0442\u043E \u0432\u0441\u0435 \u043C\u044B
      \u2014 \u043B\u044E\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239020
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0435\u0433\u043E
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239021
    m_Localized: "\u0423\u0431\u0438\u0442\u044C \u0435\u0433\u043E. \u041E\u0447\u0435\u043D\u044C
      \u043E\u043F\u0430\u0441\u043D\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
      \u0435\u0433\u043E \u0432 \u0436\u0438\u0432\u044B\u0445 \u0434\u043B\u044F
      \u043F\u0430\u0442\u0440\u0443\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239022
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C \u043D\u043E\u0447\u0438
      \u0438 \u0442\u0438\u0445\u043E \u043E\u0431\u043E\u0439\u0442\u0438 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239023
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043E\u0433\u043E\u043D\u044C,
      \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u043E\u0432 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u044C
      \u0441\u0432\u043E\u0438 \u043F\u043E\u0437\u0438\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239024
    m_Localized: "\u041F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u043E\u0434\u043D\u0438\u043C \u0431\u043E\u0439\u0446\u043E\u043C, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0442\u0432\u043B\u0435\u0447\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u0438 \u043F\u0440\u043E\u0439\u0442\u0438 \u043D\u0435\u0437\u0430\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239025
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C,
      \u0434\u0435\u0440\u0436\u0430\u0441\u044C \u0432\u043C\u0435\u0441\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0438\u043A\u0442\u043E \u043D\u0435
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0441\u044F \u0432 \u0442\u0443\u043C\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239026
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C, \u043F\u043E\u043A\u0430
      \u0442\u0443\u043C\u0430\u043D \u0440\u0430\u0441\u0441\u0435\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C
      \u043F\u043E\u0442\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239027
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0441\u043E\u043B\u0434\u0430\u0442\u0430
      \u043D\u0430 \u0441\u0430\u043C\u043E\u0435 \u0432\u044B\u0441\u043E\u043A\u043E\u0435
      \u0434\u0435\u0440\u0435\u0432\u043E \u0434\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239028
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C \u043F\u043E\u0441\u0442
      \u0432\u043C\u0435\u0441\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239029
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0442
      \u0440\u0435\u0439\u0434\u0430 \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239030
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u043D\u0430 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E \u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0445
      \u043F\u0430\u0442\u0440\u0443\u043B\u044F\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239031
    m_Localized: "\u0417\u0430\u043D\u044F\u0442\u044C \u043E\u0431\u043E\u0440\u043E\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u043F\u043E\u0437\u0438\u0446\u0438\u0438, \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0432
      \u043E\u0442\u0440\u044F\u0434 \u043A \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0439
      \u0443\u0433\u0440\u043E\u0437\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239032
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435,
      \u043D\u0430\u0434\u0435\u044F\u0441\u044C, \u0447\u0442\u043E \u0441\u0438\u0433\u043D\u0430\u043B\u044C\u043D\u044B\u0435
      \u0440\u0430\u043A\u0435\u0442\u044B \u043D\u0435 \u0441\u0432\u044F\u0437\u0430\u043D\u044B
      \u0441 \u043D\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239033
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0430
      \u0434\u043B\u044F \u0432\u044B\u044F\u0441\u043D\u0435\u043D\u0438\u044F \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239034
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0436\u0435\u043D\u0449\u0438\u043D\u0443
      \u0441 \u0440\u0435\u0431\u0451\u043D\u043A\u043E\u043C \u0432 \u043E\u0442\u0440\u044F\u0434
      \u0438 \u043F\u043E\u043C\u043E\u0447\u044C \u0443\u043A\u0440\u044B\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239035
    m_Localized: "\u041F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C \u0443\u0431\u0438\u0442\u044C
      \u0436\u0435\u043D\u0449\u0438\u043D\u0443, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u0432\u044B\u0434\u0430\u0442\u044C \u043E\u0442\u0440\u044F\u0434
      \u0432\u0440\u0430\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239036
    m_Localized: "\u0414\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0436\u0435\u043D\u0449\u0438\u043D\u0443
      \u043E \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0438
      \u0432\u0440\u0430\u0433\u0430, \u0430 \u0437\u0430\u0442\u0435\u043C \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239037
    m_Localized: "\u041D\u0430\u043A\u0430\u0437\u0430\u0442\u044C \u0441\u043E\u043B\u0434\u0430\u0442\u0430
      \u0437\u0430 \u043F\u043E\u043F\u044B\u0442\u043A\u0443 \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u0441\u0442\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239038
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0441\u043E\u043B\u0434\u0430\u0442\u0430
      \u0441 \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438, \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u044B
      \u043D\u0430\u043C \u043D\u0435 \u043D\u0443\u0436\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239039
    m_Localized: "\u041D\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C \u0441\u043E\u043B\u0434\u0430\u0442\u0443
      \u043E \u0434\u043E\u043B\u0433\u0435 \u043F\u0435\u0440\u0435\u0434 \u043E\u0442\u0440\u044F\u0434\u043E\u043C
      \u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0432 \u0441\u0442\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239040
    m_Localized: "\u0417\u0430\u043A\u0438\u043D\u0443\u0442\u044C \u0442\u0435\u043B\u0430
      \u0432 \u043E\u0432\u0440\u0430\u0433 \u0438 \u0437\u0430\u043A\u043E\u043F\u0430\u0442\u044C
      \u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239041
    m_Localized: "\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u044D\u0442\u043E
      \u043C\u0435\u0441\u0442\u043E, \u0443 \u043D\u0430\u0441 \u043D\u0435\u0442
      \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239042
    m_Localized: "\u0417\u0430\u043A\u043E\u043F\u0430\u0442\u044C \u0442\u0435\u043B\u0430
      \u0438 \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0443\u044E
      \u0446\u0435\u0440\u0435\u043C\u043E\u043D\u0438\u044E, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u0447\u0442\u0438\u0442\u044C \u043F\u0430\u043C\u044F\u0442\u044C
      \u043F\u0430\u0432\u0448\u0438\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239043
    m_Localized: "\u041E\u0431\u044B\u0441\u043A\u0430\u0442\u044C \u043F\u0430\u043B\u0430\u0442\u043A\u0443
      \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0440\u0430\u0434\u0438\u043E\u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0447\u0438\u043A
      \u0434\u043B\u044F \u0441\u0432\u044F\u0437\u0438 \u0441 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239044
    m_Localized: "\u041E\u0431\u044B\u0441\u043A\u0430\u0442\u044C \u043F\u0430\u043B\u0430\u0442\u043A\u0443
      \u0438 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u0440\u0430\u0434\u0438\u043E\u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0447\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239045
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u0430\u043B\u0430\u0442\u043A\u0443
      \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0447\u0438\u043A \u043D\u0435\u0442\u0440\u043E\u043D\u0443\u0442\u044B\u043C\u0438
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239046
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0432\u0435\u0449\u043C\u0435\u0448\u043A\u0438
      \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0441\u043E\u043B\u0434\u0430\u0442\u0430
      \u0438 \u0440\u0430\u0441\u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C \u0432\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239047
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u043E\u0442\u0440\u044F\u0434
      \u0438 \u043D\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C, \u0447\u0442\u043E
      \u0432\u0441\u0435 \u0432\u044B \u2014 \u043E\u0434\u043D\u043E \u0446\u0435\u043B\u043E\u0435,
      \u0438 \u0435\u0441\u043B\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0437\u0430\u043A\u043E\u043D\u0447\u0430\u0442\u0441\u044F \u0432\u0430\u043C
      \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239048
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0432\u0435\u0449\u043C\u0435\u0448\u043A\u0438
      \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0441\u043E\u043B\u0434\u0430\u0442\u0430
      \u0438 \u043F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u0432\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239049
    m_Localized: "\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044C \u0434\u0440\u0443\u0433\u0443
      \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043D\u0435\u043C\u0446\u0435\u0432,
      \u0434\u043E\u0432\u0435\u0440\u0438\u0432\u0448\u0438\u0441\u044C \u0435\u0433\u043E
      \u0441\u043C\u0435\u043B\u043E\u0441\u0442\u0438 \u0440\u0430\u0434\u0438 \u043E\u0442\u0440\u044F\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239050
    m_Localized: "\u041F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C \u0434\u0440\u0443\u0433\u0443
      \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u0441 \u043E\u0442\u0440\u044F\u0434\u043E\u043C,
      \u043D\u0435 \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u044F \u0436\u0435\u0440\u0442\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239051
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C \u0434\u0440\u0443\u0433\u0443
      \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043D\u0435\u043C\u0446\u0435\u0432,
      \u043D\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0441\u043E\u043B\u0434\u0430\u0442\u0430
      \u0441\u043B\u0435\u0434\u0438\u0442\u044C \u0437\u0430 \u043D\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239052
    m_Localized: "\u0423\u0431\u0435\u0434\u0438\u0442\u044C \u0431\u043E\u0439\u0446\u0430,
      \u0447\u0442\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0430
      \u043F\u043E\u0438\u0441\u043A\u0438 \u043D\u0435\u0442, \u0438 \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239053
    m_Localized: "\u041F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C \u043E\u0442\u0440\u044F\u0434\u0443
      \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u0438 \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u0431\u044B\u0441\u0442\u0440\u044B\u0439 \u043F\u043E\u0438\u0441\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239054
    m_Localized: "\u0414\u0430\u0442\u044C \u0432\u044B\u0431\u043E\u0440 \u0431\u043E\u0439\u0446\u0443
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C
      \u0438\u043B\u0438 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u0438
      \u0438\u0441\u043A\u0430\u0442\u044C \u043A\u0440\u0435\u0441\u0442\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239055
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u0442\u0430\u043D\u043A
      \u0438 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0435\u0433\u043E
      \u0434\u043B\u044F \u043F\u0440\u043E\u0440\u044B\u0432\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435 \u043F\u043E\u0437\u0438\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239056
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
      \u043D\u0435 \u0440\u0438\u0441\u043A\u0443\u044F \u043E\u0442\u0440\u044F\u0434\u043E\u043C,
      \u0442\u0430\u043A \u043A\u0430\u043A \u0442\u0430\u043D\u043A \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u0437\u0430\u043C\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239057
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0442\u0430\u043D\u043A
      \u043D\u0430 \u043D\u0430\u043B\u0438\u0447\u0438\u0435 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u0438 \u043E\u0440\u0443\u0436\u0438\u044F, \u0430 \u0437\u0430\u0442\u0435\u043C
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239058
    m_Localized: "\u041F\u0440\u0438\u043A\u0430\u0437 \u0443\u043A\u0440\u044B\u0442\u044C\u0441\u044F
      \u0438 \u0437\u0430\u043B\u0435\u0447\u044C \u0438 \u0436\u0434\u0430\u0442\u044C
      \u0432\u0440\u0430\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239059
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0443
      \u043F\u043E\u0434 \u043E\u0431\u0441\u0442\u0440\u0435\u043B\u043E\u043C \u0432
      \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u043D\u043E\u043C \u0442\u0435\u043C\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239060
    m_Localized: "\u041E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u0438 \u043D\u0430\u0439\u0442\u0438
      \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239061
    m_Localized: "\u0417\u0430\u0431\u0440\u0430\u0442\u044C \u0432\u0441\u0451,
      \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239062
    m_Localized: "\u041B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0442\u044C
      \u044F\u0449\u0438\u043A \u2014 \u0435\u0441\u043B\u0438 \u043E\u043D \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442
      \u043D\u0430\u0448\u0435\u0439 \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0435,
      \u0442\u043E \u043B\u044E\u0431\u043E\u0435 \u0432\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043F\u043E\u0434 \u0443\u0433\u0440\u043E\u0437\u0443 \u0432\u0441\u044E
      \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239063
    m_Localized: "\u0414\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u0434\u0438\u0432\u0435\u0440\u0441\u0430\u043D\u0442\u043E\u0432
      \u0438 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0443 \u043D\u0438\u0445
      \u043F\u043E\u043C\u043E\u0449\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239064
    m_Localized: "\u041F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C \u0441\u0432\u044F\u0437\u0430\u0442\u044C
      \u043F\u043B\u0435\u043D\u043D\u044B\u0445 \u0438 \u0432\u0437\u044F\u0442\u044C
      \u0438\u0445 \u0441 \u0441\u043E\u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239065
    m_Localized: "\u0420\u0430\u0441\u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C
      \u043F\u043B\u0435\u043D\u043D\u044B\u0445, \u043D\u0435\u0442 \u043F\u043E\u0449\u0430\u0434\u044B
      \u0432\u0440\u0430\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239066
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u0441\u043E\u043B\u0434\u0430\u0442\u044B
      \u0440\u0435\u0448\u0430\u044E\u0442 \u0438\u0445 \u0441\u0443\u0434\u044C\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239067
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043E\u0433\u043E\u043D\u044C
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043D\u0430\u0434\u043E
      \u0441\u043F\u0430\u0441\u0442\u0438 \u043F\u043B\u0435\u043D\u043D\u044B\u0445
      \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0431\u0443\u0434\u0435\u0442
      \u043F\u043E\u0437\u0434\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239068
    m_Localized: "\u0421\u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0432\u0430\u0442\u044C
      \u0437\u0430\u043D\u044F\u0442\u044C \u043F\u043E\u0437\u0438\u0446\u0438\u0438
      \u0441 \u0444\u043B\u0430\u043D\u0433\u043E\u0432 \u0438 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239069
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0444\u0430\u0448\u0438\u0441\u0442\u044B \u0437\u0430\u043A\u043E\u043D\u0447\u0430\u0442,
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C
      \u0447\u0435\u0440\u0435\u0437 \u0434\u043E\u0440\u043E\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239070
    m_Localized: "\u0412\u044B \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u043B\u0438
      \u043C\u0438\u043D\u043D\u043E\u0435 \u043F\u043E\u043B\u0435, \u0434\u0432\u0438\u0433\u0430\u044F\u0441\u044C
      \u0441\u0442\u0440\u043E\u0433\u043E \u0441\u043B\u0435\u0434 \u0432 \u0441\u043B\u0435\u0434,
      \u043D\u043E \u0432\u0437\u0440\u044B\u0432\u044B \u0443\u043D\u0435\u0441\u043B\u0438
      \u0436\u0438\u0437\u043D\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u0431\u043E\u0439\u0446\u043E\u0432. \u0424\u0430\u0448\u0438\u0441\u0442\u044B,
      \u0443\u0432\u0438\u0434\u0435\u0432 \u044D\u0442\u043E, \u0441\u043A\u043E\u0440\u0435\u0435
      \u0432\u0441\u0435\u0433\u043E, \u0440\u0435\u0448\u0438\u043B\u0438, \u0447\u0442\u043E
      \u043E\u0442\u0440\u044F\u0434 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239071
    m_Localized: "\u041E\u0431\u0445\u043E\u0434 \u0437\u0430\u043D\u044F\u043B \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0438\u0437-\u0437\u0430 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0445
      \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u0432 \u043F\u043E\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239072
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D
      \u0443\u0446\u0435\u043B\u0435\u043B\u0438 \u043F\u0440\u0438 \u0432\u0437\u0440\u044B\u0432\u0435
      \u0438 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438, \u043A\u043E\u0433\u0434\u0430
      \u043D\u0430 \u043D\u0438\u0445 \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239073
    m_Localized: "\u0412\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0434\u0435\u0432\u043E\u0447\u043A\u0443
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0438 \u043F\u0443\u0442\u044C.
      \u0411\u043E\u0435\u0446 \u0431\u044B\u043B \u0441\u0438\u043B\u044C\u043D\u043E
      \u043E\u0433\u043E\u0440\u0447\u0435\u043D. \u0421\u043F\u0443\u0441\u0442\u044F
      \u0432\u0440\u0435\u043C\u044F \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430
      \u0434\u043E\u043D\u0435\u0441\u043B\u0438\u0441\u044C \u0435\u0435 \u043A\u0440\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239074
    m_Localized: "\u041E\u0434\u0438\u043D \u0431\u043E\u0435\u0446 \u043F\u044B\u0442\u0430\u043B\u0441\u044F
      \u043E\u0442\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445,
      \u043D\u0430\u0437\u044B\u0432\u0430\u044F \u0438\u0445 \u0444\u0430\u0448\u0438\u0441\u0442\u0430\u043C\u0438.
      \u0412\u044B \u043E\u0433\u043B\u0443\u0448\u0438\u043B\u0438 \u0435\u0433\u043E,
      \u043F\u0440\u0438\u043A\u0430\u0437 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043B\u0438.
      \u041F\u043E\u0437\u0436\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u0436\u0438\u0442\u0435\u043B\u0438
      \u043D\u0430\u0448\u043B\u0438 \u0442\u0435\u043B\u043E \u0434\u0435\u0432\u043E\u0447\u043A\u0438.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043D\u0438 \u0436\u0430\u0436\u0434\u0443\u0442
      \u043C\u0435\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239075
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0439\u0441\u044F
      \u0431\u043E\u0435\u0446 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
      \u0432\u0430\u043C: \u043D\u0435\u043C\u0446\u044B, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u044B\u0435
      \u0437\u0430 \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u0435 \u0434\u043E\u0447\u0435\u0440\u0438,
      \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0438 \u0435\u043C\u0443 \u043A\u043E\u0440\u0437\u0438\u043D\u0443
      \u0441 \u0435\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239076
    m_Localized: "\u0418\u0437\u2011\u0437\u0430 \u0441\u0438\u043B\u044C\u043D\u043E\u0433\u043E
      \u0442\u0435\u0447\u0435\u043D\u0438\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0431\u043E\u0439\u0446\u043E\u0432 \u0432\u044B\u043D\u0443\u0436\u0434\u0435\u043D\u044B
      \u0431\u044B\u043B\u0438 \u0441\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0433\u0440\u0443\u0437,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043F\u0430\u0441\u0442\u0438\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239077
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430 \u043F\u043E
      \u0431\u0440\u0435\u0432\u043D\u0443 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043E\u043F\u0430\u0441\u043D\u043E\u0439: \u043E\u0434\u0438\u043D \u0432\u0430\u0448
      \u0431\u043E\u0435\u0446 \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0440\u0430\u0432\u043D\u043E\u0432\u0435\u0441\u0438\u0435,
      \u0441\u043E\u0440\u0432\u0430\u043B\u0441\u044F, \u0438 \u0435\u0433\u043E
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E \u0443\u043D\u0435\u0441\u043B\u043E
      \u0442\u0435\u0447\u0435\u043D\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239078
    m_Localized: "\u0422\u0435\u0447\u0435\u043D\u0438\u0435 \u0440\u0435\u043A\u0438
      \u043D\u0435 \u043C\u0435\u043D\u044F\u043B\u043E\u0441\u044C, \u0432\u044B
      \u0448\u043B\u0438 \u0432\u0441\u0435 \u0434\u0430\u043B\u044C\u0448\u0435.
      \u041D\u0430\u043A\u043E\u043D\u0435\u0446 \u0432\u044B \u043D\u0430\u0448\u043B\u0438
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u0438 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C, \u043D\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0438
      \u0441\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239079
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u044F\u0433\u043E\u0434\u044B
      \u0438 \u0433\u0440\u0438\u0431\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0441\u044A\u0435\u0434\u043E\u0431\u043D\u044B\u043C\u0438. \u0411\u043E\u0439\u0446\u044B
      \u043E\u0431\u0440\u0430\u0434\u043E\u0432\u0430\u043B\u0438\u0441\u044C, \u0447\u0442\u043E
      \u0445\u043E\u0442\u044C \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0431\u044B\u0442\u044C
      \u043E \u0433\u043E\u043B\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239080
    m_Localized: "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432 \u0433\u0440\u0443\u043F\u043F\u0435
      \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B:
      \u043E\u043D\u0438 \u0431\u044B\u043B\u0438 \u0443\u0432\u0435\u0440\u0435\u043D\u044B,
      \u0447\u0442\u043E \u0447\u0430\u0441\u0442\u044C \u044D\u0442\u0438\u0445
      \u0433\u0440\u0438\u0431\u043E\u0432 \u0438 \u044F\u0433\u043E\u0434 \u0441\u044A\u0435\u0434\u043E\u0431\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239081
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442 \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043E\u0442 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0433\u0440\u0438\u0431\u043E\u0432
      \u0438 \u044F\u0433\u043E\u0434, \u043D\u043E \u0442\u0435, \u0447\u0442\u043E
      \u043E\u043D \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B,
      \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u0431\u0435\u0437\u0432\u0440\u0435\u0434\u043D\u044B\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239082
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u0432\u044B \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E
      \u043F\u0440\u043E\u0448\u043B\u0438 \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u0440\u0435\u0432\u043D\u044E,
      \u0441\u043E\u0431\u0440\u0430\u0432 \u043F\u0440\u0438\u043F\u0430\u0441\u044B.
      \u0423\u0442\u0440\u043E\u043C \u043A\u0442\u043E-\u0442\u043E \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0437\u0430\u043C\u0435\u0442\u0438\u0442 \u0438\u0445 \u043F\u0440\u043E\u043F\u0430\u0436\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239083
    m_Localized: "\u0412\u044B \u043E\u0431\u043E\u0448\u043B\u0438 \u0434\u0435\u0440\u0435\u0432\u043D\u044E,
      \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0432 \u043D\u0430 \u044D\u0442\u043E
      \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043C\u0435\u0441\u0442\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239084
    m_Localized: "\u041F\u043E\u043F\u043E\u043B\u043D\u044F\u044F \u043F\u0440\u0438\u043F\u0430\u0441\u044B,
      \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u043E\u043B\u0434\u0430\u0442
      \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0441\u044F \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u044E
      \u0441\u0442\u0430\u0440\u0438\u043A\u0430. \u0412 \u0441\u0442\u0440\u0430\u0445\u0435
      \u0438\u043B\u0438 \u0433\u043D\u0435\u0432\u0435 \u0431\u043E\u0439\u0446\u044B
      \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u043E\u0433\u043E\u043D\u044C \u043F\u043E
      \u043C\u0435\u0441\u0442\u043D\u044B\u043C. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043D\u0435\u0442 \u043D\u0438
      \u0434\u0443\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239085
    m_Localized: "\u0411\u043E\u0435\u0446 \u0431\u044B\u043B \u0443\u0431\u0435\u0436\u0434\u0435\u043D,
      \u0447\u0442\u043E \u0437\u0430 \u043E\u0442\u0440\u044F\u0434\u043E\u043C
      \u0441\u043B\u0435\u0434\u0438\u043B\u0438, \u043D\u043E \u043F\u043E\u0434\u0447\u0438\u043D\u0438\u043B\u0441\u044F
      \u043F\u0440\u0438\u043A\u0430\u0437\u0443 \u0438 \u0443\u0448\u0435\u043B
      \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C. \u0423\u0442\u0440\u043E\u043C
      \u0432\u044B \u043D\u0430\u0448\u043B\u0438 \u0434\u0432\u043E\u0438\u0445
      \u0447\u0430\u0441\u043E\u0432\u044B\u0445 \u0441 \u043F\u0435\u0440\u0435\u0433\u0440\u044B\u0437\u0435\u043D\u043D\u044B\u043C\u0438
      \u0433\u043B\u043E\u0442\u043A\u0430\u043C\u0438 \u2014 \u0432\u043E\u043B\u043A\u0438
      \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0438\u043C
      \u0448\u0430\u043D\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239086
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u0440\u0430\u0437\u0434\u0430\u043B\u0441\u044F
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B. \u041E\u0442\u0440\u044F\u0434
      \u0432\u0441\u043A\u043E\u0447\u0438\u043B \u0438 \u0443\u0432\u0438\u0434\u0435\u043B
      \u0443\u0431\u0438\u0442\u043E\u0433\u043E \u0432\u043E\u043B\u043A\u0430 \u0438
      \u0441\u043E\u043B\u0434\u0430\u0442\u0430 \u043D\u0430\u0434 \u043D\u0438\u043C:
      \xAB\u042F \u0436\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0437\u0430
      \u043D\u0430\u043C\u0438 \u0441\u043B\u0435\u0434\u0438\u043B\u0438!\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239087
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u0432\u044B \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0438\u0441\u044C
      \u043E\u0442 \u043A\u0440\u0438\u043A\u043E\u0432 \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0435\u043A\u0443.
      \u041A\u043E\u0433\u0434\u0430 \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E \u043C\u0435\u0441\u0442\u0430, \u043A\u0440\u0438\u043A\u0438
      \u0441\u0442\u0438\u0445\u043B\u0438. \u0412\u044B \u043D\u0430\u0448\u043B\u0438
      \u043C\u0435\u0440\u0442\u0432\u043E\u0433\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0433\u043E
      \u0438 \u0442\u0435\u043B\u0430 \u0442\u0440\u0435\u0445 \u0432\u043E\u043B\u043A\u043E\u0432.
      \u0412\u0441\u0435-\u0442\u0430\u043A\u0438 \u043E\u043D \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u0443\u0433\u0440\u043E\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239088
    m_Localized: "\u0412\u044B \u0440\u0435\u0448\u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C:
      \u0432 \u0442\u0430\u043A\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443
      \u043F\u0430\u0442\u0440\u0443\u043B\u0438 \u0442\u043E\u0436\u0435 \u043F\u0440\u0438\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438
      \u043F\u043E\u0438\u0441\u043A\u0438, \u0430 \u043A \u0443\u0442\u0440\u0443
      \u0432\u0441\u0435 \u0441\u043B\u0435\u0434\u044B \u0441\u043C\u044B\u043B
      \u0434\u043E\u0436\u0434\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239089
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u0431\u044B\u043B\u0430 \u0442\u044F\u0436\u0435\u043B\u0430:
      \u0441\u043E\u043B\u0434\u0430\u0442\u044B \u0447\u0430\u0441\u0442\u043E \u043F\u0430\u0434\u0430\u043B\u0438.
      \u0412\u044B \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u043B\u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442,
      \u043D\u043E \u043F\u043E \u043F\u0443\u0442\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239090
    m_Localized: "\u041F\u043E\u0438\u0441\u043A \u043D\u043E\u0432\u043E\u0433\u043E
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u0441\u044F,
      \u043D\u043E \u0432 \u0438\u0442\u043E\u0433\u0435 \u0432\u044B \u0432\u044B\u0448\u043B\u0438
      \u043D\u0430 \u043D\u0443\u0436\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239091
    m_Localized: "\u041A\u043E\u0441\u0442\u0435\u0440 \u0441\u043E\u0433\u0440\u0435\u043B
      \u0441\u043E\u043B\u0434\u0430\u0442, \u043D\u043E \u0435\u0433\u043E \u0442\u043E\u0447\u043D\u043E
      \u043A\u0442\u043E-\u0442\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239092
    m_Localized: "\u0411\u0435\u0437 \u043A\u043E\u0441\u0442\u0440\u0430 \u0431\u043E\u0439\u0446\u044B
      \u043C\u0435\u0440\u0437\u043B\u0438, \u043E\u0434\u0438\u043D \u043D\u0435
      \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F \u0443\u0442\u0440\u043E\u043C.
      \u0412\u0430\u0448\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0443\u0431\u0435\u0440\u0435\u0433\u043B\u043E
      \u043E\u0442\u0440\u044F\u0434 \u043E\u0442 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F,
      \u043D\u043E \u043A\u0430\u043A\u043E\u0439 \u0446\u0435\u043D\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239093
    m_Localized: "\u041A\u043E\u0441\u0442\u0435\u0440 \u0438 \u0433\u043E\u0440\u044F\u0447\u0430\u044F
      \u0435\u0434\u0430 \u043F\u043E\u043C\u043E\u0433\u043B\u0438 \u0441\u043E\u0433\u0440\u0435\u0442\u044C
      \u0431\u043E\u0439\u0446\u043E\u0432, \u0438 \u0443\u0442\u0440\u043E\u043C
      \u0432\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0438 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239094
    m_Localized: "\u0412\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0431\u043E\u0439\u0446\u0430
      \u0443\u043C\u0438\u0440\u0430\u0442\u044C \u043E\u0442 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0438.
      \u041E\u0442\u043E\u0439\u0434\u044F \u043D\u0430 \u043F\u0440\u0438\u043B\u0438\u0447\u043D\u043E\u0435
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435, \u0432\u044B
      \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B.
      \u0411\u043E\u0439\u0446\u044B \u0431\u044B\u043B\u0438 \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B
      \u0432\u0430\u0448\u0438\u043C \u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239095
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442\u044B \u043D\u0430\u0448\u043B\u0438
      \u043D\u0443\u0436\u043D\u043E\u0435 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435
      \u043F\u043E \u0441\u043E\u0432\u0435\u0442\u0443 \u0431\u043E\u0439\u0446\u0430,
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044E\u0449\u0435\u0433\u043E\u0441\u044F
      \u0432 \u0442\u0440\u0430\u0432\u0430\u0445. \u041E\u043D \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B
      \u043D\u0430\u0441\u0442\u043E\u0439\u043A\u0443, \u0438 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0434\u0435\u043D\u044C \u0431\u043E\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0448\u0435\u043B
      \u043D\u0430 \u043F\u043E\u043F\u0440\u0430\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239096
    m_Localized: "\u0411\u043E\u0435\u0446 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u0441\u043B\u0430\u0431\u0435\u0435 \u0441 \u043A\u0430\u0436\u0434\u044B\u043C
      \u0447\u0430\u0441\u043E\u043C \u0438 \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0441\u044F,
      \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0432 \u043E\u0442\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239097
    m_Localized: "\u0412 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u043F\u044F\u0442\u0438
      \u0447\u0430\u0441\u043E\u0432 \u0432\u0430\u0448\u0430 \u0433\u0440\u0443\u043F\u043F\u0430
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u043E\u0431\u0440\u0430\u043B\u0430\u0441\u044C
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0430 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239098
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0438
      \u043F\u0443\u0442\u044C \u0432 \u043D\u0430\u0434\u0435\u0436\u0434\u0435
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C \u043E\u0442\u0441\u0442\u0430\u0432\u0448\u0438\u0445
      \u043F\u043E\u0437\u0436\u0435, \u043D\u043E \u044D\u0442\u043E\u0433\u043E
      \u043D\u0435 \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239099
    m_Localized: "\u0412\u044B \u043A\u0440\u0438\u0447\u0430\u043B\u0438 \u0438
      \u0437\u0432\u0430\u043B\u0438 \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u0439,
      \u043D\u043E \u0437\u0432\u0443\u043A \u044D\u0445\u043E\u043C \u0442\u0435\u0440\u044F\u043B\u0441\u044F
      \u0432 \u043B\u0435\u0441\u0443, \u0441\u0431\u0438\u0432\u0430\u044F \u0432\u0430\u0441
      \u0441 \u0442\u043E\u043B\u043A\u0443. \u0412\u044B\u0441\u0442\u0440\u0435\u043B\u044B
      \u0441\u043E\u0437\u0434\u0430\u043B\u0438 \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u0442\u043A\u0438\u0439
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440, \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443
      \u0432\u0430\u0448\u0438 \u0431\u043E\u0439\u0446\u044B \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E \u0432\u0430\u0441, \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u044F\u0441\u044C
      \u043E\u0442\u0432\u0435\u0442\u043D\u044B\u043C\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438
      \u0432 \u043D\u0435\u0431\u043E. \u041D\u043E \u0442\u0430\u043A\u0438\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043C\u043E\u0433\u043B\u0438
      \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239100
    m_Localized: "\u0412\u044B \u043D\u0430\u0448\u043B\u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438
      \u0440\u0430\u0441\u0442\u044F\u0436\u043A\u0438, \u0437\u0430\u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u0430\u0432
      \u0432\u0437\u0440\u044B\u0432 \u043F\u043E\u0434 \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B\u0439
      \u0441\u043B\u0443\u0447\u0430\u0439. \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
      \u0432\u044B \u043D\u0435 \u0443\u0447\u043B\u0438, \u0447\u0442\u043E \u0432\u0437\u0440\u044B\u0432
      \u043F\u0440\u0438\u0432\u043B\u0435\u043A \u0434\u0440\u0443\u0433\u0438\u0435
      \u043F\u0430\u0442\u0440\u0443\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239101
    m_Localized: "\u0412\u044B \u0440\u0435\u0448\u0438\u043B\u0438 \u043D\u0435
      \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C: \u043B\u044E\u0431\u044B\u0435
      \u0434\u0438\u0432\u0435\u0440\u0441\u0438\u0438 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u043B\u0438
      \u0431\u044B \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435, \u0430 \u043A\u0440\u0430\u0436\u0430
      \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0431\u044B
      \u043D\u0435\u0437\u0430\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239102
    m_Localized: "\u0412\u0430\u043C \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C
      \u043F\u0430\u0440\u0443 \u0434\u0435\u0441\u044F\u0442\u043A\u043E\u0432 \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432,
      \u0438 \u0432\u044B \u0442\u0430\u043A\u0436\u0435 \u0437\u0430\u0431\u0440\u0430\u043B\u0438
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B. \u0412\u0437\u0440\u044B\u0432
      \u0441\u043A\u043B\u0430\u0434\u0430 \u043F\u0440\u0438\u0432\u043B\u0435\u043A
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043F\u0430\u0442\u0440\u0443\u043B\u0435\u0439,
      \u043D\u043E \u0432\u0441\u0435 \u0441\u043B\u0435\u0434\u044B \u0432\u0430\u0448\u0435\u0433\u043E
      \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044F \u0441\u0433\u043E\u0440\u0435\u043B\u0438
      \u0432 \u043E\u0433\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239103
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C.
      \u041E\u0434\u0438\u043D \u043D\u0430\u0448\u0435\u043B \u0434\u043E\u0440\u043E\u0433\u0443
      \u0434\u043E\u043C\u043E\u0439, \u043D\u043E, \u043A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
      \u0432\u0442\u043E\u0440\u043E\u0439 \u043F\u043E\u0433\u0438\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239104
    m_Localized: "\u0412\u0441\u043A\u043E\u0440\u0435 \u043F\u043E \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0430\u043C
      \u0432\u044B \u043F\u043E\u043D\u044F\u043B\u0438, \u0447\u0442\u043E \u0441\u0431\u0438\u043B\u0438\u0441\u044C
      \u0441 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430. \u0412\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043B\u0438\u0448\u043D\u0438\u0439 \u0434\u0435\u043D\u044C, \u0430 \u043F\u0430\u0442\u0440\u0443\u043B\u044C
      \u0441\u0442\u0430\u043B \u0431\u043B\u0438\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239105
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u0441\u043E\u043B\u0434\u0430\u0442
      \u043B\u043E\u0432\u043A\u043E \u0437\u0430\u043B\u0435\u0437 \u043D\u0430
      \u0434\u0435\u0440\u0435\u0432\u043E, \u0438 \u0441 \u0432\u044B\u0441\u043E\u0442\u044B
      \u0435\u043C\u0443 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u0443\u0436\u043D\u043E\u0433\u043E
      \u0432\u0430\u043C \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239106
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u043D\u043E\u0441\u0438\u043B\u043A\u0438
      \u0438 \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0441\u043C\u0435\u043D\u044F\u043B\u0438
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430. \u0420\u0430\u043D\u0435\u043D\u044B\u0439
      \u0431\u044B\u043B \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0435\u043D, \u0447\u0442\u043E
      \u0435\u0433\u043E \u043D\u0435 \u0431\u0440\u043E\u0441\u0438\u043B\u0438,
      \u043D\u043E \u0442\u0430\u043A\u043E\u0439 \u043F\u0443\u0442\u044C \u0437\u0430\u0431\u0440\u0430\u043B
      \u0443 \u0432\u0430\u0441 \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239107
    m_Localized: "\u0412\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0435\u0433\u043E
      \u0441\u0443\u0434\u044C\u0431\u0435. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u043E\u043D \u0432\u044B\u0436\u0438\u0432\u0435\u0442 \u0431\u0435\u0437
      \u0432\u0430\u0441, \u0430 \u043C\u043E\u0436\u0435\u0442, \u0437\u0430\u0431\u0435\u0440\u0435\u0442
      \u0441 \u0441\u043E\u0431\u043E\u0439 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239108
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0432\u0430\u0436\u043D\u0435\u0435
      \u0436\u0438\u0437\u043D\u044C \u043B\u044E\u0431\u043E\u0433\u043E \u0431\u043E\u0439\u0446\u0430,
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0433\u043E \u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043E\u0440\u0443\u0436\u0438\u0435. \u0412\u044B \u043D\u0435 \u043C\u043E\u0433\u043B\u0438
      \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C \u043E\u0442\u0440\u044F\u0434\u043E\u043C
      \u0438 \u0442\u0440\u0430\u0442\u0438\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0432\u043F\u0443\u0441\u0442\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239109
    m_Localized: "\u041E\u0431\u0445\u043E\u0434\u043D\u043E\u0439 \u043F\u0443\u0442\u044C
      \u0437\u0430\u043D\u044F\u043B \u0432\u0440\u0435\u043C\u044F, \u043D\u043E
      \u043E\u0442\u0440\u044F\u0434 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0446\u0435\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239110
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u043B\u0434\u0430\u0442
      \u0443\u0432\u044F\u0437\u043B\u0438 \u0432 \u0431\u043E\u043B\u043E\u0442\u0435,
      \u043F\u043E\u0442\u0435\u0440\u044F\u0432 \u043F\u0440\u0438\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239111
    m_Localized: "\u0421\u0431\u0440\u043E\u0441\u0438\u0432 \u043F\u0440\u0438\u043F\u0430\u0441\u044B,
      \u0432\u0430\u0448\u0430 \u0433\u0440\u0443\u043F\u043F\u0430 \u043F\u0440\u043E\u0448\u043B\u0430
      \u0431\u043E\u043B\u043E\u0442\u043E \u0436\u0438\u0432\u043E\u0439. \u0411\u044B\u043B\u043E
      \u0442\u044F\u0436\u0435\u043B\u043E, \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043F\u043E\u0447\u0442\u0438 \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u043E,
      \u043D\u043E, \u0442\u0430\u043A-\u043A\u0430\u043A \u0432\u0441\u0435 \u0431\u044B\u043B\u0438
      \u043D\u0430\u043B\u0435\u0433\u043A\u0435, \u0432\u0441\u0435 \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239112
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u0431\u0435\u0437
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C \u043F\u0440\u043E\u043D\u0438\u043A
      \u0432 \u043B\u0430\u0433\u0435\u0440\u044C \u0438 \u0437\u0430\u0431\u0440\u0430\u043B
      \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432.
      \u0423\u0442\u0440\u043E\u043C \u0444\u0430\u0448\u0438\u0441\u0442\u044B \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438
      \u043F\u0440\u043E\u043F\u0430\u0436\u0443 \u2014 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043E\u043D\u0438 \u0438\u0449\u0443\u0442 \u0432\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239113
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u043B\u0430\u0433\u0435\u0440\u044C
      \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0441\u043B\u043E\u0436\u043D\u043E:
      \u043F\u043E\u0432\u0441\u044E\u0434\u0443 \u043F\u0430\u0442\u0440\u0443\u043B\u0438.
      \u0412\u044B \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0447\u0435\u043C \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239114
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u0432\u044B \u043F\u043E\u0434\u043A\u0440\u0430\u043B\u0438\u0441\u044C
      \u043A \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443 \u0438
      \u043D\u0430\u0447\u0430\u043B\u0438 \u0440\u0435\u0437\u043D\u044E. \u0412\u044B
      \u0431\u044B\u043B\u0438 \u0432 \u043C\u0435\u043D\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0435,
      \u043D\u043E \u044D\u0444\u0444\u0435\u043A\u0442 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u0438
      \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C
      \u043B\u0430\u0433\u0435\u0440\u044C. \u041E\u0434\u043D\u0430\u043A\u043E
      \u043E\u0442\u0440\u044F\u0434 \u043B\u0438\u0448\u0438\u043B\u0441\u044F \u043C\u043D\u043E\u0433\u0438\u0445
      \u0431\u043E\u0439\u0446\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239115
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u0432\u044B\u0436\u0438\u043B,
      \u0443\u043A\u0440\u044B\u0432\u0448\u0438\u0441\u044C \u0432 \u0440\u0430\u0437\u043D\u044B\u0445
      \u043C\u0435\u0441\u0442\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239116
    m_Localized: "\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0432\u0448\u0438\u0441\u044C,
      \u0432\u044B \u043F\u043E\u0432\u044B\u0441\u0438\u043B\u0438 \u0448\u0430\u043D\u0441\u044B
      \u043D\u0430 \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435, \u043D\u043E
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043D\u0430\u0440\u044F\u0434\u043E\u0432
      \u0437\u0430\u0434\u0435\u043B\u0438 \u0434\u0432\u043E\u0438\u0445 \u0432\u0430\u0448\u0438\u0445
      \u0431\u043E\u0439\u0446\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239117
    m_Localized: "\u0412\u044B \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u043E\u0433\u043E\u043D\u044C
      \u0438\u0437 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A \u043F\u043E
      \u0441\u0430\u043C\u043E\u043B\u0435\u0442\u0430\u043C. \u0424\u0430\u0448\u0438\u0441\u0442\u044B
      \u0443\u0437\u043D\u0430\u043B\u0438, \u0433\u0434\u0435 \u0432\u044B. \u041E\u043D\u0438
      \u043E\u0442\u0432\u0435\u0442\u0438\u043B\u0438 \u043F\u0443\u043B\u0435\u043C\u0435\u0442\u043D\u044B\u043C
      \u043E\u0433\u043D\u0435\u043C \u2014 \u0447\u0435\u0442\u0432\u0435\u0440\u043E
      \u0432\u0430\u0448\u0438\u0445 \u0431\u043E\u0439\u0446\u043E\u0432 \u043F\u043E\u0433\u0438\u0431\u043B\u0438.
      \u0421\u0430\u043C\u043E\u043B\u0435\u0442\u044B \u0441\u043E\u043E\u0431\u0449\u0430\u0442
      \u043E \u0432\u0430\u0448\u0435\u043C \u043C\u0435\u0441\u0442\u043E\u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239118
    m_Localized: "\u0421\u043E\u0431\u0430\u043A\u0438 \u0443\u0431\u0438\u0442\u044B,
      \u043D\u043E \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u0438 \u0442\u0440\u0443\u043F\u044B
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0443\u0442
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0445
      \u043F\u0430\u0442\u0440\u0443\u043B\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239119
    m_Localized: "\u0412\u0441\u0435 \u0437\u043D\u0430\u044E\u0442: \u043E\u0442
      \u0441\u043E\u0431\u0430\u043A \u043D\u0435 \u0443\u0431\u0435\u0436\u0430\u0442\u044C.
      \u041D\u043E \u044D\u0442\u043E\u0442 \u043F\u0440\u0438\u043A\u0430\u0437
      \u0432\u0441\u0435 \u043F\u043E\u043D\u044F\u043B\u0438 \u0442\u0430\u043A,
      \u0447\u0442\u043E \u0432\u044B\u0436\u0438\u0432\u0443\u0442 \u0441\u0430\u043C\u044B\u0435
      \u0431\u044B\u0441\u0442\u0440\u044B\u0435 \u0438\u0437 \u0432\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239120
    m_Localized: "\u0421\u043E\u0431\u0430\u043A\u0438 \u043D\u0430\u043A\u0438\u043D\u0443\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0441\u043E\u043B\u0434\u0430\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u044F\u0440\u043E\u0441\u0442\u043D\u043E \u0441\u0440\u0430\u0436\u0430\u043B\u0441\u044F
      \u0441 \u043D\u0438\u043C\u0438. \u042D\u0442\u043E \u0431\u044B\u043B\u0430
      \u0441\u0442\u0440\u0430\u0448\u043D\u0430\u044F \u0441\u043C\u0435\u0440\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239121
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u0443\u043D\u0435\u0441 \u0436\u0438\u0437\u043D\u0438
      \u0447\u0435\u0442\u0432\u0435\u0440\u044B\u0445 \u0441\u043E\u043B\u0434\u0430\u0442,
      \u0441\u0433\u043E\u0440\u0435\u043B\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u044B.
      \u041D\u043E \u043F\u0430\u0442\u0440\u0443\u043B\u0438, \u0438\u0434\u0443\u0449\u0438\u0435
      \u043F\u043E \u0432\u0430\u0448\u0438\u043C \u0441\u043B\u0435\u0434\u0430\u043C,
      \u043D\u0430 \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u043B\u0438
      \u043F\u043E\u0438\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239122
    m_Localized: "\u0412\u0430\u043C \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0443\u043A\u0440\u044B\u0442\u044C\u0441\u044F
      \u043E\u0442 \u043E\u0433\u043D\u044F, \u043D\u043E \u0433\u043E\u0440\u044F\u0449\u0435\u0435
      \u0434\u0435\u0440\u0435\u0432\u043E \u0443\u043F\u0430\u043B\u043E \u0432
      \u044F\u043C\u0443 \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0438\u0437 \u0432\u0430\u0448\u0438\u0445 \u0431\u043E\u0439\u0446\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239123
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043B
      \u0432\u0430\u0448\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0431\u0435\u0437\u0443\u043C\u0435\u0446 \u043F\u043E\u0448\u0435\u043B \u0431\u044B
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0433\u043E\u043D\u044C, \u043D\u043E
      \u043F\u0443\u0442\u044C \u0434\u043E \u0441\u0432\u043E\u0438\u0445 \u0441\u0442\u0430\u043B
      \u0434\u043E\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239124
    m_Localized: "\u041F\u043E\u043A\u0430 \u0444\u0430\u0448\u0438\u0441\u0442\u044B
      \u0431\u044B\u043B\u0438 \u0437\u0430\u043D\u044F\u0442\u044B \u0441\u0436\u0438\u0433\u0430\u043D\u0438\u0435\u043C
      \u0434\u043E\u043C\u0430, \u0432\u044B \u0443\u0441\u043F\u0435\u0448\u043D\u043E
      \u043D\u0430\u0448\u043B\u0438 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B, \u043D\u043E \u0432\u0440\u0430\u0433
      \u0437\u0430\u043C\u0435\u0442\u0438\u0442 \u0438\u0445 \u043F\u0440\u043E\u043F\u0430\u0436\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239125
    m_Localized: "\u0412\u044B \u0441\u043C\u043E\u0433\u043B\u0438 \u043F\u0440\u043E\u0439\u0442\u0438
      \u043D\u0435\u0437\u0430\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u043C\u0438,
      \u0442\u0430\u043A \u043A\u0430\u043A \u0444\u0430\u0448\u0438\u0441\u0442\u044B
      \u0431\u044B\u043B\u0438 \u0437\u0430\u043D\u044F\u0442\u044B \u0434\u0440\u0443\u0433\u0438\u043C
      \u0434\u0435\u043B\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239126
    m_Localized: "\u0412\u044B \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u043E\u0433\u043E\u043D\u044C,
      \u0438, \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0442\u043E,
      \u0447\u0442\u043E \u0438\u0445 \u0431\u044B\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0432\u044B \u0441\u043C\u043E\u0433\u043B\u0438 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u043E\u0442\u0440\u044F\u0434
      \u0432\u0440\u0430\u0433\u0430. \u041E\u0434\u043D\u0430\u043A\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
