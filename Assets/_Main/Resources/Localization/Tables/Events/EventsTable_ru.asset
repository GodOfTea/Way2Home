      \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0432 \u043E\u0442\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514261
    m_Localized: "\u0412 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u043F\u044F\u0442\u0438
      \u0447\u0430\u0441\u043E\u0432 \u0432\u0430\u0448\u0430 \u0433\u0440\u0443\u043F\u043F\u0430
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u043E\u0431\u0440\u0430\u043B\u0430\u0441\u044C
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0430 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514262
    m_Localized: "\u0412 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u043F\u044F\u0442\u0438
      \u0447\u0430\u0441\u043E\u0432 \u0432\u0430\u0448\u0430 \u0433\u0440\u0443\u043F\u043F\u0430
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u043E\u0431\u0440\u0430\u043B\u0430\u0441\u044C
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0430 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514263
    m_Localized: "\u0420\u0435\u0448\u0438\u0432 \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F,
      \u0432\u044B \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u043B\u0438 \u0438\u0434\u0442\u0438
      \u0434\u0430\u043B\u044C\u0448\u0435, \u043D\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
      \u0445\u043E\u0440\u043E\u0448\u043E \u0437\u0430\u043C\u0435\u0442\u043D\u044B\u0435
      \u0437\u043D\u0430\u043A\u0438 \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0435. \u0427\u0435\u0440\u0435\u0437
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432
      \u043E\u0442\u0441\u0442\u0430\u0432\u0448\u0438\u0435 \u0434\u043E\u0433\u043D\u0430\u043B\u0438
      \u0432\u0430\u0441, \u0437\u0430\u043F\u044B\u0445\u0430\u0432\u0448\u0438\u0435\u0441\u044F,
      \u043D\u043E \u0446\u0435\u043B\u044B\u0435. \u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
      \u043E\u043D\u0438 \u0437\u0430\u0431\u0440\u0435\u043B\u0438 \u043D\u0430
      \u043F\u043E\u043B\u044F\u043D\u0443 \u0441 \u0434\u0438\u043A\u0438\u043C\u0438
      \u044F\u0431\u043B\u043E\u043D\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514264
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0438
      \u043F\u0443\u0442\u044C \u0432 \u043D\u0430\u0434\u0435\u0436\u0434\u0435
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C \u043E\u0442\u0441\u0442\u0430\u0432\u0448\u0438\u0445
      \u043F\u043E\u0437\u0436\u0435, \u043D\u043E \u044D\u0442\u043E\u0433\u043E
      \u043D\u0435 \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514265
    m_Localized: "\u0412\u044B \u043A\u0440\u0438\u0447\u0430\u043B\u0438 \u0438
      \u0437\u0432\u0430\u043B\u0438 \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u0439,
      \u043D\u043E \u0437\u0432\u0443\u043A \u044D\u0445\u043E\u043C \u0442\u0435\u0440\u044F\u043B\u0441\u044F
      \u0432 \u043B\u0435\u0441\u0443, \u0441\u0431\u0438\u0432\u0430\u044F \u0432\u0430\u0441
      \u0441 \u0442\u043E\u043B\u043A\u0443. \u0412\u044B\u0441\u0442\u0440\u0435\u043B\u044B
      \u0441\u043E\u0437\u0434\u0430\u043B\u0438 \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u0442\u043A\u0438\u0439
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440, \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443
      \u0432\u0430\u0448\u0438 \u0431\u043E\u0439\u0446\u044B \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E \u0432\u0430\u0441, \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u044F\u0441\u044C
      \u043E\u0442\u0432\u0435\u0442\u043D\u044B\u043C\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438
      \u0432 \u043D\u0435\u0431\u043E. \u041D\u043E \u0442\u0430\u043A\u0438\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043C\u043E\u0433\u043B\u0438
      \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514266
    m_Localized: "\u0412\u044B \u043A\u0440\u0438\u0447\u0430\u043B\u0438 \u0438
      \u0437\u0432\u0430\u043B\u0438 \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u0439,
      \u043D\u043E \u0437\u0432\u0443\u043A \u044D\u0445\u043E\u043C \u0442\u0435\u0440\u044F\u043B\u0441\u044F
      \u0432 \u043B\u0435\u0441\u0443, \u0441\u0431\u0438\u0432\u0430\u044F \u0432\u0430\u0441
      \u0441 \u0442\u043E\u043B\u043A\u0443. \u0412\u044B\u0441\u0442\u0440\u0435\u043B\u044B
      \u0441\u043E\u0437\u0434\u0430\u043B\u0438 \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u0442\u043A\u0438\u0439
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440, \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443
      \u0432\u0430\u0448\u0438 \u0431\u043E\u0439\u0446\u044B \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E \u0432\u0430\u0441, \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u044F\u0441\u044C
      \u043E\u0442\u0432\u0435\u0442\u043D\u044B\u043C\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438
      \u0432 \u043D\u0435\u0431\u043E. \u041D\u043E \u0442\u0430\u043A\u0438\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043C\u043E\u0433\u043B\u0438
      \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514267
    m_Localized: "\u0412\u044B \u043D\u0430\u0448\u043B\u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438
      \u0440\u0430\u0441\u0442\u044F\u0436\u043A\u0438, \u0437\u0430\u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u0430\u0432
      \u0432\u0437\u0440\u044B\u0432 \u043F\u043E\u0434 \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B\u0439
      \u0441\u043B\u0443\u0447\u0430\u0439. \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
      \u0432\u044B \u043D\u0435 \u0443\u0447\u043B\u0438, \u0447\u0442\u043E \u0432\u0437\u0440\u044B\u0432
      \u043F\u0440\u0438\u0432\u043B\u0435\u043A \u0434\u0440\u0443\u0433\u0438\u0435
      \u043F\u0430\u0442\u0440\u0443\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479413514268
    m_Localized: "\u041F\u043E\u043A\u0430 \u0432\u0430\u0448 \u0431\u043E\u0439\u0446\u044B
      \u0441\u043F\u043E\u0440\u043E\u043B\u0438 \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u043E\u0439,
      \u043A\u0430\u043A \u043B\u0443\u0447\u0448\u0435 \u0437\u0430\u043C\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C,
      \u043E\u0434\u0438\u043D \u0438\u0437 \u0431\u043E\u0439\u0446\u043E\u0432
