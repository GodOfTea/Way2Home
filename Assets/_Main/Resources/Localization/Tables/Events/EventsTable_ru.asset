      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445
      \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u043E\u0432. \u041D\u043E, \u043A
      \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0432\u0430\u0448\u0438\u0445 \u0431\u043E\u0439\u0446\u043E\u0432 \u043F\u043E\u0433\u0438\u0431\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479434485767
    m_Localized: "\u0416\u0435\u0440\u0442\u0432\u0430 \u043D\u0435 \u0431\u044B\u043B\u0430
