    m_Metadata:
      m_Items: []
  - m_Id: 1730899239207
    m_Localized: "\u041E\u0445\u043E\u0442\u0438\u0442\u044C\u0441\u044F \u0432\u0441\u0435\u043C
      \u043E\u0442\u0440\u044F\u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239208
    m_Localized: "\u041F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C \u0431\u043E\u0439\u0446\u0430\u043C
      \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C \u0431\u043B\u043E\u043A\u043F\u043E\u0441\u0442,
      \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0443\u0431\u0435\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239209
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439
      \u043F\u0443\u0442\u044C, \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C
      \u043D\u0435\u043D\u0443\u0436\u043D\u043E\u0433\u043E \u0431\u043E\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239210
    m_Localized: "\u041E\u0434\u0435\u0442\u044C\u0441\u044F \u0432 \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0443\u044E
      \u0444\u043E\u0440\u043C\u0443 \u0438 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0444\u0430\u043B\u044C\u0448\u0438\u0432\u044B\u0435 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239211
    m_Localized: "\u041D\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C \u0431\u043E\u0439\u0446\u0430\u043C
      \u043E \u0441\u0443\u0431\u043E\u0440\u0434\u0438\u043D\u0430\u0446\u0438\u0438
      \u0438 \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u0441\u0435\u043C
      \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u0432\u0430\u0448\u0438\u043C
      \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239212
    m_Localized: "\u0421\u043D\u044F\u0442\u044C \u0441 \u0441\u0435\u0431\u044F
      \u043F\u043E\u043B\u043D\u043E\u043C\u043E\u0447\u0438\u044F \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239213
    m_Localized: "\u041F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C \u0431\u043E\u0439\u0446\u0443
      \u0438 \u0442\u0435\u043C, \u043A\u0442\u043E \u0441 \u043D\u0438\u043C \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D,
      \u0438\u0434\u0442\u0438 \u0441\u0432\u043E\u0435\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239214
    m_Localized: "\u0424\u0430\u0448\u0438\u0441\u0442\u044B \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430 \u0443\u043B\u043E\u0432\u043A\u0443 \u0438 \u0441\u043B\u0435\u0434\u0443\u044E\u0442
      \u0437\u0430 \u043B\u043E\u0436\u043D\u044B\u043C \u0441\u043B\u0435\u0434\u043E\u043C,
      \u0447\u0442\u043E \u0434\u0430\u0435\u0442 \u043E\u0442\u0440\u044F\u0434\u0443
      \u0432\u0440\u0435\u043C\u044F \u0443\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239215
    m_Localized: "\u0412 \u0441\u043F\u0435\u0448\u043A\u0435 \u0432\u0430\u043C
      \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0442\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F
      \u043E\u0442 \u043F\u0430\u0442\u0440\u0443\u043B\u044F, \u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u0437\u0436\u0435 \u0432\u044B \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438
      \u043F\u0440\u043E\u043F\u0430\u0436\u0443 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0438\u0437 \u0431\u043E\u0439\u0446\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239216
    m_Localized: "\u0424\u0430\u0448\u0438\u0441\u0442\u044B \u0441\u043B\u0435\u0434\u0443\u044E\u0442
      \u0437\u0430 \u043B\u043E\u0436\u043D\u044B\u043C \u0441\u043B\u0435\u0434\u043E\u043C,
      \u0447\u0442\u043E \u0434\u0430\u0435\u0442 \u043E\u0442\u0440\u044F\u0434\u0443
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043E\u0442\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F,
      \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0432 \u043C\u043D\u043E\u0433\u043E
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239217
    m_Localized: "\u0412\u0437\u0440\u044B\u0432 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0435\u0442
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432,
      \u0438 \u043F\u0430\u0442\u0440\u0443\u043B\u044C \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u0438\u0437\u043C\u0435\u043D\u044F\u0435\u0442 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u043F\u043E\u0438\u0441\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239218
    m_Localized: "\u041F\u043E\u0436\u0430\u0440 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u0435\u0442 \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432,
      \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0438\u0445 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C.
      \u041E\u0434\u043D\u0430\u043A\u043E \u043E\u0433\u043E\u043D\u044C \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043C \u043E\u0436\u0438\u0434\u0430\u043B\u043E\u0441\u044C
      \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C
      \u043D\u043E\u0432\u044B\u0439 \u0432\u0440\u0430\u0433 \u044D\u0442\u043E
      \u043E\u0433\u043E\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239219
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
      \u0438\u0437\u0431\u0435\u0433\u0430\u044F \u043B\u0438\u0448\u043D\u0435\u0433\u043E
      \u0448\u0443\u043C\u0430. \u041D\u043E \u0444\u0430\u0448\u0438\u0441\u0442\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044E\u0442 \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0432\u0430\u0441, \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
      \u0441\u043E\u043A\u0440\u0430\u0449\u0430\u044F \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239220
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u043D\u0430\u0445\u043E\u0434\u0438\u0442
      \u0440\u0435\u043A\u0443 \u0438 \u0443\u0442\u043E\u043B\u044F\u0435\u0442
      \u0436\u0430\u0436\u0434\u0443, \u0430 \u0442\u0430\u043A\u0436\u0435 \u043D\u0430\u0431\u0438\u0440\u0430\u0435\u0442
      \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u043E\u0434\u044B \u0432 \u0434\u043E\u0440\u043E\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239221
    m_Localized: "\u0412\u044B \u0440\u0435\u0448\u0430\u0435\u0442\u0435 \u043D\u0435
      \u0440\u0430\u0437\u0434\u0435\u043B\u044F\u0442\u044C \u043E\u0442\u0440\u044F\u0434
      \u0438 \u043D\u0435 \u043E\u0442\u043A\u043B\u043E\u043D\u044F\u0442\u044C\u0441\u044F
      \u043E\u0442 \u043F\u0443\u0442\u0438. \u041E\u0434\u043D\u0430\u043A\u043E
      \u0436\u0430\u0436\u0434\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0431\u043E\u0439\u0446\u043E\u0432 \u0442\u044F\u043D\u0443\u0442\u044C\u0441\u044F
      \u043A \u043B\u0443\u0436\u0430\u043C, \u0438 \u0432\u0430\u043C \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0432\u043C\u0435\u0448\u0430\u0442\u044C\u0441\u044F, \u0447\u0442\u043E\u0431\u044B
      \u0438\u0445 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239222
    m_Localized: "\u041F\u043E\u0438\u0441\u043A\u043E\u0432\u0430\u044F \u0433\u0440\u0443\u043F\u043F\u0430
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442 \u0440\u0435\u043A\u0443 \u0438
      \u043D\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0435
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0432\u043E\u0434\u044B
      \u0441 \u0441\u043E\u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239223
    m_Localized: "\u0413\u0440\u0443\u043F\u043F\u0430 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A
      \u043E\u0442\u0440\u044F\u0434\u0443 \u0441 \u0434\u043E\u0431\u044B\u0447\u0435\u0439,
      \u043D\u0435\u0441\u044F \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u043C\u044F\u0441\u0430, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u043A\u043E\u0440\u043C\u0438\u0442\u044C
      \u0432\u0441\u0435\u0445. \u0418\u0445 \u0443\u0441\u0438\u043B\u0438\u044F
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u043B\u0438 \u043F\u0440\u043E\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0445\u0432\u0430\u0442\u0438\u0442
      \u043D\u0430\u0434\u043E\u043B\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239224
    m_Localized: "\u041E\u0445\u043E\u0442\u0430 \u0432 \u043B\u0435\u0441\u0443
      \u2014 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0440\u0438\u0441\u043A. \u0412\u044B\u0441\u0442\u0440\u0435\u043B\u044B
      \u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u044C
      \u043F\u0430\u0442\u0440\u0443\u043B\u0438, \u0430 \u0448\u0443\u043C \u0432\u044B\u0434\u0430\u0441\u0442
      \u0432\u0430\u0448\u0435 \u043C\u0435\u0441\u0442\u043E\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435.
      \u0420\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C \u0432 \u0442\u0430\u043A\u043E\u0439
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u043E\u043F\u0430\u0441\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239225
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442\u044B \u043D\u0430\u0445\u043E\u0434\u044F\u0442
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0434\u0438\u0447\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u043A\u043E\u0440\u043C\u0438\u0442\u044C
      \u0432\u0435\u0441\u044C \u043E\u0442\u0440\u044F\u0434, \u043D\u043E \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u043D\u0435\u043C\u0446\u0430\u043C \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u043E\u043A\u0440\u0430\u0442\u0438\u0442\u044C \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0443 \u0431\u043E\u0439\u0446\u043E\u0432
      \u0435\u0441\u0442\u044C \u0435\u0434\u0430, \u043D\u043E \u043F\u0430\u0442\u0440\u0443\u043B\u044C
      \u0443\u0436\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u043B\u0438\u0437\u043A\u043E,
      \u0438 \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u044F
      \u0431\u0443\u0434\u0435\u0442 \u0442\u0440\u0443\u0434\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239226
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u0443\u0441\u043F\u0435\u0448\u043D\u043E
      \u0437\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u0431\u043B\u043E\u043A\u043F\u043E\u0441\u0442,
      \u043D\u043E \u043F\u043E\u0442\u0435\u0440\u0438 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B.
      \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E,
      \u0438 \u043D\u0430\u0448\u0438 \u0443\u0436\u0435 \u0440\u044F\u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239227
    m_Localized: "\u041E\u0431\u0445\u043E\u0434 \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442
      \u043C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u043D\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B, \u0444\u0440\u043E\u043D\u0442
      \u0443\u0436\u0435 \u0440\u044F\u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239228
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0431\u043B\u043E\u043A\u043F\u043E\u0441\u0442 \u043D\u0435\u0437\u0430\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u043C\u0438,
      \u0432\u0430\u0448\u0438 \u0437\u043D\u0430\u043D\u0438\u044F \u043D\u0435\u043C\u0435\u0446\u043A\u043E\u0433\u043E
      \u044F\u0437\u044B\u043A\u0430 \u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u0441\u043C\u043E\u0433\u043B\u0438 \u043E\u0431\u043C\u0430\u043D\u0443\u0442\u044C
      \u0438\u0445, \u0432\u044B \u043F\u043E\u0447\u0442\u0438 \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239229
    m_Localized: "\u0412\u044B \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0435
      \u0432\u0441\u0435\u043C, \u043A\u0430\u043A \u0432\u044B \u0433\u043D\u0430\u043B\u0438
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u0441 \u043D\u0430\u0448\u0435\u0439
      \u0437\u0435\u043C\u043B\u0438, \u043A\u0430\u043A \u0441\u0431\u0435\u0436\u0430\u043B\u0438
      \u0438\u0437 \u043F\u043B\u0435\u043D\u0430 \u0438 \u043F\u0443\u0441\u0442\u044C
      \u0441 \u043F\u043E\u0442\u0435\u0440\u044F\u043C\u0438, \u043D\u043E \u0432\u0430\u043C
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0443\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044C
      \u0432\u044B\u0439\u0442\u0438 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044F\u043C\u0438.
      \u041E\u0442\u0440\u044F\u0434 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B
      \u0432\u0430\u0448\u0438 \u0437\u0430\u0441\u043B\u0443\u0433\u0438 \u0438
      \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F
      \u0438 \u0432\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0438
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239230
    m_Localized: "\u0412 \u043E\u0442\u0440\u044F\u0434\u0435 \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u0435\u0442
      \u0445\u0430\u043E\u0441, \u0431\u043E\u0439\u0446\u044B \u043F\u043E\u0434\u0435\u043B\u0438\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0433\u0440\u0443\u043F\u043F\u044B \u0438 \u043A\u0430\u0436\u0434\u0430\u044F
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C \u0432 \u0440\u0430\u0437\u043D\u043E\u043C
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
      \u0432\u0430\u0441 \u043E\u0434\u043D\u043E\u0433\u043E \u0441 \u0432\u0430\u0448\u0438\u043C\u0438
      \u043F\u043B\u0430\u043D\u0430\u043C\u0438 \u0438 \u0437\u0430\u0434\u0430\u0447\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239231
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u0440\u0430\u0437\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F;
      \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0435 \u0431\u043E\u0439\u0446\u044B
      \u0443\u0445\u043E\u0434\u044F\u0442 \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u0430\u0441
      \u0441\u0442\u0430\u043B\u043E \u043C\u0435\u043D\u044C\u0448\u0435, \u043D\u043E
      \u0438 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F
      \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u043B\u0430\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1153992744919040
    m_Localized: "\u0412\u044B \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043E\u0434\u043D\u0438.
      \u0411\u043E\u0439\u0446\u044B, \u0432\u0435\u0440\u043D\u044B\u0435 \u0432\u0430\u043C
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430, \u043F\u0430\u043B\u0438 \u0432
      \u043D\u0435\u0440\u0430\u0432\u043D\u043E\u0439 \u0431\u043E\u0440\u044C\u0431\u0435
      \u0441 \u0433\u043E\u043B\u043E\u0434\u043E\u043C, \u0445\u043E\u043B\u043E\u0434\u043E\u043C
      \u0438 \u0432\u0440\u0430\u0433\u043E\u043C.\n\n\u0412\u044B \u0437\u043D\u0430\u043B\u0438,
      \u0447\u0442\u043E \u0448\u0430\u043D\u0441\u043E\u0432 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442. \u041F\u0440\u0435\u0441\u043B\u0435\u0434\u0443\u0435\u043C\u044B\u0439
      \u043D\u0435\u043C\u0446\u0430\u043C\u0438, \u0432\u044B \u043F\u043E\u0448\u043B\u0438
      \u0438\u043C \u043D\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0443, \u043D\u0435\u0441\u044F
      \u0432 \u0441\u0435\u0431\u0435 \u043F\u0430\u043C\u044F\u0442\u044C \u043E
      \u043A\u0430\u0436\u0434\u043E\u043C \u0438\u0437 \u043D\u0438\u0445. \u0412\u0430\u0448
      \u043F\u0443\u0442\u044C \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F,
      \u043A\u0430\u043A \u0438 \u0443 \u0432\u0430\u0448\u0438\u0445 \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1153992803639296
    m_Localized: "\u041B\u0435\u0441, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u0435\u043C, \u0441\u0442\u0430\u043B
      \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043B\u043E\u0432\u0443\u0448\u043A\u043E\u0439.
      \u041F\u0440\u0438\u043F\u0430\u0441\u044B \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C,
      \u0441\u0438\u043B\u044B \u0443\u0445\u043E\u0434\u0438\u043B\u0438 \u0441
      \u043A\u0430\u0436\u0434\u044B\u043C \u0448\u0430\u0433\u043E\u043C. \u0412\u0441\u043A\u043E\u0440\u0435
      \u0441\u0442\u0430\u043B\u043E \u044F\u0441\u043D\u043E \u2014 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C
      \u043F\u0443\u0442\u044C \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E.\n\n\u0412\u044B
      \u043A\u0430\u043A \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440 \u0441
      \u0431\u043E\u043B\u044C\u044E \u043F\u0440\u043E\u0438\u0437\u043D\u0435\u0441\u043B\u0438:
      \xAB\u041C\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u0432\u0441\u0451,
      \u0447\u0442\u043E \u043C\u043E\u0433\u043B\u0438\u2026\xBB \u0418\u0437\u043C\u0443\u0447\u0435\u043D\u043D\u044B\u0435
      \u0431\u043E\u0439\u0446\u044B \u043E\u0434\u0438\u043D \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C
      \u043F\u0430\u0434\u0430\u043B\u0438, \u0438\u0441\u0442\u043E\u0449\u0451\u043D\u043D\u044B\u0435
      \u0433\u043E\u043B\u043E\u0434\u043E\u043C \u0438 \u0445\u043E\u043B\u043E\u0434\u043E\u043C.
      \u0422\u0435\u043C\u043D\u043E\u0442\u0430 \u043B\u0435\u0441\u0430 \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u043B\u0430
      \u0438\u0445, \u0438 \u043F\u0443\u0442\u044C \u043D\u0430 \u0444\u0440\u043E\u043D\u0442
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043B\u0438\u0448\u044C \u043C\u0435\u0447\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1153992803639297
    m_Localized: "\u0412\u044B \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
      \u043C\u043E\u0433\u043B\u0438 \u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C\u0441\u044F.
      \u041F\u0430\u0442\u0440\u0443\u043B\u0438 \u043D\u0430\u0433\u043D\u0430\u043B\u0438
      \u0432\u0430\u0441, \u043E\u043A\u0440\u0443\u0436\u0438\u0432 \u0441\u043E
      \u0432\u0441\u0435\u0445 \u0441\u0442\u043E\u0440\u043E\u043D. \u041A\u043E\u0440\u043E\u0442\u043A\u0430\u044F
      \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043B\u043A\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C
      \u0431\u044B\u0441\u0442\u0440\u043E. \u0423\u0441\u0442\u0430\u0432\u0448\u0438\u0435
      \u0438 \u0438\u0437\u0440\u0430\u043D\u0435\u043D\u043D\u044B\u0435, \u0431\u043E\u0439\u0446\u044B
      \u043D\u0435 \u0441\u043C\u043E\u0433\u043B\u0438 \u0434\u0430\u0442\u044C
      \u043E\u0442\u043F\u043E\u0440.\n\n\u041D\u0435\u043C\u0446\u044B \u0443\u0448\u043B\u0438,
      \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u0437\u0430 \u0441\u043E\u0431\u043E\u0439
      \u0442\u0435\u043B\u0430 \u0442\u0435\u0445, \u043A\u0442\u043E \u0434\u043E
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0432\u0435\u0440\u0438\u043B
      \u0432 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1153992803639298
    m_Localized: "\u0412\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u044D\u0442\u043E.
      \u041F\u0440\u043E\u0439\u0434\u044F \u0447\u0435\u0440\u0435\u0437 \u043B\u0435\u0441,
      \u0445\u043E\u043B\u043E\u0434 \u0438 \u0433\u043E\u043B\u043E\u0434, \u0432\u0430\u0448
      \u043E\u0442\u0440\u044F\u0434 \u0434\u043E\u0431\u0440\u0430\u043B\u0441\u044F
      \u0434\u043E \u043B\u0438\u043D\u0438\u0438 \u0444\u0440\u043E\u043D\u0442\u0430,
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0432\u0430\u043C.
      \u0412\u0437\u0433\u043B\u044F\u0434\u043E\u0432 \u0431\u043E\u0439\u0446\u043E\u0432
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B\u0438 \u0443\u043B\u044B\u0431\u043A\u0438
      \u0438 \u043E\u0431\u044A\u044F\u0442\u0438\u044F \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u0439.\n\n\u0412\u0430\u0441
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438 \u043A\u0430\u043A \u0433\u0435\u0440\u043E\u0435\u0432,
      \u0441\u043F\u0430\u0441\u0451\u043D\u043D\u044B\u0445 \u0447\u0443\u0434\u043E\u043C.
      \u0412\u044B \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0437\u0430 \u0434\u043E\u043B\u0433\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u0438
      \u0441\u0435\u0431\u0435 \u0443\u043B\u044B\u0431\u043D\u0443\u0442\u044C\u0441\u044F.\n\n\u041D\u043E
      \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u0442\u044C\u0441\u044F
      \u043D\u0435\u043B\u044C\u0437\u044F \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439 \u0432\u044B \u041C\u0430\u0439\u043E\u0440 \u0420\u044F\u0431\u0447\u0438\u043A\u043E\u0432
      \u0432\u043E\u0437\u044C\u043C\u0435\u0442\u0435 \u0431\u0430\u0442\u0430\u043B\u044C\u043E\u043D
      \u043F\u043E\u0434 \u0441\u0432\u043E\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0432\u0430\u043D\u0438\u0435
      \u0438 \u043F\u043E\u0439\u0434\u0435\u0442\u0435 \u0432 \u0430\u0442\u0430\u043A\u0443.
      \u0412\u0430\u0448\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u0435\u0449\u0451
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479342211072
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u0434\u0432\u0438\u0433\u0430\u043B\u0441\u044F
      \u043A\u0430\u043A \u0435\u0434\u0438\u043D\u044B\u0439 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C,
      \u0448\u0430\u0433 \u0432 \u0448\u0430\u0433, \u0434\u044B\u0445\u0430\u043D\u0438\u0435
      \u0432 \u0434\u044B\u0445\u0430\u043D\u0438\u0435. \u041D\u0438 \u043E\u0434\u043D\u043E\u0439
      \u043E\u0448\u0438\u0431\u043A\u0438, \u043D\u0438 \u043E\u0434\u043D\u043E\u0439
      \u043F\u043E\u0442\u0435\u0440\u0438. \u0421\u043B\u043E\u0432\u043D\u043E
      \u0441\u0430\u043C \u0411\u043E\u0433 \u0432\u0435\u043B \u043D\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479405125632
    m_Localized: "\u041F\u043E\u043A\u0430 \u0441\u043F\u043E\u0440\u0438\u043B\u0438,
      \u0438\u0434\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u043B\u0435
      \u0438\u043B\u0438 \u0438\u0441\u043A\u0430\u0442\u044C \u043E\u0431\u0445\u043E\u0434,
      \u043E\u0434\u0438\u043D \u0438\u0437 \u0431\u043E\u0439\u0446\u043E\u0432
      \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043B \u0438 \u0448\u0430\u0433\u043D\u0443\u043B
      \u0432\u043F\u0435\u0440\u0435\u0434. \u0412\u0437\u0440\u044B\u0432\u2026
      \u041F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0437\u0430\u0445\u043E\u0442\u0435\u043B \u0441\u0442\u0443\u043F\u0430\u0442\u044C
      \u043D\u0430 \u043C\u0438\u043D\u043D\u043E\u0435 \u043F\u043E\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479405125633
    m_Localized: "\u041E\u0431\u0445\u043E\u0434 \u0437\u0430\u043D\u044F\u043B \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0438\u0437-\u0437\u0430 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0445
      \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u0432 \u043F\u043E\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479405125634
    m_Localized: "\u041E\u0431\u0445\u043E\u0434 \u0437\u0430\u043D\u044F\u043B \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0438\u0437-\u0437\u0430 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0445
      \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u0432 \u043F\u043E\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479405125635
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D
      \u0443\u0446\u0435\u043B\u0435\u043B\u0438 \u043F\u0440\u0438 \u0432\u0437\u0440\u044B\u0432\u0435
      \u0438 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438, \u043A\u043E\u0433\u0434\u0430
      \u043D\u0430 \u043D\u0438\u0445 \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479405125636
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D
      \u0443\u0446\u0435\u043B\u0435\u043B\u0438 \u043F\u0440\u0438 \u0432\u0437\u0440\u044B\u0432\u0435
      \u0438 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438, \u043A\u043E\u0433\u0434\u0430
      \u043D\u0430 \u043D\u0438\u0445 \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479405125637
    m_Localized: "\u0412\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0434\u0435\u0432\u043E\u0447\u043A\u0443
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0438 \u043F\u0443\u0442\u044C.
      \u0411\u043E\u0435\u0446 \u0431\u044B\u043B \u0441\u0438\u043B\u044C\u043D\u043E
      \u043E\u0433\u043E\u0440\u0447\u0435\u043D. \u0421\u043F\u0443\u0441\u0442\u044F
      \u0432\u0440\u0435\u043C\u044F \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430
      \u0434\u043E\u043D\u0435\u0441\u043B\u0438\u0441\u044C \u0435\u0435 \u043A\u0440\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479405125638
    m_Localized: "\u0412\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0434\u0435\u0432\u043E\u0447\u043A\u0443
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0438 \u043F\u0443\u0442\u044C.
      \u0411\u043E\u0435\u0446 \u0431\u044B\u043B \u0441\u0438\u043B\u044C\u043D\u043E
      \u043E\u0433\u043E\u0440\u0447\u0435\u043D. \u0421\u043F\u0443\u0441\u0442\u044F
      \u0432\u0440\u0435\u043C\u044F \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430
      \u0434\u043E\u043D\u0435\u0441\u043B\u0438\u0441\u044C \u0435\u0435 \u043A\u0440\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479405125639
    m_Localized: "\u041E\u0434\u0438\u043D \u0431\u043E\u0435\u0446 \u043F\u044B\u0442\u0430\u043B\u0441\u044F
      \u043E\u0442\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445,
      \u043D\u0430\u0437\u044B\u0432\u0430\u044F \u0438\u0445 \u0444\u0430\u0448\u0438\u0441\u0442\u0430\u043C\u0438.
      \u0412\u044B \u043E\u0433\u043B\u0443\u0448\u0438\u043B\u0438 \u0435\u0433\u043E,
      \u043F\u0440\u0438\u043A\u0430\u0437 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043B\u0438.
      \u041F\u043E\u0437\u0436\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u0436\u0438\u0442\u0435\u043B\u0438
      \u043D\u0430\u0448\u043B\u0438 \u0442\u0435\u043B\u043E \u0434\u0435\u0432\u043E\u0447\u043A\u0438.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043D\u0438 \u0436\u0430\u0436\u0434\u0443\u0442
      \u043C\u0435\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479405125640
    m_Localized: "\u041F\u0440\u0438\u043A\u0430\u0437 \u0432\u044B\u0437\u0432\u0430\u043B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442.
      \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u043B\u0434\u0430\u0442,
      \u0434\u0435\u0440\u0436\u0430 \u043E\u0442\u0440\u044F\u0434 \u043F\u043E\u0434
      \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u043C, \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0438,
      \u0447\u0442\u043E \u043D\u0435 \u0431\u0443\u0434\u0443\u0442 \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C
      \u0432 \u0434\u0435\u0442\u0435\u0439, \u0438 \u0443\u0448\u043B\u0438 \u0432
      \u043B\u0435\u0441 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479405125641
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0439\u0441\u044F
      \u0431\u043E\u0435\u0446 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
      \u0432\u0430\u043C: \u043D\u0435\u043C\u0446\u044B, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u044B\u0435
      \u0437\u0430 \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u0435 \u0434\u043E\u0447\u0435\u0440\u0438,
      \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0438 \u0435\u043C\u0443 \u043A\u043E\u0440\u0437\u0438\u043D\u0443
      \u0441 \u0435\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479405125642
    m_Localized: "\u0411\u043E\u0435\u0446 \u0443\u0448\u0435\u043B \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0442\u044C
      \u0434\u0435\u0432\u043E\u0447\u043A\u0443 \u0438 \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0432\u044B \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438
      \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0443. \u0411\u043E\u0439\u0446\u044B
      \u0441\u0447\u0438\u0442\u0430\u044E\u0442, \u0447\u0442\u043E \u0432\u044B
      \u0437\u0440\u044F \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B\u0438 \u0435\u0433\u043E.
      \u0426\u0435\u043D\u0430 \u0432\u0430\u0448\u0435\u0439 \u0441\u0435\u043D\u0442\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u2014 \u0436\u0438\u0437\u043D\u044C \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0438\u0437 \u043D\u0438\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 153648479409319936
    m_Localized: "\u0418\u0437\u2011\u0437\u0430 \u0441\u0438\u043B\u044C\u043D\u043E\u0433\u043E
      \u0442\u0435\u0447\u0435\u043D\u0438\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0431\u043E\u0439\u0446\u043E\u0432 \u0432\u044B\u043D\u0443\u0436\u0434\u0435\u043D\u044B
