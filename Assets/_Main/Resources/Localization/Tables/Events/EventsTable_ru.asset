  - m_Id: 1730899239146
    m_Localized: "\u0412\u044B \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u043B\u0438
      \u0442\u0443\u043C\u0430\u043D, \u043D\u043E \u043F\u043E\u0438\u0441\u043A\u043E\u0432\u0430\u044F
      \u0433\u0440\u0443\u043F\u043F\u0430 \u0432\u0440\u0430\u0433\u0430 \u0432\u0441\u0435
      \u0431\u043B\u0438\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239147
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0432\u0441\u0435 \u0441\u0432\u0435\u0440\u0445\u0443 \u0438 \u0443\u043A\u0430\u0437\u0430\u043B
      \u0432\u0430\u043C \u043D\u0430 \u0431\u043E\u043B\u0435\u0435 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239148
    m_Localized: "\u0421\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u0440\u0435\u0439\u0434
      \u043F\u0440\u0438\u043D\u0435\u0441 \u043C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432,
      \u043D\u043E \u044D\u0442\u043E \u0441\u0442\u043E\u0438\u043B\u043E \u043C\u043D\u043E\u0433\u0438\u0445
      \u0436\u0438\u0437\u043D\u0435\u0439, \u0438 \u0432\u044B \u0442\u0430\u043A\u0436\u0435
      \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u043B\u0438 \u043C\u043D\u043E\u0433\u043E
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239149
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u0438\u0437\u0431\u0435\u0436\u0430\u043B
      \u0440\u0438\u0441\u043A\u0430 \u0438 \u043F\u043E\u0442\u0435\u0440\u044C,
      \u043D\u043E \u0443\u043F\u0443\u0441\u0442\u0438\u043B \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u044B.
      \u0412\u0441\u043A\u043E\u0440\u0435 \u0432\u044B \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0445
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u043E\u0432. \u041F\u043E\u0445\u043E\u0436\u0435,
      \u0434\u0438\u0432\u0435\u0440\u0441\u0430\u043D\u0442\u043E\u0432 \u043F\u043E\u0441\u0442\u0438\u0433\u043B\u0430
      \u043D\u0435\u0443\u0434\u0430\u0447\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239150
    m_Localized: "\u041E\u0431\u043C\u0435\u043D \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0435\u0439
      \u043F\u043E\u043C\u043E\u0433 \u0441\u043D\u0438\u0437\u0438\u0442\u044C \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0435\u0433\u043E \u0440\u0438\u0441\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239151
    m_Localized: "\u0412\u044B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438
      \u043F\u0430\u0442\u0440\u0443\u043B\u0438 \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432
      \u0438 \u0432\u0430\u043C \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043F\u0440\u043E\u0436\u0434\u0430\u0442\u044C \u043F\u043E\u0447\u0442\u0438
      \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u0432\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u0432 \u0441\u0440\u0430\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239152
    m_Localized: "\u0413\u0440\u0443\u043F\u043F\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0430
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0438 \u043D\u0430\u0442\u043A\u043D\u0443\u043B\u0430\u0441\u044C
      \u043D\u0430 \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0438\u0439 \u043F\u0430\u0442\u0440\u0443\u043B\u044C,
      \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u0447\u0435\u0433\u043E
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0438\u0437 \u0432\u0430\u0448\u0438\u0445
      \u0431\u043E\u0439\u0446\u043E\u0432 \u043F\u043E\u0433\u0438\u0431\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239153
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A \u043D\u0430\u0442\u043A\u043D\u0443\u043B\u0441\u044F
      \u043D\u0430 \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0438\u0439 \u043F\u0430\u0442\u0440\u0443\u043B\u044C,
      \u0438 \u0432\u044B, \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0432\u0448\u0438\u0441\u044C
      \u0448\u0430\u043D\u0441\u043E\u043C, \u043F\u0440\u043E\u0441\u043A\u043E\u0447\u0438\u043B\u0438
      \u043D\u0435\u0437\u0430\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239154
    m_Localized: "\u0413\u0440\u0443\u043F\u043F\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u043B\u0430\u0441\u044C,
      \u0430 \u0441 \u043D\u0435\u0439 \u0438 \u0440\u0430\u0441\u0445\u043E\u0434
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432. \u041F\u0430\u0442\u0440\u0443\u043B\u044C,
      \u0438\u0441\u043A\u0430\u0432\u0448\u0438\u0439 \u044D\u0442\u0438\u0445 \u0434\u0432\u043E\u0438\u0445,
      \u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u0442\u043A\u043D\u0443\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0432\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239155
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u0441\u043E\u043B\u0434\u0430\u0442
      \u043F\u043E\u043A\u0438\u043D\u0443\u043B \u043E\u0442\u0440\u044F\u0434,
      \u0441\u043A\u0430\u0437\u0430\u0432, \u0447\u0442\u043E \u043E\u043D \u043F\u043E\u043C\u043E\u0436\u0435\u0442
      \u0438\u043C, \u0430 \u0435\u0441\u043B\u0438 \u0438\u0445 \u0434\u043E\u0433\u043E\u043D\u044F\u0442,
      \u0442\u043E \u043E\u043D \u0441\u0430\u043C \u0443\u0431\u044C\u0435\u0442
      \u0438\u0445 \u0438 \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0435\u0442\u0441\u044F
      \u0432\u044B\u0438\u0433\u0440\u0430\u0442\u044C \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239156
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C
      \u043C\u043D\u043E\u0433\u0438\u0445 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439
      \u043D\u0430 \u043F\u0443\u0442\u0438, \u043D\u043E \u0431\u043E\u0439\u0446\u044B
      \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B \u0432\u0430\u0448\u0438\u043C
      \u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239157
    m_Localized: "\u0412 \u043D\u0430\u0437\u0438\u0434\u0430\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
      \u0432\u044B \u043A\u0430\u0437\u043D\u0438\u043B\u0438 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0438\u0437 \u0431\u043E\u0439\u0446\u043E\u0432, \u043D\u0430\u043F\u043E\u043C\u043D\u0438\u0432
      \u0432\u0441\u0435\u043C, \u0447\u0442\u043E \u0432\u044B \u2014 \u0441\u043E\u043B\u0434\u0430\u0442\u044B
      \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439 \u0430\u0440\u043C\u0438\u0438,
      \u0433\u0434\u0435 \u043D\u0435\u0442 \u043C\u0435\u0441\u0442\u0430 \u0442\u0440\u0443\u0441\u0430\u043C
      \u0438 \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239158
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442 \u043F\u0440\u0438\u0437\u043D\u0430\u043B
      \u0441\u0432\u043E\u0438 \u043E\u0448\u0438\u0431\u043A\u0438, \u0440\u0430\u0441\u043A\u0430\u044F\u0432\u0448\u0438\u0441\u044C
      \u0432 \u0441\u0432\u043E\u0435\u0439 \u0442\u0440\u0443\u0441\u043E\u0441\u0442\u0438,
      \u0438 \u043F\u0440\u043E\u0441\u0438\u043B \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F,
      \u0434\u0443\u043C\u0430\u044F, \u0447\u0442\u043E \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443
      \u0443 \u043D\u0435\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u0448\u0430\u043D\u0441\u043E\u0432
      \u0432\u044B\u0436\u0438\u0442\u044C. \u041E\u0442\u0440\u044F\u0434 \u0431\u044B\u043B
      \u0443\u0434\u0438\u0432\u043B\u0435\u043D \u0432\u0430\u0448\u0438\u043C \u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0435\u0433\u043E \u0432
      \u0436\u0438\u0432\u044B\u0445 \u2014 \u0432\u0435\u0434\u044C \u043E\u0431\u044B\u0447\u043D\u043E
      \u0437\u0430 \u0442\u0430\u043A\u043E\u0435 \u0441\u0440\u0430\u0437\u0443
      \u0440\u0430\u0441\u0441\u0442\u0440\u0435\u043B\u0438\u0432\u0430\u044E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239159
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442, \u043F\u0440\u043E\u0441\u044F
      \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F, \u0432 \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u0438
      \u043A\u0440\u0438\u0447\u0430\u043B, \u0447\u0442\u043E \u0441\u0442\u0430\u043B
      \u0442\u0440\u0443\u0441\u043E\u043C, \u0447\u0442\u043E \u043F\u043B\u0435\u043D,
      \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435,
      \u0441\u043C\u0435\u0440\u0442\u044C \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u0439,
      \u0432\u0435\u0447\u043D\u0430\u044F \u0441\u043A\u0440\u044B\u0442\u043D\u043E\u0441\u0442\u044C
      \u2014 \u0432\u0441\u0435 \u044D\u0442\u043E \u0441\u0432\u043E\u0434\u0438\u0442
      \u0435\u0433\u043E \u0441 \u0443\u043C\u0430. \u041D\u043E \u0432\u044B, \u043A\u0430\u043A
      \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440, \u0442\u0432\u0435\u0440\u0434\u043E
      \u043D\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438 \u0435\u043C\u0443,
      \u043A\u0442\u043E \u043E\u043D \u2014 \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0439
      \u0441\u043E\u043B\u0434\u0430\u0442. \u0411\u043E\u0435\u0446 \u0441\u043E\u0431\u0440\u0430\u043B\u0441\u044F
      \u0441 \u0434\u0443\u0445\u043E\u043C \u0438 \u0432\u0437\u044F\u043B \u0441\u0435\u0431\u044F
      \u0432 \u0440\u0443\u043A\u0438\u2026 \u043D\u043E \u043D\u0430\u0434\u043E\u043B\u0433\u043E
      \u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239160
    m_Localized: "\u0411\u043E\u0439\u0446\u044B \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u043B\u0438
      \u0442\u0435\u043B\u0430 \u0432 \u043E\u0432\u0440\u0430\u0433, \u043F\u043E\u043D\u0438\u043C\u0430\u044F,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u043C\u044B \u043D\u0435 \u0445\u043E\u0440\u043E\u043D\u0438\u043C
      \u0438\u0445 \u043F\u043E \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438,
      \u0430 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u043C \u0432
      \u0431\u0440\u0430\u0442\u0441\u043A\u0443\u044E \u043C\u043E\u0433\u0438\u043B\u0443.
      \u0412\u0440\u0430\u0433 \u0443\u0436\u0435 \u0431\u043B\u0438\u0437\u043A\u043E,
      \u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0430 \u0446\u0435\u0440\u0435\u043C\u043E\u043D\u0438\u0438
      \u043D\u0435\u0442. \u041D\u043E \u0434\u0430\u0436\u0435 \u0442\u0430\u043A
      \u044D\u0442\u043E \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0442\u0435\u043B\u0430 \u0433\u043D\u0438\u0442\u044C \u043D\u0430 \u0437\u0435\u043C\u043B\u0435
      \u0438 \u0431\u044B\u0442\u044C \u043A\u043E\u0440\u043C\u043E\u043C \u0434\u043B\u044F
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239161
    m_Localized: "\u0412\u0430\u0448 \u043F\u0440\u0438\u043A\u0430\u0437 \u043D\u0435
      \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0441\u044F \u0432\u0430\u0448\u0438\u043C
      \u0431\u043E\u0439\u0446\u0430\u043C, \u0431\u043E\u0439\u0446\u044B \u043D\u0435\u043E\u0445\u043E\u0442\u043D\u043E
      \u043F\u043E\u043A\u0438\u043D\u0443\u043B\u0438 \u0441\u0432\u043E\u0438\u0445
      \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u0439. \u0411\u043E\u0435\u0432\u043E\u0439
      \u0434\u0443\u0445 \u0433\u0440\u0443\u043F\u043F\u044B \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239162
    m_Localized: "\u0411\u043E\u0439\u0446\u044B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438
      \u0447\u0442\u043E \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u043E\u043B\u0434\u0430\u0442
      \u043D\u0430 \u043F\u043E\u043B\u0435 \u0431\u044B\u043B \u0431\u0435\u0437
      \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u044F, \u0441\u0435\u0439\u0447\u0430\u0441
      \u0441 \u043D\u0438\u043C \u0432\u0441\u0435 \u0445\u043E\u0440\u043E\u0448\u043E.
      \u041D\u043E \u0432\u044B \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u043C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u0438 \u0432\u0440\u0430\u0433 \u0432\u0441\u0435 \u0431\u043B\u0438\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239163
    m_Localized: "\u0412\u044B \u043D\u0430\u0448\u043B\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u044B,
      \u043D\u043E \u0432\u0430\u0448 \u0441\u0438\u0433\u043D\u0430\u043B \u0431\u044B\u043B
      \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0447\u0435\u043D \u0432\u0440\u0430\u0433\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239164
    m_Localized: "\u0412\u044B \u043D\u0430\u0448\u043B\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0438 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u043B\u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u0440\u0430\u0434\u0438\u043E\u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0447\u0438\u043A.
      \u041D\u043E \u043E\u0442\u0440\u044F\u0434 \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u0435\u043D:
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0441 \u0435\u0433\u043E
      \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E
      \u0441\u0432\u044F\u0437\u0430\u0442\u044C\u0441\u044F \u0441 \u043D\u0430\u0448\u0438\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239165
    m_Localized: "\u0412\u044B \u0440\u0435\u0448\u0438\u043B\u0438 \u043D\u0435
      \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C \u0438 \u043F\u0440\u043E\u0448\u043B\u0438
      \u043C\u0438\u043C\u043E \u044D\u0442\u043E\u0433\u043E \u043C\u0435\u0441\u0442\u0430,
      \u0438\u0437\u0431\u0435\u0433\u0430\u044F \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439. \u041A\u0442\u043E
      \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E \u043C\u043E\u0433\u043B\u043E
      \u0442\u0430\u043C \u043F\u0440\u043E\u0438\u0437\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239166
    m_Localized: "\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438
      \u0432\u044B \u043D\u0430\u0448\u043B\u0438 \u0441\u043E\u043B\u0434\u0430\u0442\u0430,
      \u0432 \u0447\u044C\u0435\u043C \u043C\u0435\u0448\u043A\u0435 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u0431\u044B\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C
      \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E. \u041E\u043D \u043E\u0442\u043D\u0435\u043A\u0438\u0432\u0430\u043B\u0441\u044F,
      \u043F\u0440\u0438\u0434\u0443\u043C\u044B\u0432\u0430\u043B \u043E\u043F\u0440\u0430\u0432\u0434\u0430\u043D\u0438\u044F,
      \u043D\u0430\u0447\u0430\u043B \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0445. \u0412\u044B \u043D\u0435\u0434\u043E\u043B\u0433\u043E
      \u0434\u0443\u043C\u0430\u044F \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043B\u0438
      \xAB\u043F\u0440\u0430\u0432\u0435\u0434\u043D\u044B\u0439\xBB \u0432\u044B\u0441\u0442\u0440\u0435\u043B.
      \u0412\u043E\u0440\u043E\u0432\u0430\u0442\u044C \u0443 \u0441\u0432\u043E\u0438\u0445
      \u2014 \u0432\u044B\u0441\u0448\u0438\u0439 \u0433\u0440\u0435\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239167
    m_Localized: "\u041F\u043E\u0437\u0434\u043D\u0435\u0435, \u0432\u043E \u0432\u0440\u0435\u043C\u044F
      \u043F\u0440\u0438\u0432\u0430\u043B\u0430 \u043A\u0442\u043E-\u0442\u043E
      \u043F\u043E\u043B\u043E\u0436\u0438\u043B \u0440\u044F\u0434\u043E\u043C \u0441
      \u0432\u0430\u043C\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0435
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B. \u0412\u0438\u0434\u0438\u043C\u043E,
      \u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u0432\u044B\u0436\u0438\u0442\u044C
      \u043F\u0435\u0440\u0435\u0441\u0438\u043B\u0438\u043B\u043E \u0435\u0433\u043E
      \u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u0432
      \u0433\u0440\u0443\u043F\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239168
    m_Localized: "\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438
      \u0432\u044B \u043D\u0430\u0448\u043B\u0438 \u0441\u043E\u043B\u0434\u0430\u0442\u0430,
      \u0432 \u0447\u044C\u0435\u043C \u043C\u0435\u0448\u043A\u0435 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u0431\u044B\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C
      \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E. \u0412\u044B \u043F\u0440\u043E\u0433\u043D\u0430\u043B\u0438
      \u0441\u043E\u043B\u0434\u0430\u0442\u0430, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
      \u0435\u0433\u043E \u0431\u0435\u0437 \u043E\u0440\u0443\u0436\u0438\u044F
      \u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432. "
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239169
    m_Localized: "\u0412\u0430\u0448 \u0442\u043E\u0432\u0430\u0440\u0438\u0449,
      \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u044F \u043C\u0443\u0436\u0435\u0441\u0442\u0432\u043E,
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043D\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u0438.
      \u041E\u0442\u043E\u0439\u0434\u044F \u043D\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0435
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435, \u0432\u044B
      \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B
      \u0438 \u0432\u0437\u0440\u044B\u0432\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043D\u0435 \u0443\u0442\u0438\u0445\u0430\u043B\u0438. \u041A\u043E\u0433\u0434\u0430
      \u0432\u0441\u0435 \u0441\u0442\u0438\u0445\u043B\u043E, \u0432\u044B \u043C\u044B\u0441\u043B\u0435\u043D\u043D\u043E
      \u043F\u0440\u043E\u0441\u0442\u0438\u043B\u0438\u0441\u044C \u0441 \u0434\u0440\u0443\u0433\u043E\u043C,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0442\u0434\u0430\u043B \u0441\u0432\u043E\u044E
      \u0436\u0438\u0437\u043D\u044C, \u0441\u043F\u0430\u0441\u0430\u044F \u043E\u0442\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239170
    m_Localized: "\u0414\u0440\u0443\u0433 \u043F\u043E\u0434\u0447\u0438\u043D\u0438\u043B\u0441\u044F
      \u043F\u0440\u0438\u043A\u0430\u0437\u0443 \u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B
      \u0437\u0430 \u043E\u0442\u0440\u044F\u0434\u043E\u043C. \u041F\u043E\u0437\u0436\u0435,
      \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0441\u044C \u043D\u0430\u0435\u0434\u0438\u043D\u0435,
      \u043E\u043D \u043E\u0442\u0447\u0438\u0442\u0430\u043B \u0432\u0430\u0441
      \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u0432\u044B \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0434\u0440\u0443\u0436\u0431\u0443 \u0432\u044B\u0448\u0435 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
      \u0432\u0430\u0448\u0435\u0433\u043E \u043E\u0442\u0440\u044F\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239171
    m_Localized: "\u041E\u0442\u043E\u0439\u0434\u044F \u043D\u0430 \u043F\u0440\u0438\u043B\u0438\u0447\u043D\u043E\u0435
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435, \u0432\u044B
      \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438 20 \u043C\u0438\u043D\u0443\u0442
      \u043D\u0435\u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u044E\u0449\u0438\u0445\u0441\u044F
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432 \u0438 \u0432\u0437\u0440\u044B\u0432\u043E\u0432.
      \u041D\u0430\u043A\u043E\u043D\u0435\u0446 \u0432\u0441\u0435 \u0441\u0442\u0438\u0445\u043B\u043E.
      \u0421\u043F\u0443\u0441\u0442\u044F \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A \u0438 \u0441\u043E\u043E\u0431\u0449\u0438\u043B,
      \u0447\u0442\u043E \u0432\u0438\u0434\u0435\u043B, \u043A\u0430\u043A \u0432\u0430\u0448
      \u0434\u0440\u0443\u0433 \u0441\u0443\u043C\u0435\u043B \u0443\u0432\u0435\u0441\u0442\u0438
      \u0437\u0430 \u0441\u043E\u0431\u043E\u0439 \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239172
    m_Localized: "\u0411\u043E\u0435\u0446 \u0431\u044B\u043B \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D,
      \u043D\u043E \u043F\u043E\u0434\u0447\u0438\u043D\u0438\u043B\u0441\u044F \u043F\u0440\u0438\u043A\u0430\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239173
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B\u0438
      \u043F\u043E\u0438\u0441\u043A\u0438 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u0447\u0430\u0441\u043E\u0432,
      \u043D\u043E, \u043A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
      \u0435\u0433\u043E \u043D\u0435 \u043D\u0430\u0448\u043B\u0438. \u0421\u043E\u043B\u0434\u0430\u0442
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442 \u0432\u0430\u0441
      \u0437\u0430 \u043F\u043E\u043F\u044B\u0442\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239174
    m_Localized: "\u041D\u0435\u043B\u044C\u0437\u044F \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C
      \u043E\u0442\u0440\u044F\u0434\u043E\u043C \u0440\u0430\u0434\u0438 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0431\u043E\u0439\u0446\u0430. \u0412 \u0434\u0443\u0448\u0435 \u0432\u044B
      \u0445\u043E\u0442\u0435\u043B\u0438, \u0447\u0442\u043E\u0431\u044B \u043E\u043D
      \u043D\u0430\u0448\u0435\u043B \u0442\u0443 \u0432\u0435\u0449\u044C \u0438
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F, \u043D\u043E \u044D\u0442\u043E\u0433\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239175
    m_Localized: "\u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434 \u043F\u043E\u0447\u0438\u043D\u0438\u043B
      \u0442\u0430\u043D\u043A, \u043D\u0430 \u044D\u0442\u043E \u0443\u0448\u043B\u043E
      \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u0440\u0435\u043C\u044F,
      \u0438 \u0432\u0441\u043A\u043E\u0440\u0435 \u0432\u044B \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C
      \u043D\u0430 \u043D\u0435\u043C \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E
      \u043A \u0444\u0440\u043E\u043D\u0442\u0443, \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u044F\u0441\u044C
      \u0441\u043A\u0432\u043E\u0437\u044C \u043B\u0435\u0441 \u0438 \u043F\u043E\u0437\u0438\u0446\u0438\u0438
      \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432. \u0412\u0430\u0441 \u043D\u0438\u0447\u0442\u043E
      \u043D\u0435 \u043C\u043E\u0433\u043B\u043E \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u2026
      \u043A\u0440\u043E\u043C\u0435 \u0442\u043E\u043F\u043B\u0438\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239176
    m_Localized: "\u0412\u044B \u0440\u0435\u0448\u0438\u043B\u0438 \u043D\u0435
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0434\u0430\u043D\u043D\u0443\u044E
      \u0430\u0432\u0430\u043D\u0442\u044E\u0440\u0443: \u0442\u0430\u043D\u043A
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0437\u0430\u043C\u0435\u0442\u043D\u044B\u0439,
      \u0434\u0430 \u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
      \u0435\u0433\u043E \u0432 \u0442\u0430\u043A\u043E\u043C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438
      \u0438 \u0431\u0435\u0437 \u043B\u043E\u0432\u0443\u0448\u043A\u0438 \u043D\u0438\u043A\u0442\u043E
      \u0431\u044B \u043D\u0435 \u0441\u0442\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239177
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442\u044B \u043D\u0430\u0448\u043B\u0438
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u0438 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F, \u0432\u044B
      \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u043B\u0438 \u0441\u0432\u043E\u0438
      \u0437\u0430\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239178
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u0438\u0437\u0431\u0435\u0436\u0430\u043B
      \u043F\u043E\u0442\u0435\u0440\u044C. \u041A\u0430\u043A\u043E\u0435\u2011\u0442\u043E
      \u0432\u0440\u0435\u043C\u044F \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0430
      \u0435\u0449\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B\u0430\u0441\u044C,
      \u043D\u043E \u043F\u043E\u0442\u043E\u043C \u0432\u0441\u0435 \u0437\u0430\u0442\u0438\u0445\u043B\u043E.
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u044D\u0442\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B
      \u0431\u044B\u043B\u0438 \u043D\u0435 \u0434\u043B\u044F \u0432\u0430\u0441,
      \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0443\u0437\u043D\u0430\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239179
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0430\u0448\u0438\u0445
      \u0431\u043E\u0439\u0446\u043E\u0432 \u043F\u043E\u0433\u0438\u0431\u043B\u0438
      \u043F\u043E\u0434 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438,
      \u043D\u043E \u0432\u044B \u0441\u043C\u043E\u0433\u043B\u0438 \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u0438
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u0435\u0433\u043E.
      \u042D\u0442\u043E \u0431\u044B\u043B\u0438 \u0442\u0440\u043E\u0435 \u043C\u043E\u043B\u043E\u0434\u044B\u0445
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445 \u0441\u043E\u043B\u0434\u0430\u0442
      \u2014 \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E,
      \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u044B. \u0423\u0432\u0438\u0434\u0435\u0432
      \u0432\u0430\u0441, \u043E\u043D\u0438 \u0438\u0441\u043F\u0443\u0433\u0430\u043B\u0438\u0441\u044C
      \u0438 \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u043E\u0433\u043E\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239180
    m_Localized: "\u0412\u044B \u0440\u0435\u0448\u0438\u043B\u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C,
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0447\u0435\u043C\u0443
      \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C
      \u043F\u043E\u0442\u0435\u0440\u044C. \u041D\u043E \u043F\u0430\u0442\u0440\u0443\u043B\u044C
      \u043D\u0435\u0443\u043C\u043E\u043B\u0438\u043C\u043E \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u043B\u0441\u044F
      \u2014 \u0441\u043A\u043E\u0440\u043E \u0432\u044B \u0440\u0438\u0441\u043A\u0443\u0435\u0442\u0435
      \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u0437\u0430\u0436\u0430\u0442\u044B\u043C\u0438
      \u0441 \u0434\u0432\u0443\u0445 \u0441\u0442\u043E\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239181
    m_Localized: "\u0424\u043E\u0440\u043C\u0430 \u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0435, \u043D\u043E \u0432\u0430\u0448\u0438\u043C
      \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0430\u043C \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
      \u043D\u0435\u0441\u043B\u0430\u0434\u043A\u043E. \u0423\u0432\u044B, \u0443
      \u0432\u0430\u0441 \u043D\u0435\u0442 \u0432\u044B\u0431\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239182
    m_Localized: "\u0412\u044B \u0440\u0435\u0448\u0438\u043B\u0438 \u043D\u0435
      \u043C\u0435\u0448\u0430\u0442\u044C \u0441\u0432\u043E\u0435\u0439 \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0435.
      \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0439 \u0441\u043E\u043B\u0434\u0430\u0442
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E
      \u0437\u0430\u0434\u0430\u0447\u0430 \u0432\u0430\u0436\u043D\u0435\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0439
      \u0436\u0438\u0437\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239183
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0436\u0434\u0430\u043B\u0438 \u043F\u043E\u0447\u0442\u0438
      \u0434\u0435\u043D\u044C, \u0430 \u0438\u0445 \u0432\u0441\u0435 \u043D\u0435
      \u0431\u044B\u043B\u043E. \u0412\u0434\u0440\u0443\u0433 \u0432\u044B \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438
      \u0433\u043E\u043B\u043E\u0441\u0430 \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432
      \u2014 \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E,
      \u044D\u0442\u043E \u043F\u0430\u0442\u0440\u0443\u043B\u044C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0438\u0449\u0435\u0442 \u0434\u0430\u043D\u043D\u0443\u044E \u043F\u043E\u0441\u044B\u043B\u043A\u0443.
      \u041F\u043E\u044D\u0442\u043E\u043C\u0443, \u043F\u043E\u043A\u0430 \u0435\u0449\u0435
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0432\u044B \u0440\u0435\u0448\u0438\u043B\u0438
      \u0431\u0435\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239184
    m_Localized: "\u041F\u043B\u0435\u043D\u043D\u044B\u0435 \u0441\u043E\u0437\u0434\u0430\u043B\u0438
      \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438, \u043D\u043E \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
      \u0438\u043C \u0432\u0430\u043C \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u0431\u043B\u043E\u043A\u043F\u043E\u0441\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239185
    m_Localized: "\u0411\u043E\u0439\u0446\u044B, \u0434\u043E\u043B\u0433\u043E
      \u043D\u0435 \u0434\u0443\u043C\u0430\u044F, \u0441\u0440\u0430\u0437\u0443
      \u0440\u0430\u0441\u0441\u0442\u0440\u0435\u043B\u044F\u043B\u0438 \u043F\u043B\u0435\u043D\u043D\u044B\u0445.
      \u041F\u043B\u0435\u043D \u0441\u0434\u0435\u043B\u0430\u043B \u0432\u0441\u0435\u0445
      \u0432\u0430\u0441 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u044F\u0440\u043E\u0441\u0442\u043D\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239186
    m_Localized: "\u0411\u043E\u0439\u0446\u044B \u043F\u0440\u0438\u043D\u044F\u043B\u0438
      \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
      \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u0441
      \u0444\u0430\u0448\u0438\u0441\u0442\u0430\u043C\u0438, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F
      \u0432\u0441\u0435, \u0447\u0442\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u0434
      \u0440\u0443\u043A\u043E\u0439, \u043D\u043E \u043E\u043D\u0438 \u043D\u0435
      \u0434\u0435\u043B\u0430\u043B\u0438 \u044D\u0442\u043E\u0433\u043E \u0431\u044B\u0441\u0442\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239187
    m_Localized: "\u0421\u043F\u043E\u043D\u0442\u0430\u043D\u043D\u0430\u044F \u0430\u0442\u0430\u043A\u0430
      \u0441\u043F\u0430\u0441\u043B\u0430 \u043F\u043B\u0435\u043D\u043D\u0438\u043A\u043E\u0432.
      \u0424\u0430\u0448\u0438\u0441\u0442\u043E\u0432 \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E, \u043E\u0434\u043D\u0430 \u043C\u0430\u0448\u0438\u043D\u0430
      \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u0441\u043A\u0440\u044B\u0442\u044C\u0441\u044F,
      \u043D\u043E \u043F\u0440\u043E\u0431\u0438\u0442\u044B\u0435 \u0448\u0438\u043D\u044B
      \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A
      \u0441 \u043D\u0435\u043C\u0446\u0430\u043C\u0438 \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F.
      \u041F\u043B\u0435\u043D\u043D\u044B\u0435 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0438\u0441\u044C
      \u043A \u0432\u0430\u0448\u0435\u043C\u0443 \u043E\u0442\u0440\u044F\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239188
    m_Localized: "\u0412\u0430\u0448\u0438 \u0431\u043E\u0439\u0446\u044B \u0437\u0430\u043D\u044F\u043B\u0438
      \u043F\u043E\u0437\u0438\u0446\u0438\u0438, \u043D\u043E \u0431\u044B\u043B\u043E
      \u0443\u0436\u0435 \u043F\u043E\u0437\u0434\u043D\u043E: \u0432\u0441\u0435\u0445
      \u043F\u043B\u0435\u043D\u043D\u044B\u0445 \u0440\u0430\u0441\u0441\u0442\u0440\u0435\u043B\u044F\u043B\u0438,
      \u0430 \u0444\u0430\u0448\u0438\u0441\u0442\u044B \u0441\u0435\u043B\u0438
      \u0432 \u043C\u0430\u0448\u0438\u043D\u044B \u0438 \u0443\u0435\u0445\u0430\u043B\u0438.
      \u0412\u044B \u0440\u0435\u0448\u0438\u043B\u0438 \u043D\u0435 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C
      \u0431\u043E\u0439\u043D\u044E. \u041F\u043E\u0434\u043E\u0439\u0434\u044F
      \u043A \u0442\u0435\u043B\u0430\u043C, \u0432\u044B \u043C\u044B\u0441\u043B\u0435\u043D\u043D\u043E
      \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0438 \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F
      \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0438
      \u0441\u043F\u0430\u0441\u0442\u0438 \u0438\u0445, \u043D\u043E \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438
      \u043E\u0434\u043D\u043E\u0433\u043E \u0440\u0430\u043D\u0435\u043D\u043E\u0433\u043E,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0435\u0449\u0435 \u0431\u044B\u043B
      \u0436\u0438\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239189
    m_Localized: "\u0424\u0430\u0448\u0438\u0441\u0442\u044B \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u043F\u043B\u0435\u043D\u043D\u044B\u0445 \u0431\u0435\u0436\u0430\u0442\u044C
      \u0432 \u043B\u0435\u0441, \u0438 \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u0435 \u0434\u043E\u0441\u0442\u0438\u0433\u043B\u0438 \u043E\u043F\u0443\u0448\u043A\u0438,
      \u0440\u0430\u0437\u0434\u0430\u043B\u0438\u0441\u044C \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u043D\u044B\u0435
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B. \u0412\u0441\u043A\u043E\u0440\u0435
      \u043E\u043D\u0438 \u0441\u0435\u043B\u0438 \u043F\u043E \u043C\u0430\u0448\u0438\u043D\u0430\u043C
      \u0438 \u0443\u0435\u0445\u0430\u043B\u0438. \u0412\u0430\u0448 \u043E\u0442\u0440\u044F\u0434
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B \u043F\u0443\u0442\u044C,
      \u0441\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F \u0437\u043B\u043E\u0431\u0443
      \u043A \u0432\u0440\u0430\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239190
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u0441\u043E\u043B\u0434\u0430\u0442
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043B\u043E\u0436\u043D\u044B\u0439 \u0441\u043B\u0435\u0434, \u0447\u0442\u043E\u0431\u044B
      \u0437\u0430\u043F\u0443\u0442\u0430\u0442\u044C \u0432\u0440\u0430\u0433\u0430
      \u0438 \u0432\u044B\u0438\u0433\u0440\u0430\u0442\u044C \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239191
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u0431\u043E\u0439\u0446\u043E\u0432
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u044E\u0449\u0438\u0439 \u043C\u0430\u043D\u0435\u0432\u0440
      \u2014 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0433\u0440\u0430\u043D\u0430\u0442\u0443-\u043B\u043E\u0432\u0443\u0448\u043A\u0443
      \u0438\u043B\u0438 \u043F\u043E\u0434\u0436\u0435\u0447\u044C \u043B\u0435\u0441,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0432\u043B\u0435\u0447\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043F\u0430\u0442\u0440\u0443\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1730899239192
    m_Localized: "\u0411\u043E\u0439\u0446\u044B \u0441\u0442\u0440\u0430\u0434\u0430\u044E\u0442
      \u043E\u0442 \u0436\u0430\u0436\u0434\u044B, \u0438 \u043E\u0434\u0438\u043D
      \u0438\u0437 \u0441\u043E\u043B\u0434\u0430\u0442 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u0438\u0441\u043A\u0430\u0442\u044C \u0440\u043E\u0434\u043D\u0438\u043A \u0438\u043B\u0438
      \u0440\u0435\u043A\u0443. \u041D\u043E, \u043A\u0430\u043A \u0432\u044B \u0437\u043D\u0430\u0435\u0442\u0435,
      \u044D\u0442\u043E \u0432 \u0434\u0440\u0443\u0433\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438"
